<node id="Water Washing Approach">
  <data key="d0">Water Washing Approach</data>
  <data key="d1">method</data>
  <data key="d2">A purification technique that uses water to remove soluble contaminants from phosphogypsum, though it consumes significant water.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791772487</data>
  <data key="d6"></data>
</node>
<node id="Ball-Milling Method">
  <data key="d0">Ball-Milling Method</data>
  <data key="d1">method</data>
  <data key="d2">A mechanical processing technique that alters particle size and morphology to improve fluidity and reduce impurities.&lt;SEP&gt;A pretreatment process that uses mechanical grinding to alter the particle shape and gradation of phosphogypsum.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-006&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791772487</data>
  <data key="d6"></data>
</node>
<node id="Fluorine Impurities">
  <data key="d0">Fluorine Impurities</data>
  <data key="d1">concept</data>
  <data key="d2">Contaminants in phosphogypsum that can cause crystal coarsening and reduce building strength when present above 0.3%.&lt;SEP&gt;Fluorine impurities are harmful contaminants in phosphogypsum that can be reduced through calcination.&lt;SEP&gt;Contaminant in phosphogypsum targeted for removal during purification and pretreatment.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-006&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-018&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791772605</data>
  <data key="d6"></data>
</node>
<node id="Vacuum Pumps">
  <data key="d0">Vacuum Pumps</data>
  <data key="d1">artifact</data>
  <data key="d2">Equipment integrated into Fang's water-washing process to reduce water consumption and improve purification efficiency.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791772605</data>
  <data key="d6"></data>
</node>
