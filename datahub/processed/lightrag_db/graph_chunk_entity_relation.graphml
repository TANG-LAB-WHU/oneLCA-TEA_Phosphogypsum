</node>
<node id="Comparative Analysis">
  <data key="d0">Comparative Analysis</data>
  <data key="d1">concept</data>
  <data key="d2">Comparative analysis is the methodological framework using price indices and emergy evaluation.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
