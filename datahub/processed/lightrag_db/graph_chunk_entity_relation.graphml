  <data key="d5">1791061208</data>
  <data key="d6"></data>
</node>
<node id="Orthopedic Procedures">
  <data key="d0">Orthopedic Procedures</data>
  <data key="d1">concept</data>
  <data key="d2">Medical procedures where an initial setting time of 8 minutes is desired.&lt;SEP&gt;Medical procedures utilizing the cement, where a longer initial setting time of approximately 8 minutes is desired.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007</data>
