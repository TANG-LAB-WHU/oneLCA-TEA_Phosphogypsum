<node id="Biological Production">
  <data key="d0">Biological Production</data>
  <data key="d1">concept</data>
  <data key="d2">Biological production refers to crops grown in soil treated with phosphogypsum, demonstrating high environmental quality.</data>
  <data key="d3">doc-25198f8665e133385fd54e5a03e28a44-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792345098</data>
