<node id="Basic Nature">
  <data key="d0">Basic Nature</data>
  <data key="d1">concept</data>
  <data key="d2">Basic Nature refers to the alkaline property of phosphogypsum slurries generated by the release of hydroxide ions.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-028</data>
