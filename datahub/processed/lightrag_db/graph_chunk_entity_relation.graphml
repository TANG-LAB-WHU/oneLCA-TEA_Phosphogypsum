  <data key="d1">person</data>
  <data key="d2">Jemal collaborated with Tounsi on studies regarding the catalytic reduction of nitrogen oxides using hydroxyapatite supports.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-021</data>
  <data key="d4">unknown_source</data>
