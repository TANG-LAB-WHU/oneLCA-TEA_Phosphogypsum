  <data key="d5">1792484452</data>
  <data key="d6"></data>
</node>
<node id="Plasterboards">
  <data key="d0">Plasterboards</data>
  <data key="d1">artifact</data>
  <data key="d2">Plasterboards are construction materials produced using acceptable phosphogypsum crystal sizes from specific morphological groups.&lt;SEP&gt;Plasterboards are industrial products that can be manufactured directly using the pure hemihydrate produced by the dihemihydrate process.</data>
  <data key="d3">doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-004&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-005</data>
