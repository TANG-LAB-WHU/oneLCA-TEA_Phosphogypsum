<node id="Superoxide Radicals">
  <data key="d0">Superoxide Radicals</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Superoxide radicals are reactive oxygen species formed when electrons transfer from hydroxyapatite vacancies to atmospheric oxygen, oxidizing organic compounds.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="Thermal Excitation">
  <data key="d0">Thermal Excitation</data>
  <data key="d1">concept</data>
  <data key="d2">Thermal Excitation is a process that generates electrons trapped on vacancies in hydroxyapatite, instigating the oxidation of organic compounds.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="A-axis">
  <data key="d0">A-axis</data>
  <data key="d1">concept</data>
  <data key="d2">The a-axis is a crystallographic direction in hydroxyapatite; higher crystallinity toward this axis correlates with increased photocatalytic activity.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="C-axis">
  <data key="d0">C-axis</data>
  <data key="d1">concept</data>
  <data key="d2">The c-axis is a crystallographic direction in hydroxyapatite; its crystallinity remains similar across samples but does not drive the observed activity differences.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
