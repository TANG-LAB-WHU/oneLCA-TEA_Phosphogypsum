  <data key="d0">Sodium Trimetaphosphate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A phosphorylating agent used as the phosphorus source in the synthesis of hydroxyapatite microspheres.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-001&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-000</data>
