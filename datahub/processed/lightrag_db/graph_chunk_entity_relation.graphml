<node id="Marine Pollution Bulletin">
  <data key="d0">Marine Pollution Bulletin</data>
  <data key="d1">organization</data>
  <data key="d2">Marine Pollution Bulletin is a scientific journal that published research on the environmental impact of coastal phosphate treatment plants.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-026</data>
