<node id="Hemihydrate Processes">
  <data key="d0">Hemihydrate Processes</data>
  <data key="d1">method</data>
  <data key="d2">Hemihydrate Processes are a production route that operates with 3–5% lower solids content compared to dihydrate processes.</data>
  <data key="d3">doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-004</data>
