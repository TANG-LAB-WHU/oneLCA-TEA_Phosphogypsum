<node id="NaCl Additive">
  <data key="d0">NaCl Additive</data>
  <data key="d1">naturalobject</data>
  <data key="d2">NaCl additive is a chemical compound whose increasing concentration correlates with reduced mechanical performance and density.&lt;SEP&gt;A chemical additive whose concentration influences the structural and biological properties of the material.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-015&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-012</data>
