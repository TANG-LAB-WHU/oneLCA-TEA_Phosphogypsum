  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Dry Foodstuff">
  <data key="d0">Dry Foodstuff</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Dry foodstuff represents agricultural produce used to calculate the concentration ratio of radium relative to soil.</data>
