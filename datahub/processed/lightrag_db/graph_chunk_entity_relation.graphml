</node>
<node id="Reactive Yellow 4">
  <data key="d0">Reactive Yellow 4</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Reactive Yellow 4 is a toxic organic dye discharged by textile industries that hydroxyapatite derived from poultry eggshells can effectively adsorb.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-013</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247568</data>
  <data key="d6"></data>
</node>
<node id="Reactive Yellow 84">
  <data key="d0">Reactive Yellow 84</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Reactive Yellow 84 is another reactive textile dye that hydroxyapatite demonstrates potential in physisorbing from media.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-013</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
