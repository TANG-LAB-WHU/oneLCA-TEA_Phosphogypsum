</node>
<node id="Larnite">
  <data key="d0">Larnite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Larnite is a mineral phase that carbonate clays have the potential to generate during the brick baking process.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-015</data>
