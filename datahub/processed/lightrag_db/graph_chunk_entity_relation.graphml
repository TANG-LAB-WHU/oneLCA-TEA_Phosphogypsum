  <data key="d4">unknown_source</data>
  <data key="d5">1791061208</data>
  <data key="d6"></data>
</node>
<node id="Final Setting Time">
  <data key="d0">Final Setting Time</data>
  <data key="d1">concept</data>
  <data key="d2">The duration required for the cement to fully harden, measured in minutes.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006</data>
