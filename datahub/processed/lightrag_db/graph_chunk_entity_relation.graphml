<node id="Calcium fluoride">
  <data key="d0">Calcium fluoride</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium fluoride is a compound formed as a protective coating on cement grains due to phosphogypsum impurities.&lt;SEP&gt;Calcium fluoride takes the role of fluoride capture at neutral and alkaline conditions.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-005&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-009</data>
