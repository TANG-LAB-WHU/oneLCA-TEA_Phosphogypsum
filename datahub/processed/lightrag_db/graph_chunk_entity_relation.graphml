  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
  <data key="d6"></data>
</node>
<node id="Composite Scaffolds">
  <data key="d0">Composite Scaffolds</data>
  <data key="d1">artifact</data>
  <data key="d2">Composite Scaffolds are engineered biomaterial structures designed for bone tissue engineering and defect repair.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
  <data key="d6"></data>
</node>
<node id="Biomineralisation">
  <data key="d0">Biomineralisation</data>
  <data key="d1">concept</data>
  <data key="d2">Biomineralisation is a natural process driving the morphological evolution of hydroxyapatite in biological systems.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
