  <data key="d0">N1s</data>
  <data key="d1">data</data>
  <data key="d2">N1s is an XPS peak representing the nitrogen 1s electron state, measured at specific binding energies.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791469856</data>
