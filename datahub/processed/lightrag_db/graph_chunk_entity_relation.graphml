<node id="Mold">
  <data key="d0">Mold</data>
  <data key="d1">artifact</data>
  <data key="d2">The Mold is a 40x40x160 mm container used to shape the gypsum rheological body during sample preparation.&lt;SEP&gt;The mold is used to shape and compact the soil and stabilizer mixture into specimens.</data>
  <data key="d3">doc-7797768798fcd1152bdc10ff73139e35-chunk-003&lt;SEP&gt;doc-e4a551024f80f822f3f35e38ec278151-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791735089</data>
