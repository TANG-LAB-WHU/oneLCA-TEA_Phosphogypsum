  <data key="d0">MW11-36min</data>
  <data key="d1">content</data>
  <data key="d2">MW11-36min is the sample label indicating microwave treatment, sample ID, and duration.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
