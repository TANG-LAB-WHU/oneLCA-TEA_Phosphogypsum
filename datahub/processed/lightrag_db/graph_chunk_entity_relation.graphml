  <data key="d5">1791811483</data>
  <data key="d6"></data>
</node>
<node id="Stripping">
  <data key="d0">Stripping</data>
  <data key="d1">method</data>
  <data key="d2">Stripping is a subsequent process step where loaded ionic liquid is contacted with a stripping fluid to recover rare earth elements.</data>
  <data key="d3">doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791811818</data>
  <data key="d6"></data>
</node>
<node id="Synthetic Solution">
  <data key="d0">Synthetic Solution</data>
  <data key="d1">concept</data>
  <data key="d2">A synthetic solution containing varied amounts of rare earth elements is used to evaluate extraction efficiencies.&lt;SEP&gt;A prepared mixture containing rare earth elements used as the aqueous phase in the extraction tests.&lt;SEP&gt;A synthetic solution containing rare earth elements is used to test the extraction trials.</data>
  <data key="d3">doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-003&lt;SEP&gt;doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-012&lt;SEP&gt;doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791811818</data>
  <data key="d6"></data>
</node>
<node id="RE Oxalate">
  <data key="d0">RE Oxalate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">RE Oxalate is the solid precipitate formed when oxalic acid reacts with rare earth ions in the stripping solution.&lt;SEP&gt;RE oxalate is the precipitate formed when oxalic acid reacts with rare earth ions in the stripping solution.</data>
  <data key="d3">doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-012&lt;SEP&gt;doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-011</data>
