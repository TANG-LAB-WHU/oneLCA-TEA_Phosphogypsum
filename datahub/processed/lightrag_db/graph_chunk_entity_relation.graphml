</node>
<node id="Polydopamine">
  <data key="d0">Polydopamine</data>
  <data key="d1">artifact</data>
  <data key="d2">Polydopamine is a coating material inspired by mussel adhesion, used as a universal route to induce hydroxyapatite crystallization.</data>
