</node>
<node id="XRD Spectrum">
  <data key="d0">XRD Spectrum</data>
  <data key="d1">data</data>
  <data key="d2">XRD spectrum is an analytical data representation used to verify the consistency of chemical composition across different matrix samples.</data>
