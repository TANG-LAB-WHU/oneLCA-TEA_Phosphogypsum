<node id="R.P. Costa">
  <data key="d0">R.P. Costa</data>
  <data key="d1">person</data>
  <data key="d2">R.P. Costa is a researcher who analyzed the effects of soluble phosphate, fluoride, and pH on cement hydration using Brazilian phosphogypsum.</data>
