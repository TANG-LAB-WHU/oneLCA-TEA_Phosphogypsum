  <data key="d5">1791022627</data>
  <data key="d6"></data>
</node>
<node id="Soil Degradation">
  <data key="d0">Soil Degradation</data>
  <data key="d1">concept</data>
  <data key="d2">Soil degradation is an environmental consequence of phosphogypsum storage that extends beyond local areas.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791022627</data>
