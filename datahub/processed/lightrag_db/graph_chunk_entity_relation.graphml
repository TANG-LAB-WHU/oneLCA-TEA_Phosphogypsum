<node id="BGT*-Based Chemical Soil Engineering Technology">
  <data key="d0">BGT*-Based Chemical Soil Engineering Technology</data>
  <data key="d1">method</data>
  <data key="d2">A technology capable of increasing soil internal surface area, improving aggregate systems, and ensuring heavy metal passivation for environmentally safe waste recycling.&lt;SEP&gt;A technology capable of increasing soil internal surface area, improving aggregate systems, and ensuring heavy metal passivation for environmentally safe waste recycling.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790951395</data>
  <data key="d6"></data>
</node>
<node id="Intra-Soil Milling">
  <data key="d0">Intra-Soil Milling</data>
  <data key="d1">method</data>
  <data key="d2">A processing technique that provides fine soil structure, multilevel architecture, and reliable contact between amendments and soil aggregates.&lt;SEP&gt;A processing technique that provides fine soil structure, multilevel architecture, and reliable contact between amendments and soil aggregates.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790951395</data>
  <data key="d6"></data>
</node>
<node id="Vertical Rotational Chisel Gear">
  <data key="d0">Vertical Rotational Chisel Gear</data>
  <data key="d1">artifact</data>
  <data key="d2">A device component that cuts slots in the soil to reduce passive traction resistance during translational movement.&lt;SEP&gt;A device component that cuts slots in the soil to reduce passive traction resistance during translational movement.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790951395</data>
  <data key="d6"></data>
</node>
<node id="Intra-Soil Milling System">
  <data key="d0">Intra-Soil Milling System</data>
  <data key="d1">artifact</data>
  <data key="d2">A mounted system comprising milling cutters and a drive shaft that processes the target soil layer.&lt;SEP&gt;A mounted system comprising milling cutters and a drive shaft that processes the target soil layer.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014</data>
