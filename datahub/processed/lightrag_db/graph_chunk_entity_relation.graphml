<node id="Beneficiation Approach">
  <data key="d0">Beneficiation Approach</data>
  <data key="d1">method</data>
  <data key="d2">Beneficiation Approach is a processing strategy focused on removing major components of Phosphogypsum to concentrate Rare Earth Elements.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984329</data>
  <data key="d6"></data>
</node>
<node id="Alkaline Treatment">
  <data key="d0">Alkaline Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Alkaline Treatment is a process using mineral bases that favors the beneficiation of rare earth elements in solid phases.&lt;SEP&gt;Alkaline Treatment is a chemical process using Na EDTA to solubilize predominant compounds in Phosphogypsum.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-006&lt;SEP&gt;doc-26bca3d4f742299ce2dbcd6381558f89-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984329</data>
  <data key="d6"></data>
</node>
<node id="Beneficiated Solid">
  <data key="d0">Beneficiated Solid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Beneficiated Solid is the residual material remaining after the alkaline treatment and washing of Phosphogypsum.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984329</data>
  <data key="d6"></data>
</node>
<node id="Sodium Sulfates">
  <data key="d0">Sodium Sulfates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sodium Sulfates are major components of the Beneficiated Solid that can be eliminated through washing techniques.&lt;SEP&gt;Sodium sulfates are co-generated compounds targeted for recovery and recycling in the integrated processing strategy.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-006&lt;SEP&gt;doc-26bca3d4f742299ce2dbcd6381558f89-chunk-014</data>
