  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Acidic process water">
  <data key="d0">Acidic process water</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Acidic process water is a potential source of environmental contamination associated with phosphogypsum production and storage.</data>
