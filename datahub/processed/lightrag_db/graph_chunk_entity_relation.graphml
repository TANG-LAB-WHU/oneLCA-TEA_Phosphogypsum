  <data key="d1">data</data>
  <data key="d2">A dimensional property of the composite bone cement that reduces as sodium chloride additive increases.&lt;SEP&gt;Linear shrinkage is a material property that decreases with higher NaCl additive concentration.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-009&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-012</data>
  <data key="d4">unknown_source</data>
