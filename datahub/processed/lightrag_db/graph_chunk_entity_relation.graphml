  <data key="d0">Slag Yard</data>
  <data key="d1">location</data>
  <data key="d2">Slag Yard is the storage facility for PG produced during phosphoric acid production in Scenario 1.&lt;SEP&gt;Slag Yard is a facility whose leachate discharge is reduced through PG reuse.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-017&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-003</data>
