<node id="Flotation Agents">
  <data key="d0">Flotation Agents</data>
  <data key="d1">artifact</data>
  <data key="d2">Flotation agents are chemical additives used in the flotation method to remove organic matter.&lt;SEP&gt;Flotation agents are chemical additives used in the flotation method to remove organic matter.&lt;SEP&gt;Flotation agents are chemical additives used in the flotation method to remove organic matter.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-002&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-002&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-002</data>
