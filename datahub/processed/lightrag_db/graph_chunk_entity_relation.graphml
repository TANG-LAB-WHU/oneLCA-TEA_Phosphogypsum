  <data key="d0">Bioactive Glasses</data>
  <data key="d1">artifact</data>
  <data key="d2">Bioactive Glasses are a class of biomaterials extensively studied for their bone tissue-engineering applications.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-013</data>
  <data key="d4">unknown_source</data>
