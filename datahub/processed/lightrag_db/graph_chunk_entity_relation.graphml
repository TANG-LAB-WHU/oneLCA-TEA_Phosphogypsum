  <data key="d0">IR Measurements</data>
  <data key="d1">method</data>
  <data key="d2">IR measurements are analytical techniques used to verify the phase composition of phosphogypsum waste.&lt;SEP&gt;IR measurements are spectroscopic techniques used to evaluate the chemical composition of phosphogypsum waste.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-004&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-008</data>
