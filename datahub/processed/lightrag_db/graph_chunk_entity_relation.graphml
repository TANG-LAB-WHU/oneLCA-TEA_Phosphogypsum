<node id="Hierarchical Microstructure">
  <data key="d0">Hierarchical Microstructure</data>
  <data key="d1">concept</data>
  <data key="d2">Hierarchical microstructure refers to the complex, multi-level arrangement of HAp crystals determined by precursor morphology and reaction conditions.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
