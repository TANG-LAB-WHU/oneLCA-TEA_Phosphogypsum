  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="Thermal Excitation">
  <data key="d0">Thermal Excitation</data>
  <data key="d1">concept</data>
  <data key="d2">Thermal Excitation is a process that generates electrons trapped on vacancies in hydroxyapatite, instigating the oxidation of organic compounds.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
