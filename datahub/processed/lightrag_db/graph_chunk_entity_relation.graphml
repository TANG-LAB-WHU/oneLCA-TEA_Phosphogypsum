  <data key="d4">unknown_source</data>
  <data key="d5">1791966541</data>
  <data key="d6"></data>
</node>
<node id="Polypropylene Oxide">
  <data key="d0">Polypropylene Oxide</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Polypropylene Oxide serves as the hydrophobic block of the P123 Surfactant that attaches to Hydroxyapatite crystal surfaces.</data>
