<node id="Preferential Occupancy">
  <data key="d0">Preferential Occupancy</data>
  <data key="d1">concept</data>
  <data key="d2">Preferential Occupancy is the phenomenon where specific metal ions favor Ca(II) or Ca(I) sites based on ionic radius and electronegativity.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005</data>
