<node id="Brazilian Industrial Company">
  <data key="d0">Brazilian Industrial Company</data>
  <data key="d1">organization</data>
  <data key="d2">The Brazilian Industrial Company provided the Phosphogypsum sample used in the study.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-002</data>
