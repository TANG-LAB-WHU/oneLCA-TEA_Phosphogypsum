  <data key="d2">An industrial device used to absorb fluorosilicic acid from gaseous emissions during phosphate rock processing.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189571</data>
