<node id="Portland cement">
  <data key="d0">Portland cement</data>
  <data key="d1">artifact</data>
  <data key="d2">A hydraulic cement produced by intergrinding cement clinker with impure phosphogypsum.&lt;SEP&gt;Portland cement is a common type of cement whose properties are analyzed in the text.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-005&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-002</data>
