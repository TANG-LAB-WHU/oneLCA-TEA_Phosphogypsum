  <data key="d5">1791288310</data>
  <data key="d6"></data>
</node>
<node id="Intercept">
  <data key="d0">Intercept</data>
  <data key="d1">data</data>
  <data key="d2">The intercept of the plotted line is used to determine the Freundlich constant K_F.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
  <data key="d6"></data>
</node>
<node id="Slope">
  <data key="d0">Slope</data>
  <data key="d1">concept</data>
  <data key="d2">The slope of the plotted line is used to determine the parameter n.&lt;SEP&gt;Slope refers to the geometric extension of the subbase layer outward beyond the upper pavement layers.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791880957</data>
  <data key="d6"></data>
</node>
<node id="Isoelectric Point">
  <data key="d0">Isoelectric Point</data>
  <data key="d1">concept</data>
  <data key="d2">The isoelectric point represents the zero potential level on the zeta potential graph.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
  <data key="d6"></data>
