</node>
<node id="Guerrero JL">
  <data key="d0">Guerrero JL</data>
  <data key="d1">person</data>
  <data key="d2">Guerrero JL is a researcher who applied phosphogypsum to improve salt marshes soil.&lt;SEP&gt;Guerrero JL is a researcher who applied phosphogypsum to improve salt marshes soil.&lt;SEP&gt;Guerrero JL is a researcher who applied phosphogypsum to improve salt marshes soil.</data>
