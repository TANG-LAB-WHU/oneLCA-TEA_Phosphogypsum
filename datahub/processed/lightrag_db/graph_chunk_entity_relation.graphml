<node id="Trihexyl(tetradecyl)phosphonium">
  <data key="d0">Trihexyl(tetradecyl)phosphonium</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A cation represented as [P66614]+ that reacts with the lanthanum complex to form a salt product.</data>
