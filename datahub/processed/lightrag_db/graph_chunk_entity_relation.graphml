<node id="Surface Oxygen Vacancies">
  <data key="d0">Surface Oxygen Vacancies</data>
  <data key="d1">concept</data>
  <data key="d2">Surface oxygen vacancies are structural defects that act as photoinduced charge traps and adsorption sites, enhancing photocatalytic performance.</data>
  <data key="d3">doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792190223</data>
  <data key="d6"></data>
</node>
<node id="Bulk Oxygen Vacancies">
  <data key="d0">Bulk Oxygen Vacancies</data>
  <data key="d1">concept</data>
  <data key="d2">Bulk oxygen vacancies function as traps for charge carriers, leading to the recombination of photogenerated electron-hole pairs.</data>
  <data key="d3">doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792190223</data>
