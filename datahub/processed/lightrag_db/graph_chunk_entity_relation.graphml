</node>
<node id="E2 Mix">
  <data key="d0">E2 Mix</data>
  <data key="d1">artifact</data>
  <data key="d2">A designed mixture of phosphogypsum and soil material that shows significant improvement in particle size distribution under stress.&lt;SEP&gt;Second experimental formulation identified as optimal, demonstrating superior physicochemical and mechanical performance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-011&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
