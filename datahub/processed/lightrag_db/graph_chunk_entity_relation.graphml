<node id="A-axis">
  <data key="d0">A-axis</data>
  <data key="d1">concept</data>
  <data key="d2">The a-axis is a crystallographic direction in hydroxyapatite; higher crystallinity toward this axis correlates with increased photocatalytic activity.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
