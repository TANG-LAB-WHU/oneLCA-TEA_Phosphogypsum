<node id="Acid mine drainage">
  <data key="d0">Acid mine drainage</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Acid mine drainage is a wastewater stream containing dissolved metals, including rare earth elements, that can be treated for recovery.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-020</data>
