<node id="High-Sulfur-Concentration Coal">
  <data key="d0">High-Sulfur-Concentration Coal</data>
  <data key="d1">naturalobject</data>
  <data key="d2">High-sulfur-concentration coal is used in the reductive decomposition of phosphogypsum to produce SO2 in an inert atmosphere.</data>
  <data key="d3">doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-055</data>
  <data key="d4">unknown_source</data>
