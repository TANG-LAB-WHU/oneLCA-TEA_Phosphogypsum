<node id="Electrospinning">
  <data key="d0">Electrospinning</data>
  <data key="d1">method</data>
  <data key="d2">Electrospinning is a fabrication technique used to produce icariin-loaded core-shell composite scaffolds.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
