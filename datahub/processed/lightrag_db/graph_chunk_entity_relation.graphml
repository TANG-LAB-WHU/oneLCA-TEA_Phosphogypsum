  <data key="d12">1791367225</data>
  <data key="d13"></data>
</edge>
<edge source="Phosphogypsum" target="Environment">
  <data key="d7">1.0</data>
  <data key="d8">Phosphogypsum stockpiling causes environmental harm through chemical pollution, radiation exposure, and dust release.</data>
  <data key="d9">impact,pollution</data>
