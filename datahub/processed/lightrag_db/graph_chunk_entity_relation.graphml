<node id="Chemical Materials">
  <data key="d0">Chemical Materials</data>
  <data key="d1">artifact</data>
  <data key="d2">Chemical Materials are high-value phosphogypsum-based products considered for production in the long term.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791450501</data>
  <data key="d6"></data>
</node>
<node id="Construction and Real Estate Sectors">
  <data key="d0">Construction and Real Estate Sectors</data>
  <data key="d1">organization</data>
  <data key="d2">Construction and Real Estate Sectors are industrial domains subject to incentives and regulatory measures to boost phosphogypsum-based product demand.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791450501</data>
