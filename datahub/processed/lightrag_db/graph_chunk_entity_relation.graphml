  <data key="d0">O=C=O Group</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The O=C=O group is an organic functional group identified by peaks at 2357 cm⁻¹ in the BC spectrum.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-003</data>
