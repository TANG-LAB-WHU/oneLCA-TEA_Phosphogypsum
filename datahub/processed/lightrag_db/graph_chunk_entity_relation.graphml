<node id="Ex-situ Pathways">
  <data key="d0">Ex-situ Pathways</data>
  <data key="d1">concept</data>
  <data key="d2">Recycling approaches for phosphogypsum conducted outside the original site, including REE recovery and construction materials.</data>
