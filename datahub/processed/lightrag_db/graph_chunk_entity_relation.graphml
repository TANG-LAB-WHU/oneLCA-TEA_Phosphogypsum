<node id="Adsorbate">
  <data key="d0">Adsorbate</data>
  <data key="d1">concept</data>
  <data key="d2">The adsorbate is the substance being adsorbed by the adsorbent at equilibrium.&lt;SEP&gt;The target substance that is removed from the solution by the adsorbent.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015&lt;SEP&gt;doc-9e17ad262bd9835860df552d7ff475f1-chunk-017</data>
