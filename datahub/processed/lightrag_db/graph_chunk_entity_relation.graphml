<node id="Bone tissue repair">
  <data key="d0">Bone tissue repair</data>
  <data key="d1">concept</data>
  <data key="d2">Bone tissue repair refers to the clinical application and biological process of regenerating damaged bone structures using biomaterials and composites.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061334</data>
