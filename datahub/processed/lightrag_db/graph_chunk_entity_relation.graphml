<node id="Sulforhodamine B Assay">
  <data key="d0">Sulforhodamine B Assay</data>
  <data key="d1">method</data>
  <data key="d2">The Sulforhodamine B assay is a colorimetric method used to determine cytotoxicity and investigate cell proliferation.</data>
