<node id="Citrate Ions">
  <data key="d0">Citrate Ions</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Citrate ions are chemical species that stabilize apatite nanocrystals and control the morphology of fluorapatite crystallites.&lt;SEP&gt;Citrate ions are chemical agents used to control the crystallite morphology of fluorapatite and are present in hexahydrated nickel iron citrate.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-005&lt;SEP&gt;doc-f2534f7a997df3f80305323317b15be9-chunk-006</data>
