<node id="F. Hao">
  <data key="d0">F. Hao</data>
  <data key="d1">person</data>
  <data key="d2">F. Hao is a researcher who co-authored a 2018 study on calcium sulfate hemihydrate-tricalcium silicate composites for bone healing.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-017</data>
