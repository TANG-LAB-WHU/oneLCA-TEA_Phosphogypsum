<node id="Products">
  <data key="d0">Products</data>
  <data key="d1">concept</data>
  <data key="d2">Products refer to the synthesized materials adsorbed onto copper grids for characterization.&lt;SEP&gt;Products are the chemical species listed on the right side of the data table.&lt;SEP&gt;Products refer to MAP- and PG-related outputs generated by the integrated production system.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001&lt;SEP&gt;doc-2760dc2a11fedad02d24741a978cf20d-chunk-009&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792225627</data>
  <data key="d6"></data>
</node>
<node id="Fourier Transform Infrared">
  <data key="d0">Fourier Transform Infrared</data>
  <data key="d1">method</data>
  <data key="d2">A spectroscopic technique used to generate spectral curves representing molecular vibrations and chemical bonds.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-008</data>
