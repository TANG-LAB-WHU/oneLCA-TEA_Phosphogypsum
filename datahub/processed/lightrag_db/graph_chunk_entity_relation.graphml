  <data key="d6"></data>
</node>
<node id="Coagulant">
  <data key="d0">Coagulant</data>
  <data key="d1">artifact</data>
  <data key="d2">Coagulant, specifically analytical pure Na2SO4, is added to the filler mixture at a 0.5% mass ratio to aid preparation.&lt;SEP&gt;Coagulant is incorporated as a material component in the PGEF mixture.</data>
  <data key="d3">doc-98d8b2df45924e721bfa570f652f33e3-chunk-003&lt;SEP&gt;doc-98d8b2df45924e721bfa570f652f33e3-chunk-000</data>
