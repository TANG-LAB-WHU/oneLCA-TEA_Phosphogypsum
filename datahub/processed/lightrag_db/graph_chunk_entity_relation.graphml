</node>
<node id="Aspergillus Niger">
  <data key="d0">Aspergillus Niger</data>
  <data key="d1">creature</data>
  <data key="d2">Aspergillus niger is a fungus utilized alongside geological fluorapatite for the immobilization of lead.&lt;SEP&gt;Aspergillus Niger is a fungal species inoculated into press mud to enhance maize yield and potassium use efficiency.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-018&lt;SEP&gt;doc-e290dd6268316238694f70c30a367426-chunk-016</data>
  <data key="d4">unknown_source</data>
