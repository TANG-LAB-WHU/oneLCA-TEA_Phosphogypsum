  <data key="d4">unknown_source</data>
  <data key="d5">1792002021</data>
  <data key="d6"></data>
</node>
<node id="TG/DSC Curves">
  <data key="d0">TG/DSC Curves</data>
  <data key="d1">data</data>
  <data key="d2">TG/DSC Curves represent thermal analysis data showing the behavior of dried HAP under temperature changes.&lt;SEP&gt;TG/DSC Curves display multiple weight loss steps and thermal changes of dried Hydroxyapatite across different temperature ranges.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002483</data>
  <data key="d6"></data>
