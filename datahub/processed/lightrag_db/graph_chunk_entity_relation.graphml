</node>
<node id="Field emission scanning electron microscopy">
  <data key="d0">Field emission scanning electron microscopy</data>
  <data key="d1">method</data>
  <data key="d2">Field emission scanning electron microscopy is a characterization technique applied to the final crystals.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791260482</data>
  <data key="d6"></data>
