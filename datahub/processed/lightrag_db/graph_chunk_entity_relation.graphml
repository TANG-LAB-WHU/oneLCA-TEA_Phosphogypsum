<node id="Leaching Temperature">
  <data key="d0">Leaching Temperature</data>
  <data key="d1">data</data>
  <data key="d2">Leaching Temperature influences extraction rates, with ambient temperature deemed optimal to save energy and limit Iron leaching.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-005</data>
