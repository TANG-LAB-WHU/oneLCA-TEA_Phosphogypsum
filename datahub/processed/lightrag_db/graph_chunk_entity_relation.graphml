  <data key="d0">People Programme (Marie Curie Actions)</data>
  <data key="d1">organization</data>
  <data key="d2">The People Programme (Marie Curie Actions) provided financial support for the research under the Seventh Framework Programme.</data>
  <data key="d3">doc-4739e42903c95e1fb7e0ecfbca3a12df-chunk-006</data>
  <data key="d4">unknown_source</data>
