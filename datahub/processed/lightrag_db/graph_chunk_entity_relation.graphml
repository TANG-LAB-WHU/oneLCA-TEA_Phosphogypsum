<node id="Enrichment Factor">
  <data key="d0">Enrichment Factor</data>
  <data key="d1">concept</data>
  <data key="d2">The Enrichment Factor (EF) is a metric used to quantify the concentration of elements or radionuclides in samples compared to a natural background.&lt;SEP&gt;Enrichment Factor is a standard ratio or specific index used to model radionuclide migration or leaching.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-010&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
  <data key="d6"></data>
</node>
<node id="Normalized Index">
  <data key="d0">Normalized Index</data>
  <data key="d1">concept</data>
  <data key="d2">Normalized Index is a mathematical form bounded between 0 and 1, characteristic of saturation curves.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
  <data key="d6"></data>
</node>
<node id="Parent/Daughter Ratio">
  <data key="d0">Parent/Daughter Ratio</data>
  <data key="d1">data</data>
  <data key="d2">Parent/Daughter Ratio is a metric comparing radioactive isotope ratios across different sample groups.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
