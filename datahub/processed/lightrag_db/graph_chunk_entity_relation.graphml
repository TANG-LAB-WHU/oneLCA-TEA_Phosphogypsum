  <data key="d1">artifact</data>
  <data key="d2">A medical device used to load and inject the cement paste during washout resistance evaluation.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061334</data>
  <data key="d6"></data>
</node>
<node id="XRD Instrument">
