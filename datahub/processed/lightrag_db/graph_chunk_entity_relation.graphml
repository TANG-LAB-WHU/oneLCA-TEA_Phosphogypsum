<edge source="Anhydrite III" target="Anhydrite II">
  <data key="d7">7.0</data>
  <data key="d8">Anhydrite III transitions to insoluble anhydrite II at 428 degrees Celsius.&lt;SEP&gt;Anhydrite III transforms into anhydrite II at 428°C during thermal treatment.&lt;SEP&gt;Anhydrite III transforms into anhydrite II at 428°C.&lt;SEP&gt;Anhydrite III transforms into Anhydrite II when heated to 428°C.&lt;SEP&gt;Anhydrite III undergoes crystallographic transformation via reaction R3 to form anhydrite II.&lt;SEP&gt;Anhydrite III transforms into anhydrite II at higher temperatures than pure gypsum undergoes its own transformation.&lt;SEP&gt;Anhydrite III transforms into anhydrite II at higher temperatures during synthetic PG dehydration.</data>
  <data key="d9">R3,chemical reaction,dehydration,heating,phase transformation,phase transition,temperature dependence,temperature-driven,thermal transformation,thermal treatment</data>
  <data key="d10">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-007&lt;SEP&gt;doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-003&lt;SEP&gt;doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-008&lt;SEP&gt;doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-006&lt;SEP&gt;doc-eb86340ba0851c06e97600104fca25c9-chunk-005&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-018&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-017</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1792408377</data>
  <data key="d13"></data>
</edge>
<edge source="Anhydrite III" target="Semihydrate">
  <data key="d7">1.0</data>
  <data key="d8">Semihydrate further dehydrates to form anhydrite III.</data>
  <data key="d9">chemical transformation</data>
  <data key="d10">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-003</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1791499214</data>
  <data key="d13"></data>
</edge>
<edge source="Anhydrite III" target="428°C">
