<node id="Beta-Hemihydrate PG">
  <data key="d0">Beta-Hemihydrate PG</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Beta-hemihydrate PG is a specific form of phosphogypsum used in geopolymer cement production.</data>
