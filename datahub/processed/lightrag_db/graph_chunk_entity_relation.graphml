<node id="CTA+">
  <data key="d0">CTA+</data>
  <data key="d1">concept</data>
  <data key="d2">CTA+ is a cationic surfactant ion derived from CTAB that forms tetrahedral structures and micellar rods.</data>
  <data key="d3">doc-8a6c42f76034cfa4338bd156b7179fc5-chunk-008</data>
  <data key="d4">unknown_source</data>
