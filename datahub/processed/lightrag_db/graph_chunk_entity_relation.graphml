<node id="Pentachlorophenol">
  <data key="d0">Pentachlorophenol</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pentachlorophenol is an organic pollutant efficiently photodegraded over titanium dioxide-hydroxyapatite composite.&lt;SEP&gt;A chemical compound degraded by titania/hydroxyapatite composite photocatalysts with mosaic structures.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-018&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-038</data>
