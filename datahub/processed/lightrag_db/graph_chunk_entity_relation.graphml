<node id="Thermostatic Jacket 25° C">
  <data key="d0">Thermostatic Jacket 25° C</data>
  <data key="d1">artifact</data>
  <data key="d2">Thermostatic Jacket 25° C is a temperature-controlled apparatus used during the processing of Washed PG with KOH.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-027</data>
