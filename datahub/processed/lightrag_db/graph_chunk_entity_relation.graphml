  <data key="d5">1791060479</data>
  <data key="d6"></data>
</node>
<node id="Apatite Crystals">
  <data key="d0">Apatite Crystals</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Precipitated mineral crystals that form on the material surface, indicating bioactivity and apatite-forming ability.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791060479</data>
