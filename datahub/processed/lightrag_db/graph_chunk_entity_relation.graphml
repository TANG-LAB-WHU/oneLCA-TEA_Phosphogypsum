<node id="Cao">
  <data key="d0">Cao</data>
  <data key="d1">person</data>
  <data key="d2">Cao systematically studied calcination temperature effects on phosphogypsum properties, analyzing changes in chemical mineral composition.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-008</data>
