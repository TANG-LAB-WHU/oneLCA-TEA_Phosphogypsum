  <data key="d5">1791260482</data>
  <data key="d6"></data>
</node>
<node id="Teflon Bottle">
  <data key="d0">Teflon Bottle</data>
  <data key="d1">artifact</data>
  <data key="d2">Teflon bottle is a 100 ml container used to hold the mixture solution during hydrothermal treatment.&lt;SEP&gt;The Teflon bottle serves as the inner vessel for the hydrothermal synthesis of hydroxyapatite.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001&lt;SEP&gt;doc-f1fb5c243f2539cf7be6b6021b63c36f-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791485610</data>
  <data key="d6"></data>
</node>
<node id="Stainless Steel Autoclave">
  <data key="d0">Stainless Steel Autoclave</data>
  <data key="d1">artifact</data>
  <data key="d2">Stainless steel autoclave is used to seal and heat the Teflon bottle at 180 °C for 24 hours.&lt;SEP&gt;The stainless steel autoclave houses the Teflon bottle and provides the sealed high-temperature environment for hydrothermal synthesis.&lt;SEP&gt;The Stainless Steel Autoclave houses the Teflon reactor and provides the high-temperature environment for hydrothermal synthesis.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001&lt;SEP&gt;doc-f1fb5c243f2539cf7be6b6021b63c36f-chunk-001&lt;SEP&gt;doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Mixture">
  <data key="d0">Mixture</data>
  <data key="d1">other</data>
  <data key="d2">Mixture is formed by combining Solution A and Solution B under vigorous stirring.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791260482</data>
  <data key="d6"></data>
</node>
<node id="Products">
  <data key="d0">Products</data>
  <data key="d1">concept</data>
  <data key="d2">Products refer to the synthesized materials adsorbed onto copper grids for characterization.&lt;SEP&gt;Products are the chemical species listed on the right side of the data table.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001&lt;SEP&gt;doc-2760dc2a11fedad02d24741a978cf20d-chunk-009</data>
