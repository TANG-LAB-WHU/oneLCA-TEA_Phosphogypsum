  <data key="d6"></data>
</node>
<node id="Road Pavements">
  <data key="d0">Road Pavements</data>
  <data key="d1">concept</data>
  <data key="d2">Road pavements are infrastructure components where the stabilized mix formulation is applied for construction.&lt;SEP&gt;Road pavements represent the construction application where phosphogypsum-based mixes are implemented for capping, foundation, and base layers.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Ettringite Phase">
  <data key="d0">Ettringite Phase</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ettringite phase is a chemical compound formed through blending alkalinity conditions that enhances the mechanical strength of the mix.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="TCLP Leaching Test">
  <data key="d0">TCLP Leaching Test</data>
  <data key="d1">method</data>
  <data key="d2">TCLP leaching test is an environmental assessment method used to measure heavy metal concentrations in construction mixes.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="P13 Mix">
  <data key="d0">P13 Mix</data>
  <data key="d1">data</data>
  <data key="d2">P13 Mix is an optimal formulation with a CM/PG ratio of 0.45 and a pH of 10.4.&lt;SEP&gt;P13 Mix is an optimal construction mixture evaluated for mechanical properties and environmental leaching behavior.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-012</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="OCP-SA">
  <data key="d0">OCP-SA</data>
  <data key="d1">organization</data>
  <data key="d2">OCP-SA is the funding organization that supported the research through a specific agreement.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Phosphogypsum Road Construction Study">
  <data key="d0">Phosphogypsum Road Construction Study</data>
  <data key="d1">concept</data>
  <data key="d2">Phosphogypsum Road Construction Study is the research project investigating the utilization of phosphogypsum in road layers.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Blending Alkalinity Conditions">
  <data key="d0">Blending Alkalinity Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Blending alkalinity conditions facilitate the formation of the ettringite phase, enhancing mix strength.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="RE01">
  <data key="d0">RE01</data>
  <data key="d1">content</data>
  <data key="d2">RE01 is the specific agreement under which OCP-SA funded the research.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Experimental Road Section">
  <data key="d0">Experimental Road Section</data>
  <data key="d1">location</data>
  <data key="d2">The experimental road section is the planned site for future full-scale field investigations to test pavement and embankment layers.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Capping Layer">
  <data key="d0">Capping Layer</data>
  <data key="d1">concept</data>
  <data key="d2">A structural component of road pavements requiring specific mechanical performance.&lt;SEP&gt;The capping layer is a road construction component where phosphogypsum-based mixes are applied to achieve required mechanical performance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Foundation Layer">
  <data key="d0">Foundation Layer</data>
  <data key="d1">concept</data>
  <data key="d2">The foundation layer is a road construction component where phosphogypsum-based mixes are applied to achieve required mechanical performance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Base Layer">
  <data key="d0">Base Layer</data>
  <data key="d1">artifact</data>
  <data key="d2">Base Layer is a road structure component requiring an IBI value greater than 50.&lt;SEP&gt;A structural component of road pavements requiring specific mechanical performance.&lt;SEP&gt;The base layer is a road construction component where phosphogypsum-based mixes are applied to achieve required mechanical performance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="(E, Rt)">
  <data key="d0">(E, Rt)</data>
  <data key="d1">data</data>
  <data key="d2">(E, Rt) represents the specific mechanical parameters measured to evaluate the performance of the road construction layers.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Profitability Perimeter">
  <data key="d0">Profitability Perimeter</data>
  <data key="d1">concept</data>
  <data key="d2">The profitability perimeter defines the economic boundary within which large quantities of phosphogypsum can be valorized in road construction.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="PG:SM:CM:HRB Mix">
  <data key="d0">PG:SM:CM:HRB Mix</data>
  <data key="d1">concept</data>
  <data key="d2">A stabilized material formulation combining phosphogypsum, silty gravel material, CM sample, and HRB for use in embankments and road pavements.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="P12">
  <data key="d0">P12</data>
  <data key="d1">artifact</data>
  <data key="d2">P12 is an experimental material mix evaluated for use in capping and pavement layers.&lt;SEP&gt;P12 is a specimen prepared with 14.7 wt% moisture content and 10.8 alkalinity, used to evaluate structural classification and mineralogical composition.&lt;SEP&gt;A sample mixture analyzed for chemical composition against US-EPA regulatory limits.&lt;SEP&gt;A material mixture containing Zinc at a concentration of 3 mg/l.&lt;SEP&gt;P12 is a sample mix with CM-PG-SM-HRB composition and a proportion of CM:PG:SM:HRB = (10:25:65):7.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-019&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-020&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-021&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="P13">
  <data key="d0">P13</data>
  <data key="d1">artifact</data>
  <data key="d2">P13 is an experimental material mix classified in zone 4 and S1 class for pavement applications.&lt;SEP&gt;P13 is a specimen prepared with 14 wt% moisture content and 10.4 alkalinity, used to evaluate structural classification and mineralogical composition.&lt;SEP&gt;A second sample mixture analyzed for chemical composition against US-EPA regulatory limits.&lt;SEP&gt;A material mixture containing Zinc at a concentration of 4 mg/l.&lt;SEP&gt;P13 is a sample mix with CM-PG-SM-HRB composition and a proportion of CM:PG:SM:HRB = (10:20:70):7.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-019&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-020&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-021&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="TCLP Test">
  <data key="d0">TCLP Test</data>
  <data key="d1">method</data>
  <data key="d2">A test used to evaluate the leaching behavior of raw phosphogypsum and compare trace element concentrations with regulatory thresholds.&lt;SEP&gt;A leaching test used to evaluate the concentration of trace elements in raw phosphogypsum against regulatory limits.&lt;SEP&gt;A toxicity characteristic leaching procedure used to measure the concentration of heavy metals in mixes.&lt;SEP&gt;The TCLP test is used to assess the environmental impact of optimal mixes by measuring trace element leaching.&lt;SEP&gt;A standardized testing method used to monitor environmental stability by detecting harmful elements.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-013&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-020&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Silty Gravel Material">
  <data key="d0">Silty Gravel Material</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Silty gravel material is a predominantly silty gravel additive used to stabilize raw phosphogypsum and improve its geotechnical properties.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Proctor Test">
  <data key="d0">Proctor Test</data>
  <data key="d1">method</data>
  <data key="d2">The Proctor test measures dry density and compaction characteristics, serving as a key parameter for evaluating phosphogypsum geotechnical performance.&lt;SEP&gt;A standard compaction test used to determine the optimum moisture content and maximum dry density of soil materials.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792141823</data>
  <data key="d6"></data>
</node>
<node id="Friability Coefficient">
  <data key="d0">Friability Coefficient</data>
  <data key="d1">data</data>
  <data key="d2">A numerical value (68) indicating the resistance of a material to fragmentation.&lt;SEP&gt;The friability coefficient of 68 indicates that raw phosphogypsum behaves like eroded, very friable fine sand.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="CM Sample">
  <data key="d0">CM Sample</data>
  <data key="d1">artifact</data>
  <data key="d2">The CM sample is an additive that increases mix pH to basic values and provides calcium, aluminium, and sulfates for hydration reactions.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Calcium Sulfo Aluminate Mineral">
  <data key="d0">Calcium Sulfo Aluminate Mineral</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A mineral phase formed via pozzolanic reaction, identified as ettringite.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Foundation">
  <data key="d0">Foundation</data>
  <data key="d1">artifact</data>
  <data key="d2">A structural component of road pavements requiring specific mechanical performance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Dry Density">
  <data key="d0">Dry Density</data>
  <data key="d1">data</data>
  <data key="d2">A physical property measured at 14.8 kN/m^3 under modified Proctor compaction conditions.&lt;SEP&gt;A geotechnical parameter measured via the modified Proctor test, showing improvement with SM addition.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Fractal Behaviour">
  <data key="d0">Fractal Behaviour</data>
  <data key="d1">concept</data>
  <data key="d2">An analytical approach used to study the particle size distribution of mixes under controlled compaction.&lt;SEP&gt;Fractal behaviour describes the granulometric evolution of raw PG under fragmentation stress.&lt;SEP&gt;A parameter describing fragmentation conditions, improved by SM addition.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-007&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Resistance To Water Erosion">
  <data key="d0">Resistance To Water Erosion</data>
  <data key="d1">data</data>
  <data key="d2">A geotechnical parameter measuring durability against water, improved by SM addition.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="PG:SM Ratio">
  <data key="d0">PG:SM Ratio</data>
  <data key="d1">data</data>
  <data key="d2">The proportion of phosphogypsum to silty gravel material (40:60) that optimizes embankment height.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Embankment Height">
  <data key="d0">Embankment Height</data>
  <data key="d1">data</data>
  <data key="d2">The maximum allowable height for embankments, which can reach 8 m with the optimal PG:SM ratio.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937342</data>
  <data key="d6"></data>
</node>
<node id="Compressibility Curve">
  <data key="d0">Compressibility Curve</data>
  <data key="d1">content</data>
  <data key="d2">A graphical representation showing how stress-strain affects the fractal behavior of the material's particle distribution.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Predictable Settlements">
  <data key="d0">Predictable Settlements</data>
  <data key="d1">data</data>
  <data key="d2">Quantitative measurements of embankment deformation in centimeters corresponding to different construction heights.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Water Erosion">
  <data key="d0">Water Erosion</data>
  <data key="d1">concept</data>
  <data key="d2">Water erosion is a risk associated with the very fine granular texture of raw PG on embankment slopes.&lt;SEP&gt;A natural process affecting specific particle size fractions, which is significantly mitigated by adding soil material to phosphogypsum.&lt;SEP&gt;A geological process assessed by monitoring grain size distribution.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-020&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="PG Mix">
  <data key="d0">PG Mix</data>
  <data key="d1">naturalobject</data>
  <data key="d2">PG Mix refers to the raw phosphogypsum used as a baseline for comparing the fragmentation and granulometric properties of designed mixes.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Stress Level">
  <data key="d0">Stress Level</data>
  <data key="d1">concept</data>
  <data key="d2">Stress Level represents the applied pressure (e.g., 2.7 MPa, 1.5 MPa) used to evaluate the fragmentation and grain size evolution of the mixes.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Particle Size Threshold">
  <data key="d0">Particle Size Threshold</data>
  <data key="d1">concept</data>
  <data key="d2">Particle Size Threshold refers to specific granulometric fractions (e.g., &lt;80 μm, 0/250 μm) analyzed to assess fragmentation and erosion resistance.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Mix Ratio">
  <data key="d0">Mix Ratio</data>
  <data key="d1">data</data>
  <data key="d2">Mix Ratio indicates the proportion of components in the tested samples, such as PG = 100 for raw phosphogypsum.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791937751</data>
  <data key="d6"></data>
</node>
<node id="Mix E2">
  <data key="d0">Mix E2</data>
  <data key="d1">other</data>
