  <data key="d6"></data>
</node>
<node id="Food Waste">
  <data key="d0">Food Waste</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Food waste consists of avoidable and unavoidable organic materials that contribute phosphorus to the organic waste sector.&lt;SEP&gt;Food waste refers to avoidable wastage such as spoilage during food processing and preparation that presents recovery opportunities.&lt;SEP&gt;Food waste generated in municipal and commercial/industrial sectors, tracked for landfill versus recycling splits.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-018&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-007&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792247941</data>
  <data key="d6"></data>
</node>
<node id="Seafood Waste">
  <data key="d0">Seafood Waste</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pre-consumer and post-consumer seafood waste tracked as a component of organic waste.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-018</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792247941</data>
  <data key="d6"></data>
</node>
<node id="Phosphorus Losses">
  <data key="d0">Phosphorus Losses</data>
  <data key="d1">concept</data>
  <data key="d2">Phosphorus losses are waste streams within the food system that can be avoided or reduced through management measures.&lt;SEP&gt;Phosphorus losses represent the permanent or temporary removal of phosphorus from productive reuse across various sectors.&lt;SEP&gt;Phosphorus losses refer to the unavoidable or avoidable depletion of phosphorus resources from the food system.&lt;SEP&gt;Quantitative metric measuring kilotonnes of phosphorus per annum lost across economic sectors.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-018&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-002&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-010&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792247941</data>
  <data key="d6"></data>
</node>
<node id="Phosphorus Recycled">
  <data key="d0">Phosphorus Recycled</data>
  <data key="d1">data</data>
  <data key="d2">Quantitative metric measuring kilotonnes of phosphorus per annum recycled to agriculture.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-018</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792247941</data>
  <data key="d6"></data>
</node>
<node id="Sufficient Data Quality">
  <data key="d0">Sufficient Data Quality</data>
  <data key="d1">concept</data>
  <data key="d2">A data quality category indicating reliable and verified information.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-018</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792247941</data>
  <data key="d6"></data>
</node>
<node id="Poor Questionable Data Quality">
  <data key="d0">Poor Questionable Data Quality</data>
  <data key="d1">concept</data>
