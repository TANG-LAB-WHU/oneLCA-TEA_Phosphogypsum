<node id="Methanol Oxidation">
  <data key="d0">Methanol Oxidation</data>
  <data key="d1">concept</data>
  <data key="d2">Methanol oxidation is a chemical reaction where calcium-deficient hydroxyapatite supports enhance catalytic activity through surface acid sites.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-020</data>
