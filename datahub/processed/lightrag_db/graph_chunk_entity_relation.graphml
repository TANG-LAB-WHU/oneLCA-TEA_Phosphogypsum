<node id="1/n">
  <data key="d0">1/n</data>
  <data key="d1">data</data>
  <data key="d2">A term related to adsorption intensity or surface heterogeneity in the Freundlich equation.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
