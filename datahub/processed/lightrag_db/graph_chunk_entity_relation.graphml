</node>
<node id="Substitutional Solid Solution">
  <data key="d0">Substitutional Solid Solution</data>
  <data key="d1">concept</data>
  <data key="d2">A crystal structure formed when ions with similar radii replace matrix ions, contingent upon ion radius differences and charge balance.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Houm-Rathery Law">
  <data key="d0">Houm-Rathery Law</data>
  <data key="d1">concept</data>
  <data key="d2">A theoretical principle delineating the limitations of ion radius gaps, allowing a 15% volume-mismatch error for ion substitution.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Vigard Theorem">
  <data key="d0">Vigard Theorem</data>
  <data key="d1">concept</data>
  <data key="d2">A theoretical principle describing the correlation between changes in lattice parameters of solid solutions and the radius of impurity ions during substitution.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Arsenic Ion">
  <data key="d0">Arsenic Ion</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A heavy metal ion that can be replaced by iron ions or form bidentate mononuclear complexes to reduce leaching.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Powdered MPG">
  <data key="d0">Powdered MPG</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A powdered material subjected to modification processes where calcium and iron undergo substitution reactions with heavy metals.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Bidentate Mononuclear Complex">
  <data key="d0">Bidentate Mononuclear Complex</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A chemical complex formed between arsenic ions and iron ions, which reduces the leaching amount of arsenic.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Interstitial Solid Solution">
  <data key="d0">Interstitial Solid Solution</data>
  <data key="d1">concept</data>
  <data key="d2">Interstitial solid solution is a crystal structure formation that leads to an increase in the average lattice constant of the crystal.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Displacement Solid Solution">
  <data key="d0">Displacement Solid Solution</data>
  <data key="d1">concept</data>
  <data key="d2">Displacement solid solution is formed when cadmium and mercury ions replace calcium ions in hemihydrate or anhydrous calcium sulfate.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Replacement Solid Solution">
  <data key="d0">Replacement Solid Solution</data>
  <data key="d1">concept</data>
  <data key="d2">Replacement solid solution is formed when cadmium and mercury ions replace oxygen ions in half-water or anhydrous calcium sulfate.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Lattice Constant">
  <data key="d0">Lattice Constant</data>
  <data key="d1">concept</data>
  <data key="d2">The average lattice constant of a crystal alters during the formation of substitutional solid solutions and increases during interstitial solid solution formation.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Electrical Neutrality">
  <data key="d0">Electrical Neutrality</data>
  <data key="d1">concept</data>
  <data key="d2">Electrical neutrality is a state that must be maintained by balancing charges when ions are added to gap positions in a lattice structure.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Polarization Ability">
  <data key="d0">Polarization Ability</data>
  <data key="d1">concept</data>
  <data key="d2">Polarization ability is a property of ions such as chromium, arsenic, cadmium, and mercury that was calculated alongside their radius differences.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
