<node id="Ca/P Value">
  <data key="d0">Ca/P Value</data>
  <data key="d1">data</data>
  <data key="d2">The Ca/P value is a chemical ratio in hydroxyapatite that is influenced by alterations in compound purity and substitutions.&lt;SEP&gt;The Ca/P value is a chemical ratio in hydroxyapatite that influences its purity and remediation efficiency.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-008&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-009</data>
  <data key="d4">unknown_source</data>
