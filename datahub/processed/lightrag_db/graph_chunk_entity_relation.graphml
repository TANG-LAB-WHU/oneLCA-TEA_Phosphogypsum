  <data key="d0">Calcium Aluminate Hydrate</data>
  <data key="d1">concept</data>
  <data key="d2">Calcium Aluminate Hydrate is a chemical compound formed from the reaction of calcium, hydroxide, and tetrahydroxoaluminate ions.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
