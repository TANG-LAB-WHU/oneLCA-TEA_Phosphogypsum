  <data key="d4">unknown_source</data>
  <data key="d5">1791247343</data>
  <data key="d6"></data>
</node>
<node id="Adsorption Capacities">
  <data key="d0">Adsorption Capacities</data>
  <data key="d1">concept</data>
  <data key="d2">Adsorption Capacities describe hydroxyapatite's ability to retain pollutants or facilitate catalytic reactions by binding reactants on its surface.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-003</data>
