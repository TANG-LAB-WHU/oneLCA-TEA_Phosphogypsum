</node>
<node id="Kovdor">
  <data key="d0">Kovdor</data>
  <data key="d1">location</data>
  <data key="d2">Kovdor is a geographic region where phosphate rock contains a rare earth element concentration of 0.14%.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-001</data>
