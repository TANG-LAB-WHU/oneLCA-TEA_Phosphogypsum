<node id="Langmuir Constant">
  <data key="d0">Langmuir Constant</data>
  <data key="d1">data</data>
  <data key="d2">Langmuir Constant (K_L) is a parameter derived from the Langmuir isotherm model.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-009</data>
  <data key="d4">unknown_source</data>
