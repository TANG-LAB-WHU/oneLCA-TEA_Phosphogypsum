<node id="Calcium-Citrate Complex">
  <data key="d0">Calcium-Citrate Complex</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The calcium-citrate complex is an intermediate compound whose morphology transformation dictates the final structure of hydroxyapatite products.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-000</data>
  <data key="d4">unknown_source</data>
