</node>
<node id="10 MPa">
  <data key="d0">10 MPa</data>
  <data key="d1">data</data>
  <data key="d2">10 MPa is the low pressure applied during the press-forming process for brick manufacturing.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792453598</data>
  <data key="d6"></data>
</node>
<node id="90 Days">
  <data key="d0">90 Days</data>
  <data key="d1">data</data>
  <data key="d2">90 Days is a curing age at which chloride ion permeability was measured in Sindhuja et al.'s study.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792453914</data>
  <data key="d6"></data>
</node>
<node id="Sulfate Reaction">
  <data key="d0">Sulfate Reaction</data>
  <data key="d1">concept</data>
  <data key="d2">Sulfate reaction is a chemical process between gypsum and lime that causes expansion and strength loss in water-cured specimens.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792453914</data>
  <data key="d6"></data>
</node>
<node id="Altun and Sert">
  <data key="d0">Altun and Sert</data>
  <data key="d1">person</data>
  <data key="d2">Altun and Sert are researchers who optimized phosphogypsum replacement levels in cement pastes.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792453914</data>
