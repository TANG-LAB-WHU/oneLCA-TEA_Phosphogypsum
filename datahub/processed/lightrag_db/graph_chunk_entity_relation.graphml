<node id="Alkali-Activated Construction Materials">
  <data key="d0">Alkali-Activated Construction Materials</data>
  <data key="d1">artifact</data>
  <data key="d2">Alkali-activated construction materials are sustainable building products produced by recycling phosphogypsum and clay by-products from phosphate mines.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-020</data>
  <data key="d4">unknown_source</data>
