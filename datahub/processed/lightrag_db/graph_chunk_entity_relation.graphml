</node>
<node id="Equation E(1)">
  <data key="d0">Equation E(1)</data>
  <data key="d1">content</data>
  <data key="d2">Equation E(1) defines the maximum resistance per unit area of the grain boundary to grain boundary motion.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791090726</data>
