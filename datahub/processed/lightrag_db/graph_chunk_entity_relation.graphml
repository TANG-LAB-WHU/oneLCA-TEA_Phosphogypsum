  <data key="d0">Zebrafish</data>
  <data key="d1">creature</data>
  <data key="d2">Zebrafish serve as biological models in laboratory tests to evaluate the toxicity of phosphogypsum leachate.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="National Development and Reform Commission">
  <data key="d0">National Development and Reform Commission</data>
  <data key="d1">organization</data>
  <data key="d2">The National Development and Reform Commission is a Chinese government body that co-issued national policy directives on solid waste management.&lt;SEP&gt;The commission released guiding opinions in 2021 for the comprehensive utilization of bulk solid waste during the 14th Five-Year Plan.&lt;SEP&gt;The National Development and Reform Commission issued documents setting goals for phosphogypsum utilization rates.&lt;SEP&gt;The National Development and Reform Commission co-issued policies and plans to accelerate phosphogypsum applications and set utilization targets.&lt;SEP&gt;A Chinese government ministry that co-issued the 2017 ecological protection plan for the Yangtze River Economic Belt.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-015&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-000&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-008&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791900752</data>
  <data key="d6"></data>
</node>
<node id="Ministry of Industry and Information Technology">
  <data key="d0">Ministry of Industry and Information Technology</data>
  <data key="d1">organization</data>
  <data key="d2">The Ministry of Industry and Information Technology is a Chinese government agency that supports institutional mechanisms for industrial solid waste utilization.&lt;SEP&gt;The Ministry of Industry and Information Technology co-issued an implementation plan to accelerate phosphogypsum comprehensive utilization.&lt;SEP&gt;Government ministry supporting phosphogypsum applications in road materials and mine backfill.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-008&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791900207</data>
