<node id="Turkish Standard">
  <data key="d0">Turkish Standard</data>
  <data key="d1">content</data>
  <data key="d2">The Turkish standard establishes minimum compressive strength requirements for adobe blocks.&lt;SEP&gt;A regulatory framework specifying minimum engineering properties, such as compressive strength and unit weight, for cement-treated adobe bricks.</data>
  <data key="d3">doc-e4a551024f80f822f3f35e38ec278151-chunk-003&lt;SEP&gt;doc-e4a551024f80f822f3f35e38ec278151-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791734744</data>
  <data key="d6"></data>
