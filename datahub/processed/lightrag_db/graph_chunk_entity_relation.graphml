<node id="Pore-Water">
  <data key="d0">Pore-Water</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pore-water is the liquid found within the soil or waste matrix of PG stacks, where contaminant concentrations were measured.</data>
