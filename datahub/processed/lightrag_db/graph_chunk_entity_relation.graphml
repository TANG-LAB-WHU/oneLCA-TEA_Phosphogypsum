<node id="Cancerogenic By-products">
  <data key="d0">Cancerogenic By-products</data>
  <data key="d1">other</data>
  <data key="d2">Cancerogenic by-products are harmful compounds formed when fulvic acid reacts with water treatment compounds.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-013</data>
