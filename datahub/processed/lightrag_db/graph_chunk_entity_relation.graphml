  <data key="d2">Random Precipitation is an initial crystallization process that forms spherical hydroxyapatite nuclei before directional growth occurs.</data>
  <data key="d3">doc-8a6c42f76034cfa4338bd156b7179fc5-chunk-004</data>
  <data key="d4">unknown_source</data>
