</node>
<node id="Hemihydrate Sulfate Structure">
  <data key="d0">Hemihydrate Sulfate Structure</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A crystalline structure stabilized by solid solutions of Ce3+ and Na+, which slows dihydrate recrystallization.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
  <data key="d6"></data>
</node>
<node id="Hemi-Dihydrate Process">
  <data key="d0">Hemi-Dihydrate Process</data>
  <data key="d1">method</data>
  <data key="d2">The Hemi-Dihydrate Process is a production method that yields a relatively clean phosphogypsum filter cake.&lt;SEP&gt;A crystallization process involving hemihydrate and dihydrate phases where structural stabilization occurs.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-008</data>
