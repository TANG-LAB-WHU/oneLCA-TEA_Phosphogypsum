</node>
<node id="Wet Phosphoric Process">
  <data key="d0">Wet Phosphoric Process</data>
  <data key="d1">method</data>
  <data key="d2">The Wet Phosphoric Process is an industrial method for producing phosphoric acid that generates phosphogypsum containing radium.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-013</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
