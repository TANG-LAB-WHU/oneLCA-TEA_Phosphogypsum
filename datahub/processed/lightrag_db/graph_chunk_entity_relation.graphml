  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Ca-Montmorillonite">
  <data key="d0">Ca-Montmorillonite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ca-montmorillonite is a clay mineral that removes large quantities of fluoride and orthophosphate from solution.</data>
