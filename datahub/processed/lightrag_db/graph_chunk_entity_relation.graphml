<node id="Level 1">
  <data key="d0">Level 1</data>
  <data key="d1">data</data>
  <data key="d2">Level 1 represents the highest purity grade for phosphogypsum, featuring the strictest chemical limits.&lt;SEP&gt;The highest quality grade for phosphogypsum, with strict limits on sodium oxide and chloride ions.</data>
  <data key="d3">doc-76e07d75a9f5124d07b9dafa2dacfba7-chunk-002&lt;SEP&gt;doc-76e07d75a9f5124d07b9dafa2dacfba7-chunk-001</data>
