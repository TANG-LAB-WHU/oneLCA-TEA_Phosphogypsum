</node>
<node id="Hydroxyapatite Samples">
  <data key="d0">Hydroxyapatite Samples</data>
  <data key="d1">artifact</data>
  <data key="d2">Hydroxyapatite samples are synthesized materials evaluated for crystal size, carbonate content, and Ca/P ratio using various analytical methods.&lt;SEP&gt;Hydroxyapatite Samples (HAP1, HAP2, HAP3) are material samples analyzed to study thermal behavior and modification with BSA.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-004&lt;SEP&gt;doc-4739e42903c95e1fb7e0ecfbca3a12df-chunk-005</data>
  <data key="d4">unknown_source</data>
