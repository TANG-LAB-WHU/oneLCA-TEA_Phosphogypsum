  <data key="d0">Alpha-Measurements</data>
  <data key="d1">method</data>
  <data key="d2">Alpha-measurements are used to analyze uranium isotopes in phosphogypsum waste samples following radiochemical preparation.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-004</data>
