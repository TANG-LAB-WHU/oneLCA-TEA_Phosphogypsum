  <data key="d5">1792189472</data>
  <data key="d6"></data>
</node>
<node id="Field Emission Scanning Electron Microscopy">
  <data key="d0">Field Emission Scanning Electron Microscopy</data>
  <data key="d1">method</data>
  <data key="d2">Field Emission Scanning Electron Microscopy is a high-resolution imaging technique applied to analyze specific powder samples.&lt;SEP&gt;Field Emission Scanning Electron Microscopy is a high-resolution imaging technique used to observe particle shapes and sizes.</data>
  <data key="d3">doc-8a6c42f76034cfa4338bd156b7179fc5-chunk-004&lt;SEP&gt;doc-8a6c42f76034cfa4338bd156b7179fc5-chunk-002</data>
