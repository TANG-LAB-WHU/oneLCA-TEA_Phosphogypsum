  <data key="d0">Matrix Potential</data>
  <data key="d1">concept</data>
  <data key="d2">Matrix potential measures soil water conditions, influencing ionic strength, pollutant solubility, and plant nutrient uptake.&lt;SEP&gt;Matrix potential measures soil water conditions, influencing ionic strength, pollutant solubility, and plant nutrient uptake.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-013&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-013</data>
