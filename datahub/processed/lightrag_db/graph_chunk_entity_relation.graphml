<node id="Liquid Displacement Technique">
  <data key="d0">Liquid Displacement Technique</data>
  <data key="d1">method</data>
  <data key="d2">A measurement procedure used to determine the bulk density and porosity of samples by using ethanol as the displacement liquid.</data>
