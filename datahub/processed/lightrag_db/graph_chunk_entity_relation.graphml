<node id="Glass Ceramics">
  <data key="d0">Glass Ceramics</data>
  <data key="d1">artifact</data>
  <data key="d2">Glass Ceramics are a class of biomaterials extensively studied for their bone tissue-engineering applications.&lt;SEP&gt;Glass Ceramics represent a high-value application for phosphogypsum valorization.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-013&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-026</data>
