  <data key="d1">organization</data>
  <data key="d2">Organization that supplied reference materials for radiometric measurements.&lt;SEP&gt;Analytical Quality Control Services is a division of the IAEA that provides certified reference materials for detector calibration.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-001&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-001</data>
