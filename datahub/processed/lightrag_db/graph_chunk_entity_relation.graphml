<node id="Uraninite">
  <data key="d0">Uraninite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Uraninite is a crystal mineral whose Radon-222 emanation coefficient has been measured between 0.5% and 25%.&lt;SEP&gt;A crystal mineral in which Rn-222 emanation coefficients have been measured.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-016</data>
