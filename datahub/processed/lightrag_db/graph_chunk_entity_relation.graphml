<node id="C-axis">
  <data key="d0">C-axis</data>
  <data key="d1">concept</data>
  <data key="d2">The c-axis is a crystallographic direction in hydroxyapatite; its crystallinity remains similar across samples but does not drive the observed activity differences.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
