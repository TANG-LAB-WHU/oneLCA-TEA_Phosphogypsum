<node id="Phosphogypsum Waste Samples">
  <data key="d0">Phosphogypsum Waste Samples</data>
  <data key="d1">artifact</data>
  <data key="d2">Phosphogypsum waste samples are industrial byproducts analyzed for radiation hazard indices, showing significantly elevated absorbed gamma dose rates compared to international safety standards.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-007</data>
