<node id="Ringer's Solution">
  <data key="d0">Ringer's Solution</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ringer's Solution is the physiological liquid medium used as the target for injectability and anti-washout testing.&lt;SEP&gt;A liquid medium used for immersing cement paste to measure weight loss and stability.&lt;SEP&gt;A physiological saline solution used to evaluate the washout resistance and injectability of the cement paste.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061208</data>
  <data key="d6"></data>
</node>
<node id="Dental Applications">
  <data key="d0">Dental Applications</data>
  <data key="d1">concept</data>
  <data key="d2">Medical procedures where a shorter initial setting time of 3 minutes is preferred.&lt;SEP&gt;Medical procedures utilizing the cement, where a shorter initial setting time of approximately 3 minutes is preferred.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061208</data>
  <data key="d6"></data>
</node>
<node id="Orthopedic Procedures">
  <data key="d0">Orthopedic Procedures</data>
  <data key="d1">concept</data>
  <data key="d2">Medical procedures where an initial setting time of 8 minutes is desired.&lt;SEP&gt;Medical procedures utilizing the cement, where a longer initial setting time of approximately 8 minutes is desired.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007</data>
