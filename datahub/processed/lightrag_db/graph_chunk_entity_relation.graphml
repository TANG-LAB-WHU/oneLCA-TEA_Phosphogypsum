  <data key="d1">person</data>
  <data key="d2">Raut is a researcher who developed bricks using phosphogypsum, cement, and rice husk ash.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-013</data>
