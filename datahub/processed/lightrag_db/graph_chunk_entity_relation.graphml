  <data key="d1">method</data>
  <data key="d2">Oxidative Decomposition is a chemical process facilitated by hydroxyapatite at 400–500 °C to break down volatile and chlorinated organic compounds.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="Photocatalytic Decomposition">
  <data key="d0">Photocatalytic Decomposition</data>
  <data key="d1">method</data>
  <data key="d2">Photocatalytic Decomposition is a process where hydroxyapatite uses UV or solar radiation to degrade organic pollutants like dyes and hormones.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
  <data key="d6"></data>
</node>
<node id="Chloroapatite">
  <data key="d0">Chloroapatite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Chloroapatite is a compound formed when chloride ions replace hydroxide ions in the hydroxyapatite lattice during catalytic reactions.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247703</data>
