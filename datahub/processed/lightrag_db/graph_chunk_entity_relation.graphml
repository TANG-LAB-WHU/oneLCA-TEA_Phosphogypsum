  <data key="d6"></data>
</node>
<node id="Methanesulfonic acid">
  <data key="d0">Methanesulfonic acid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Methanesulfonic acid (MSA) is an eco-friendly lixiviant used in the leaching process of rare earth metals from phosphogypsum.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-020</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984452</data>
  <data key="d6"></data>
</node>
<node id="Sulfate leaching">
  <data key="d0">Sulfate leaching</data>
  <data key="d1">method</data>
  <data key="d2">Sulfate leaching is a hydrometallurgical technique optimized for extracting rare earth elements from phosphogypsum.</data>
