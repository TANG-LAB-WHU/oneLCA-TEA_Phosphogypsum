<node id="K_F">
  <data key="d0">K_F</data>
  <data key="d1">data</data>
  <data key="d2">K_F is the Freundlich adsorption capacity constant.&lt;SEP&gt;K_F is the Freundlich constant representing adsorption capacity, determined from the intercept of the linearized equation.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-005&lt;SEP&gt;doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
