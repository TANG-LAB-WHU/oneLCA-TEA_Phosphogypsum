</node>
<node id="Heat Treatment Temperature">
  <data key="d0">Heat Treatment Temperature</data>
  <data key="d1">concept</data>
  <data key="d2">Heat Treatment Temperature is a variable that affects the normalized saturated amounts of adsorbed proteins and ion concentrations in hydroxyapatite.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247038</data>
  <data key="d6"></data>
</node>
<node id="Adsorbed Proteins">
  <data key="d0">Adsorbed Proteins</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Adsorbed Proteins are biological molecules whose saturated amounts are measured as a function of heat treatment temperature.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247038</data>
  <data key="d6"></data>
</node>
<node id="Hap Particles">
  <data key="d0">Hap Particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hap Particles are hydroxyapatite particles from which calcium and phosphate ions are dissolved after heat treatment.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247038</data>
  <data key="d6"></data>
</node>
<node id="Nuclear Waste">
  <data key="d0">Nuclear Waste</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nuclear Waste is a hostile environment from which ion-exchange materials recover toxic and valuable metals.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247038</data>
  <data key="d6"></data>
</node>
<node id="Surface Acido-Basicity">
  <data key="d0">Surface Acido-Basicity</data>
  <data key="d1">concept</data>
  <data key="d2">Surface Acido-Basicity is a property of hydroxyapatite that can be tuned through cationic and anionic substitutions.</data>
