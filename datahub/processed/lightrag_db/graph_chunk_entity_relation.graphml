<node id="Selenite">
  <data key="d0">Selenite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Selenite is the mobile anion of selenium that hydroxyapatite immobilizes through anion exchange with phosphate groups.&lt;SEP&gt;Selenite is a compound used to dope carbonated hydroxyapatite/polycaprolactone core-shell nanofibers.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-013&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-007</data>
