  <data key="d0">Tree-Shaped Gaussian Process</data>
  <data key="d1">method</data>
  <data key="d2">Tree-Shaped Gaussian Process is a computational algorithm employed to conduct the global sensitivity analysis.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792159694</data>
  <data key="d6"></data>
</node>
<node id="Carbon Emission">
  <data key="d0">Carbon Emission</data>
  <data key="d1">data</data>
  <data key="d2">Carbon Emission is a key indicator identified as highly sensitive to the performance of PG recycling technologies.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-011</data>
