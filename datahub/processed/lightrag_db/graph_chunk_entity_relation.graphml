<node id="Emulsion Method">
  <data key="d0">Emulsion Method</data>
  <data key="d1">method</data>
  <data key="d2">Emulsion Method is a one-pot synthesis technique used to create hydroxyapatite-coated gelatin microspheres.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
