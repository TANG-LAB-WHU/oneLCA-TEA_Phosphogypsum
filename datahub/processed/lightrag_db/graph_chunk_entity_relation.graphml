  <data key="d0">Anaerobic Bioremediation</data>
  <data key="d1">method</data>
  <data key="d2">Anaerobic Bioremediation is a treatment process applied to acid phosphogypsum stack leachates to assess biochemical changes and microbial dynamics.</data>
