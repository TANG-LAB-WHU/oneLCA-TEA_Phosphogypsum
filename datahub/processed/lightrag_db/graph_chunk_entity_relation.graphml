<node id="Monteil-Rivera">
  <data key="d0">Monteil-Rivera</data>
  <data key="d1">person</data>
  <data key="d2">Monteil-Rivera confirmed that selenite captured by hydroxyapatite localizes in phosphorus-occupied sites.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-013</data>
  <data key="d4">unknown_source</data>
