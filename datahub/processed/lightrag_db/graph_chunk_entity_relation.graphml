</node>
<node id="Worm-like crystals">
  <data key="d0">Worm-like crystals</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Worm-like crystals are partially connected structures formed when CC aggregates during synthesis.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
</node>
<node id="Hollow spheres">
  <data key="d0">Hollow spheres</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hollow spheres are one of the final HAp product morphologies resulting from CC shape transformation.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
</node>
<node id="Bunched-like microrods">
  <data key="d0">Bunched-like microrods</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Bunched-like microrods are clustered rod structures formed under specific stirring conditions.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
