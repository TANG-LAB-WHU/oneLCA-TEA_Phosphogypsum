<node id="Uranium Isotopes">
  <data key="d0">Uranium Isotopes</data>
  <data key="d1">concept</data>
  <data key="d2">Uranium isotopes are radioactive elements measured in environmental samples and intercomparison runs.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-009</data>
