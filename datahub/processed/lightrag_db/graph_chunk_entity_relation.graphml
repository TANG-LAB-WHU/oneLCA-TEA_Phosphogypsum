<node id="Phosphate Mode">
  <data key="d0">Phosphate Mode</data>
  <data key="d1">concept</data>
  <data key="d2">Phosphate Mode refers to specific molecular vibration modes identified in the FTIR spectrum of hydroxyapatite.</data>
