<node id="Calcium Carbonate-Rich Slag">
  <data key="d0">Calcium Carbonate-Rich Slag</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium carbonate-rich slag is a solid byproduct generated during the mineralization of carbon dioxide in feldspar processing.</data>
