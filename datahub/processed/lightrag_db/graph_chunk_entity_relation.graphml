<node id="Phase Evolution">
  <data key="d0">Phase Evolution</data>
  <data key="d1">concept</data>
  <data key="d2">Phase evolution describes the structural transformation from amorphous calcium phosphate to crystalline hydroxyapatite over time.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791984880</data>
