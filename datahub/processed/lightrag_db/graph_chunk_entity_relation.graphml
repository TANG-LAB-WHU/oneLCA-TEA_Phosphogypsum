<node id="SiO2">
  <data key="d0">SiO2</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Silicon dioxide is a chemical compound present in cement clinker, granulated slag, and phosphogypsum.&lt;SEP&gt;SiO2 is a chemical compound used as an inert carrier material to inhibit grain growth during the CLG process.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-001&lt;SEP&gt;doc-a3152ce135edc56e14c47e05535e05c7-chunk-006</data>
