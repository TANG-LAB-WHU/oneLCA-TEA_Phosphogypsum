  <data key="d1">naturalobject</data>
  <data key="d2">Structural units adjacent to each other and linked with calcium ions to form the crystal lattice of calcium sulfate compounds.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
