  <data key="d0">Morroco Phosphate Rock</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Morroco phosphate rock is the primary source material for phosphogypsum production in India.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-000</data>
