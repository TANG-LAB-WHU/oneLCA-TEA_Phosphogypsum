<node id="Titania-hydroxyapatite Composite">
  <data key="d0">Titania-hydroxyapatite Composite</data>
  <data key="d1">artifact</data>
  <data key="d2">The Titania-hydroxyapatite Composite is a photocatalytic material combining titanium dioxide and hydroxyapatite for enhanced pollutant degradation.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-019</data>
  <data key="d4">unknown_source</data>
