</node>
<node id="Chinese Standard JC/T 422e2007">
  <data key="d0">Chinese Standard JC/T 422e2007</data>
  <data key="d1">content</data>
  <data key="d2">Chinese Standard JC/T 422e2007 defines the minimum strength requirements for unfired MU20-grade bricks.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-013</data>
