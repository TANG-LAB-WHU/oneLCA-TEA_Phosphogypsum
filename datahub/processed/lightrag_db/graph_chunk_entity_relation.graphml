  <data key="d0">Biphasic Calcium Phosphate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Biphasic calcium phosphate is a material prepared from phosphogypsum waste.&lt;SEP&gt;Biphasic calcium phosphate is a material prepared from phosphogypsum waste.&lt;SEP&gt;Biphasic calcium phosphate is a material prepared from phosphogypsum waste.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-010&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-010&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-010</data>
