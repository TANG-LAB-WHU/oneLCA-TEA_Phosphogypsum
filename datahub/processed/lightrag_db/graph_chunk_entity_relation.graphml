<node id="Yao">
  <data key="d0">Yao</data>
  <data key="d1">person</data>
  <data key="d2">Yao is a researcher who demonstrated that titanium dioxide-hydroxyapatite composites show superior photocatalytic activity for nitric oxide removal.&lt;SEP&gt;Yao is a researcher who published findings on the photocatalytic mechanism of the titania-hydroxyapatite composite in 2017.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-018&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-019</data>
