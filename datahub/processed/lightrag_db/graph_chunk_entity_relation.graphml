<node id="Rare Earth Element Purification and Separation">
  <data key="d0">Rare Earth Element Purification and Separation</data>
  <data key="d1">method</data>
  <data key="d2">This method uses special adsorption materials to purify and separate rare earth elements from the leachate.&lt;SEP&gt;This method uses special adsorption materials to purify and separate rare earth elements from the leachate.&lt;SEP&gt;This method uses special adsorption materials to purify and separate rare earth elements from the leachate.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-010&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-010&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-010</data>
