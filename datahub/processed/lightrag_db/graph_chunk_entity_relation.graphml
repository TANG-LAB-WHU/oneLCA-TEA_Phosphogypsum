  <data key="d5">1790983967</data>
  <data key="d6"></data>
</node>
<node id="Hydrometallurgical Parameters">
  <data key="d0">Hydrometallurgical Parameters</data>
  <data key="d1">concept</data>
  <data key="d2">Parameters such as concentration, agitation speed, and contact time that control the solubilization of quartz.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790983967</data>
  <data key="d6"></data>
</node>
<node id="Slurry">
  <data key="d0">Slurry</data>
  <data key="d1">other</data>
  <data key="d2">A mixture of hydrofluoric acid and treated solid (WBS) agitated during the hydrometallurgical treatment.&lt;SEP&gt;Slurry is the mixture of Phosphogypsum and leachant during the leaching process, noted for its energy-intensive heating requirements.&lt;SEP&gt;Slurry is the physical state of phosphogypsum before it undergoes dewatering.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-003&lt;SEP&gt;doc-401b567da916dc34559e0bfe5a5b367b-chunk-005&lt;SEP&gt;doc-276f29345df37143fc224a22d0f6089b-chunk-017</data>
