<node id="Ref. [19]">
  <data key="d0">Ref. [19]</data>
  <data key="d1">content</data>
  <data key="d2">Ref. [19] is a reference document specifying the testing methods for gypsum plaster physical properties.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-002</data>
