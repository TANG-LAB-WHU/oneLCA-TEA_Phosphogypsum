<node id="Phosphogypsum (Igneous)">
  <data key="d0">Phosphogypsum (Igneous)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Phosphogypsum produced from igneous rock phosphate, which may exhibit Th-232 activities exceeding those of Ra-226.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
