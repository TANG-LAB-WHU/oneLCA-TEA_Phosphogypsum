</node>
<node id="Cuticle">
  <data key="d0">Cuticle</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The cuticle is a plant surface layer through which small amounts of fluoride can directly enter leaves.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791023386</data>
  <data key="d6"></data>
</node>
<node id="Stomata">
  <data key="d0">Stomata</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Stomata are plant pores through which small amounts of fluoride can directly enter leaves.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791023386</data>
  <data key="d6"></data>
</node>
<node id="Gaseous HF">
  <data key="d0">Gaseous HF</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gaseous HF is an atmospherically emitted form of fluoride that can directly enter plant leaves.</data>
