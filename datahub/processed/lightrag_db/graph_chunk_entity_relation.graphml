</node>
<node id="Na EDTA">
  <data key="d0">Na EDTA</data>
  <data key="d1">artifact</data>
  <data key="d2">Na EDTA is a chemical agent used in the alkaline treatment of Phosphogypsum to solubilize calcium sulfate dihydrate.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-006</data>
