<edge source="Phosphogypsum" target="Setting time">
  <data key="d7">1.0</data>
  <data key="d8">Phosphogypsum significantly extends the setting time of cementitious materials due to its retarder impact.</data>
  <data key="d9">duration extension,retardation</data>
