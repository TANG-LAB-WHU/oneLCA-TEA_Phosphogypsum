</node>
<node id="M. Amrani">
  <data key="d0">M. Amrani</data>
  <data key="d1">person</data>
  <data key="d2">A researcher associated with studies on phosphogypsum utilization and environmental management.&lt;SEP&gt;M. Amrani is a researcher who explored phosphogypsum recycling for sustainable road material applications.</data>
