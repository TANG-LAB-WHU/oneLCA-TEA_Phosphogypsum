<node id="Calcium phosphate">
  <data key="d0">Calcium phosphate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium phosphate is a compound formed as a protective coating on cement grains due to phosphogypsum impurities.&lt;SEP&gt;Calcium phosphate forms inactive protective coats on cement particle surfaces, contributing to extended setting times.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-005&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-017</data>
