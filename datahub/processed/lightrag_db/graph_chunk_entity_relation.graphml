  <data key="d6"></data>
</node>
<node id="Radiochemical Recovery">
  <data key="d0">Radiochemical Recovery</data>
  <data key="d1">concept</data>
  <data key="d2">Radiochemical recovery is a metric indicating the efficiency of the applied analytical procedure, found to be approximately 70-8%.</data>
