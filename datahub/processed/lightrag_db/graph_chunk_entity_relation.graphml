  <data key="d0">5% Series</data>
  <data key="d1">data</data>
  <data key="d2">A data series representing a 5% additive condition, showing a moderate dissolution rate.</data>
  <data key="d3">doc-7797768798fcd1152bdc10ff73139e35-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791516319</data>
  <data key="d6"></data>
</node>
<node id="7% Series">
  <data key="d0">7% Series</data>
  <data key="d1">data</data>
  <data key="d2">A data series representing a 7% additive condition, showing the lowest dissolution rate.</data>
  <data key="d3">doc-7797768798fcd1152bdc10ff73139e35-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791516319</data>
  <data key="d6"></data>
</node>
<node id="9% Series">
  <data key="d0">9% Series</data>
  <data key="d1">data</data>
