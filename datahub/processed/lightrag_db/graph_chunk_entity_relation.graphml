  <data key="d1">naturalobject</data>
  <data key="d2">Kovdor apatite is a high-quality ore deposit from Russia used for phosphogypsum production.&lt;SEP&gt;Kovdor apatite is a high-quality ore deposit from Russia used for phosphogypsum production.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-002&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-002</data>
