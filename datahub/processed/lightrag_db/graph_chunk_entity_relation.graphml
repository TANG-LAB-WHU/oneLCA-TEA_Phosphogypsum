<node id="Purified Phosphogypsum">
  <data key="d0">Purified Phosphogypsum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Purified phosphogypsum is a processed gypsum alternative tested in Portland slag cement and gypsum plaster formulations.&lt;SEP&gt;Purified Phosphogypsum is phosphogypsum treated with aqueous citric acid and washed to remove impurities, resulting in improved physical properties.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-007&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-006</data>
