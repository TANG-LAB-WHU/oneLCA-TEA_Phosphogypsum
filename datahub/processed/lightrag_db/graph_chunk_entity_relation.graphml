  <data key="d1">concept</data>
  <data key="d2">Smog is an environmental problem originating from nitric oxides produced during fuel combustion processes.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-018</data>
  <data key="d4">unknown_source</data>
