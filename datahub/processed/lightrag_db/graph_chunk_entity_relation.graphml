  <data key="d6"></data>
</node>
<node id="Dash et al.">
  <data key="d0">Dash et al.</data>
  <data key="d1">person</data>
  <data key="d2">Researchers who demonstrated that calcium fluoride crystallization typically occurs at 900 °C.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984452</data>
