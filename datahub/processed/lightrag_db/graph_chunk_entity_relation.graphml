  <data key="d6"></data>
</node>
<node id="Saueia Et Al., 2005">
  <data key="d0">Saueia Et Al., 2005</data>
  <data key="d1">content</data>
  <data key="d2">Saueia Et Al., 2005 is a scientific reference providing literature values for uranium and radium activity concentrations.</data>
