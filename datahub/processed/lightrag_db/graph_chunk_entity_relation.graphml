  <data key="d5">1791247343</data>
  <data key="d6"></data>
</node>
<node id="Lewis Acid Sites">
  <data key="d0">Lewis Acid Sites</data>
  <data key="d1">concept</data>
  <data key="d2">Lewis Acid Sites are a type of acid site in hydroxyapatite resulting from Ca 2+ or OH- vacancies.&lt;SEP&gt;Lewis Acid Sites are surface locations on apatites where probe molecules adsorb.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-004&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-006</data>
