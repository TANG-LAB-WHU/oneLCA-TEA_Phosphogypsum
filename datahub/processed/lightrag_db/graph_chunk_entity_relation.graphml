<node id="280 °C">
  <data key="d0">280 °C</data>
  <data key="d1">data</data>
  <data key="d2">280 °C is a specific temperature threshold where water loss differences between pellet and powdery samples are observed.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-002</data>
