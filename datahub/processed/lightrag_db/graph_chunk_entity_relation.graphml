  <data key="d6"></data>
</node>
<node id="Modified Proctor Test">
  <data key="d0">Modified Proctor Test</data>
  <data key="d1">method</data>
  <data key="d2">A geotechnical testing procedure used to determine the maximum dry unit weight and optimum moisture content of soil materials.&lt;SEP&gt;A geotechnical procedure used to determine maximum dry density and optimum moisture content of soil mixes.&lt;SEP&gt;A compaction test method utilizing higher energy to achieve greater maximum dry density and lower optimum moisture content.&lt;SEP&gt;Modified Proctor test is a standard procedure for determining soil compaction characteristics, yielding WopM and PdP values.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-009&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-004&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-012&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791938112</data>
  <data key="d6"></data>
</node>
