<node id="Retarder Agent">
  <data key="d0">Retarder Agent</data>
  <data key="d1">artifact</data>
  <data key="d2">Retarder agents are chemical admixtures used to delay cement setting, which PG can potentially replace.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-018</data>
