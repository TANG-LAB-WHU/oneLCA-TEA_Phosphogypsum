  <data key="d0">Dust Pollution</data>
  <data key="d1">concept</data>
  <data key="d2">Dust pollution is an atmospheric hazard associated with Phosphogypsum storage and handling.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-025</data>
  <data key="d4">unknown_source</data>
