</node>
<node id="Hollow Spheres">
  <data key="d0">Hollow Spheres</data>
  <data key="d1">artifact</data>
  <data key="d2">Hollow spheres are one of the final hydroxyapatite product morphologies resulting from sphere-like colloid transformation.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-000</data>
