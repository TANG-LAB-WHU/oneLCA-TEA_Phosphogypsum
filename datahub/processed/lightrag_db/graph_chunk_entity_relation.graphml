</node>
<node id="Hematite">
  <data key="d0">Hematite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A mineral phase whose proportion decreases as the percentage of Phosphogypsum in the brick samples increases.&lt;SEP&gt;Hematite is a mineral phase identified in phosphogypsum samples from an abandoned fertilizer industry.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-015&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-004</data>
