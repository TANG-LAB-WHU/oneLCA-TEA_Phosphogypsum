  <data key="d0">Bayer Red Mud</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Bayer red mud is an industrial waste evaluated alongside phosphogypsum for use in cement-stabilized soil.&lt;SEP&gt;An industrial waste material investigated alongside phosphogypsum for developing non-calcined cementitious binders.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-022&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-029</data>
