  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="Impure Phosphogypsum">
  <data key="d0">Impure Phosphogypsum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Impure phosphogypsum is a type of gypsum evaluated for use in Portland slag cement and gypsum plaster.</data>
