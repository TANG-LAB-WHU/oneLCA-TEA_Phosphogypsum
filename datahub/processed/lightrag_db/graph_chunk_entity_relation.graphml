<node id="Level 2">
  <data key="d0">Level 2</data>
  <data key="d1">data</data>
  <data key="d2">The intermediate quality grade for phosphogypsum, with moderate limits on sodium oxide and chloride ions.&lt;SEP&gt;Level 2 represents the intermediate purity grade for phosphogypsum, with moderate chemical limits.</data>
  <data key="d3">doc-76e07d75a9f5124d07b9dafa2dacfba7-chunk-002&lt;SEP&gt;doc-76e07d75a9f5124d07b9dafa2dacfba7-chunk-001</data>
