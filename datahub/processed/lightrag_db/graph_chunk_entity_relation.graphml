  <data key="d5">1791674043</data>
  <data key="d6"></data>
</node>
<node id="Hazardous Contaminants">
  <data key="d0">Hazardous Contaminants</data>
  <data key="d1">concept</data>
  <data key="d2">Hazardous contaminants are negative impacts that calcination can potentially mitigate.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791366062</data>
