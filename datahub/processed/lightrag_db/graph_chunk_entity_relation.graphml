</node>
<node id="Sedimentary Phosphorites">
  <data key="d0">Sedimentary Phosphorites</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sedimentary phosphorites are the geological source material used to produce phosphogypsum.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Uranium Mine Waste">
  <data key="d0">Uranium Mine Waste</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Uranium mine waste is the anaerobic environment where laboratory incubations measured dissolved Ra-226 levels.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Adsorption Sites">
  <data key="d0">Adsorption Sites</data>
  <data key="d1">concept</data>
  <data key="d2">Adsorption sites are locations on mineral surfaces where ions like Ra-226 bind, influencing their retention in groundwater.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Half-Life">
  <data key="d0">Half-Life</data>
  <data key="d1">concept</data>
  <data key="d2">Half-life is the time required for a radioactive substance to decay to half its initial amount, noted as 3.82 days for Radon-222.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Partition Coefficient">
  <data key="d0">Partition Coefficient</data>
  <data key="d1">concept</data>
  <data key="d2">Partition coefficient quantifies the distribution of a substance between two phases, measured as 0.35 for Radon-222 between water and air.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Roess">
  <data key="d0">Roess</data>
  <data key="d1">person</data>
  <data key="d2">Roess is a researcher who documented the Radon-222 emanation coefficient in phosphogypsum.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Air">
  <data key="d0">Air</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Air is a medium where ejected Th-234 atoms accumulate during radioactive decay processes.&lt;SEP&gt;Air is the gaseous phase in the partition coefficient measurement for Radon-222 solubility.&lt;SEP&gt;The surrounding fluid medium through which natural convection and heat transfer occur around phosphogypsum.&lt;SEP&gt;Air is an environmental medium contaminated by impurities leaching from phosphogypsum.&lt;SEP&gt;Air is the medium used to quickly cool the samples after the melting process.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-012&lt;SEP&gt;doc-98d8b2df45924e721bfa570f652f33e3-chunk-007&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-004&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792098751</data>
  <data key="d6"></data>
</node>
<node id="Quality Factor Q">
  <data key="d0">Quality Factor Q</data>
  <data key="d1">concept</data>
  <data key="d2">A parameter indicating radiation quality, small for gamma radiation and X-rays, intermediate for neutrons, and high for alpha particles.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="X-Rays">
  <data key="d0">X-Rays</data>
  <data key="d1">concept</data>
  <data key="d2">A type of radiation with a small quality factor similar to gamma radiation.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Neutrons">
  <data key="d0">Neutrons</data>
  <data key="d1">concept</data>
  <data key="d2">A type of radiation with an intermediate quality factor of 5.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Alpha Particles">
  <data key="d0">Alpha Particles</data>
  <data key="d1">concept</data>
  <data key="d2">A type of radiation with a high quality factor of 20.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="NCRP">
  <data key="d0">NCRP</data>
  <data key="d1">organization</data>
  <data key="d2">An organization that issued recommendations for public continuous exposure limits to gamma radiation.&lt;SEP&gt;The NCRP established annual dose limits for the general public and remedial action levels for radon exposure related to phosphogypsum.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-028</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Effective Dose Equivalent">
  <data key="d0">Effective Dose Equivalent</data>
  <data key="d1">concept</data>
  <data key="d2">A measure of total individual risk calculated by summing the dose equivalents of all organs in the body.&lt;SEP&gt;A calculated radiation exposure metric used to assess health hazards from radionuclide consumption.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-031</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Sievert">
  <data key="d0">Sievert</data>
  <data key="d1">data</data>
  <data key="d2">A unit of measurement used for both dose equivalent and effective dose equivalent.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
  <data key="d6"></data>
</node>
<node id="Natural Background Radiation">
  <data key="d0">Natural Background Radiation</data>
