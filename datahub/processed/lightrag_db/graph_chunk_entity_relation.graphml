  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Root Zone">
  <data key="d0">Root Zone</data>
  <data key="d1">location</data>
  <data key="d2">The root zone is the soil layer where Radium-226 is subject to annual loss through erosion or leaching.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-032</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="General Public">
  <data key="d0">General Public</data>
  <data key="d1">person</data>
  <data key="d2">The general public is the demographic group for whom the NCRP establishes continuous radiation exposure recommendations.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-032</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Basements">
  <data key="d0">Basements</data>
  <data key="d1">location</data>
  <data key="d2">Basements are residential areas where radon risk from contaminated soil poses a potential health concern.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-032</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Federal Concentration Limit">
  <data key="d0">Federal Concentration Limit</data>
  <data key="d1">concept</data>
  <data key="d2">The federal concentration limit is a regulatory threshold for soil radioactivity that determines suitability for residential construction.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-032</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Concentration Ratio">
  <data key="d0">Concentration Ratio</data>
  <data key="d1">concept</data>
  <data key="d2">The concentration ratio measures the proportion of radium in dry foodstuff relative to radium in soil.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-032</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Typical Dietary Uptake">
  <data key="d0">Typical Dietary Uptake</data>
  <data key="d1">data</data>
  <data key="d2">Typical dietary uptake represents the baseline radiation intake from diet, serving as a comparison for phosphogypsum-treated land exposure.</data>
