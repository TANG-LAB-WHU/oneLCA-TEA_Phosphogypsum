</node>
<node id="Luther and Dudas">
  <data key="d0">Luther and Dudas</data>
  <data key="d1">person</data>
  <data key="d2">Researchers who suggested that sulfate and phosphate minerals are likely chemical forms for trace elements in phosphogypsum.</data>
