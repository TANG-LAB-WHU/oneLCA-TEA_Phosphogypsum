<node id="Minimum Detectable Activity">
  <data key="d0">Minimum Detectable Activity</data>
  <data key="d1">data</data>
  <data key="d2">Calculated metric representing the lowest detectable radionuclide concentration, determined using Currie's equation.&lt;SEP&gt;Minimum Detectable Activity is a detection parameter calculated for the experimental geometry and counting time, found below real radionuclide concentrations.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-001&lt;SEP&gt;doc-70650e5cb032fce744763706d8701e36-chunk-004</data>
