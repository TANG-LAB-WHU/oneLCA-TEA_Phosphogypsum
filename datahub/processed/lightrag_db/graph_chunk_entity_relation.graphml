  <data key="d0">BMP-7</data>
  <data key="d1">naturalobject</data>
  <data key="d2">BMP-7 is a protein whose adsorption mechanism on hydroxyapatite surfaces was investigated.&lt;SEP&gt;BMP-7 is a substance whose adsorption mechanism on hydroxyapatite surfaces was investigated in a 2007 study.</data>
