<node id="Artificial Aggregate">
  <data key="d0">Artificial Aggregate</data>
  <data key="d1">artifact</data>
  <data key="d2">Artificial aggregates incorporate high percentages of phosphogypsum to replace natural aggregates in asphalt mixtures and pavement bases.</data>
