  <data key="d0">Independent Rare Earth Elements Mineral Inclusions</data>
  <data key="d1">concept</data>
  <data key="d2">Independent rare earth elements mineral inclusions are discrete mineral particles containing rare earth elements embedded within the phosphogypsum matrix.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791038121</data>
  <data key="d6"></data>
