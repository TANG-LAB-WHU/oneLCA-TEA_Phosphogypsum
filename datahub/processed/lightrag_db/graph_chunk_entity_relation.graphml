<node id="Energy Spectrum Analysis">
  <data key="d0">Energy Spectrum Analysis</data>
  <data key="d1">method</data>
  <data key="d2">Energy Spectrum Analysis is an analytical technique used alongside SEM to identify internal hydration products.</data>
