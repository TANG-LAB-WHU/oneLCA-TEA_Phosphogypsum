  <data key="d0">Lee et al.</data>
  <data key="d1">person</data>
  <data key="d2">Lee et al. are researchers who demonstrated the preparation of hydroxyapatite from waste oyster shells for heavy metal sorption.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-010</data>
