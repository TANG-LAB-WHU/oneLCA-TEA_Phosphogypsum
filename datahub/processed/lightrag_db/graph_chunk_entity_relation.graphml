  <data key="d5">1792362494</data>
  <data key="d6"></data>
</node>
<node id="Kinetic Model">
  <data key="d0">Kinetic Model</data>
  <data key="d1">concept</data>
  <data key="d2">Kinetic Model represents the mathematical equation describing the rate of phosphogypsum decomposition.&lt;SEP&gt;Kinetic Model is proposed to validate the reaction mechanism and kinetic analysis.</data>
  <data key="d3">doc-d5e4f0f96b4ad61d23685552d3211225-chunk-000&lt;SEP&gt;doc-d5e4f0f96b4ad61d23685552d3211225-chunk-001</data>
