  <data key="d11">unknown_source</data>
  <data key="d12">1791367225</data>
  <data key="d13"></data>
</edge>
<edge source="Phosphogypsum" target="Public Health">
  <data key="d7">1.0</data>
  <data key="d8">The accumulation of phosphogypsum poses severe threats to public health due to hazardous pollutants like cadmium and mercury.</data>
