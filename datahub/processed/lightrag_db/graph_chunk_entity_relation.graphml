</node>
<node id="Microelements">
  <data key="d0">Microelements</data>
  <data key="d1">concept</data>
  <data key="d2">Microelements are trace elements in soil solution, including heavy metals, whose equilibrium is calculated.&lt;SEP&gt;Microelements are trace elements in soil solution, including heavy metals, whose equilibrium is calculated.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-000&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-000</data>
