  <data key="d0">Calculation Step 3 Conversion</data>
  <data key="d1">method</data>
  <data key="d2">A procedural step that multiplies a fraction by 100% to convert it into a percentage.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-018</data>
