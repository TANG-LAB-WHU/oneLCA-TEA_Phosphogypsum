  <data key="d1">data</data>
  <data key="d2">Total Utility Value is a calculated metric representing the overall utility of solid waste recycling technologies across multiple criteria.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792160084</data>
  <data key="d6"></data>
</node>
<node id="Risk Attitudes">
  <data key="d0">Risk Attitudes</data>
  <data key="d1">concept</data>
  <data key="d2">Risk Attitudes represent the varying preferences and sensitivities of decision-makers toward gains and losses in the decision-making process.</data>
