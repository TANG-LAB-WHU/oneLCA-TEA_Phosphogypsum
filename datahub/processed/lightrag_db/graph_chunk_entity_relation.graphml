</node>
<node id="Treatment Process">
  <data key="d0">Treatment Process</data>
  <data key="d1">method</data>
  <data key="d2">Treatment process involves removing contaminants from PG to reduce its retarder effect and accelerate setting time.&lt;SEP&gt;Treatment Process is an operational stage where enhanced protection for workers' hands and faces is required.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-018&lt;SEP&gt;doc-ad247a75dda6243453b4132b71670203-chunk-023</data>
