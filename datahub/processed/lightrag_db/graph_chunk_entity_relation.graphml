<node id="Circulating Fluidized Bed Fly Ash">
  <data key="d0">Circulating Fluidized Bed Fly Ash</data>
  <data key="d1">naturalobject</data>
  <data key="d2">An industrial byproduct used alongside carbide slag to modify phosphogypsum for use as a cement retarder.&lt;SEP&gt;A supplementary material used to modify phosphogypsum for application as a cement retarder.&lt;SEP&gt;Circulating fluidized bed fly ash is an industrial byproduct used to modify phosphogypsum for cement applications.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-014&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-029&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-015</data>
