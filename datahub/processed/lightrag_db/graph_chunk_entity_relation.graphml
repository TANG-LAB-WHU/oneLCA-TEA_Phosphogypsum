  <data key="d5">1791773399</data>
  <data key="d6"></data>
</node>
<node id="Positive Flotation">
  <data key="d0">Positive Flotation</data>
  <data key="d1">method</data>
  <data key="d2">Positive flotation is a technique applied alongside roughing reverse flotation to optimize phosphogypsum treatment.&lt;SEP&gt;Positive flotation is a separation technique used alongside roughing reverse flotation to enhance phosphogypsum purity, yield, and whiteness.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-008&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791773399</data>
  <data key="d6"></data>
</node>
<node id="Eutectic Phosphorus Impurities">
  <data key="d0">Eutectic Phosphorus Impurities</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Eutectic phosphorus impurities are a type of phosphorus compound in phosphogypsum that lime neutralization cannot effectively remove.</data>
  <data key="d3">doc-b0ac8d630b9aa4d874707445e2552a09-chunk-008</data>
