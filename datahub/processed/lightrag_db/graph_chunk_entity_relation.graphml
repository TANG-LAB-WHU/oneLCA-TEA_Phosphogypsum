  <data key="d0">Normal Consistency</data>
  <data key="d1">data</data>
  <data key="d2">Normal Consistency is a physical property of gypsum plaster that decreases when produced from purified phosphogypsum.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-007</data>
  <data key="d4">unknown_source</data>
