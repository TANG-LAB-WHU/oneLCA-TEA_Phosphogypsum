</node>
<node id="Wastewater Treatment System">
  <data key="d0">Wastewater Treatment System</data>
  <data key="d1">artifact</data>
  <data key="d2">Wastewater treatment systems process human waste and detergents, separating phosphorus into effluent and biosolids.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-007</data>
  <data key="d4">unknown_source</data>
