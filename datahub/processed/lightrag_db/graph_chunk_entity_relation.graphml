<node id="Company I">
  <data key="d0">Company I</data>
  <data key="d1">organization</data>
  <data key="d2">Company I is a Guizhou-based enterprise that harnesses phosphogypsum to generate sulfuric acid and allocates portions for fertilizer production.&lt;SEP&gt;Company I is a firm engaged in PG production and recycling, located in Qiannan, Guizhou.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-004&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-011</data>
