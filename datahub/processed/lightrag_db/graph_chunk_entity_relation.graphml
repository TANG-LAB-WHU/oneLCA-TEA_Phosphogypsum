19&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-010&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-000&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-014&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-006&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-018&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-018&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-009&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-019&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-018&lt;SEP&gt;doc-e992f3bad9db87c40308ea55e121bd8a-chunk-015&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-002&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-037&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-003&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-019&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-024</data>
