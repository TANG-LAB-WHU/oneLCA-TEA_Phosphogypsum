  <data key="d0">Ca2+ ions</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ca2+ ions are calcium ions that selectively coordinate with NTA during HAP preparation.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791470403</data>
  <data key="d6"></data>
