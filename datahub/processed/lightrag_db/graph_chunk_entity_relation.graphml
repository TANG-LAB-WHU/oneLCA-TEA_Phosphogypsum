  <data key="d0">Water Bath</data>
  <data key="d1">artifact</data>
  <data key="d2">Water Bath is an experimental apparatus used to maintain SBF solution at a constant temperature of 37°C during sample immersion.&lt;SEP&gt;A water bath is a heating apparatus used to maintain constant temperature during the reaction.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-013&lt;SEP&gt;doc-4739e42903c95e1fb7e0ecfbca3a12df-chunk-002</data>
