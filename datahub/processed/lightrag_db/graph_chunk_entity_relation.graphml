  <data key="d0">Molecular Vibrations</data>
  <data key="d1">concept</data>
  <data key="d2">Chemical bond movements identified at specific wavenumbers during infrared spectroscopy analysis.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-016</data>
