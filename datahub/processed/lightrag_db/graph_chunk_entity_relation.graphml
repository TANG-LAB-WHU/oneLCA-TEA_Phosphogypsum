<node id="Phosphoric Acid Residue">
  <data key="d0">Phosphoric Acid Residue</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Phosphoric Acid Residue refers to P–OH bonds remaining in PG waste, identified via infrared spectroscopy.&lt;SEP&gt;Phosphoric Acid Residue is a material likely represented by the sample label "PR".&lt;SEP&gt;Phosphoric acid residue is identified in the phosphogypsum waste through P-OH stretching vibrations.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-003&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-012&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-003</data>
