<node id="Polyethylene Oxide">
  <data key="d0">Polyethylene Oxide</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Polyethylene Oxide serves as the hydrophilic block of the P123 Surfactant that faces outward due to strong water attraction.</data>
