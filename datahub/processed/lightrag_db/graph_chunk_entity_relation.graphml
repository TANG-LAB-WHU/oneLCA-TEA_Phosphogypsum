  <data key="d1">method</data>
  <data key="d2">Two-Step Hydration Method is a manufacturing process for finished unfired PG bricks that results in a uniform, compact microstructure.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-016</data>
  <data key="d4">unknown_source</data>
