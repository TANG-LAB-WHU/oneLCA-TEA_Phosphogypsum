<node id="Atmospheric Deposition">
  <data key="d0">Atmospheric Deposition</data>
  <data key="d1">concept</data>
  <data key="d2">Atmospheric deposition is a pathway through which fluorides and other contaminants enter the soil and surrounding areas.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791023386</data>
