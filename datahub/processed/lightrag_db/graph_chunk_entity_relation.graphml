<node id="Calcium Sulfate II">
  <data key="d0">Calcium Sulfate II</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium sulfate II is an intermediate phase formed during the exothermic transformation of calcium sulfate III.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791498992</data>
  <data key="d6"></data>
