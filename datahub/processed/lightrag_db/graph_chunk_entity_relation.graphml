  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
  <data key="d6"></data>
</node>
<node id="LnK_F">
  <data key="d0">LnK_F</data>
  <data key="d1">data</data>
  <data key="d2">The natural logarithm of the Freundlich constant, indicating adsorption capacity.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
  <data key="d6"></data>
</node>
<node id="LnC_e">
  <data key="d0">LnC_e</data>
  <data key="d1">data</data>
  <data key="d2">The natural logarithm of the equilibrium concentration of the adsorbate in the solution.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
