08&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-000&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-002&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-002&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-001&lt;SEP&gt;doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-013&lt;SEP&gt;doc-ad247a75dda6243453b4132b71670203-chunk-001&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-013&lt;SEP&gt;doc-525daf613910500054a23427717dab1f-chunk-020</data>
