<node id="Ammonium Group">
  <data key="d0">Ammonium Group</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ammonium Group is a chemical component of ammonium sulfate, showing deformation and stretch absorption bands.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Pyrophosphate Group">
  <data key="d0">Pyrophosphate Group</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pyrophosphate Group is a chemical moiety detected via FTIR analysis, attributed to an absorption band after HAP treatment.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Calcium-Deficient HAP">
  <data key="d0">Calcium-Deficient HAP</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium-Deficient HAP is a variant of HAP where hydrogen phosphate condensation occurs at temperatures below 1000°C.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
