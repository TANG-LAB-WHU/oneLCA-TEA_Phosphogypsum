  <data key="d0">Calcium carbonate equilibrium</data>
  <data key="d1">concept</data>
  <data key="d2">Calcium carbonate equilibrium is a key chemical process in soil solution that influences ion transformation and cadmium transfer.&lt;SEP&gt;Calcium carbonate equilibrium is a key chemical process in soil solution that influences ion transformation and cadmium transfer.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-002&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-002</data>
