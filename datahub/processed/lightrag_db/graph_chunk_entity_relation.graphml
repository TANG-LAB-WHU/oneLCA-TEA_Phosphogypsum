<node id="PbS">
  <data key="d0">PbS</data>
  <data key="d1">naturalobject</data>
  <data key="d2">PbS is a precipitate formed by lead under reduced conditions.&lt;SEP&gt;PbS is an insoluble compound formed when lead precipitates under reduced environmental conditions.</data>
