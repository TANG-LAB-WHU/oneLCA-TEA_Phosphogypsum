<node id="Chlorobenzene">
  <data key="d0">Chlorobenzene</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Chlorobenzene is an organic compound that is oxidatively decomposed over calcium deficient hydroxyapatite, with chlorine being captured by the catalyst.&lt;SEP&gt;Chlorobenzene is a chemical compound used in reaction experiments with Hydroxyapatite to measure chlorination amounts under controlled conditions.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-017&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-016</data>
