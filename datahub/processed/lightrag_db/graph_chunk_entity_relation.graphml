<node id="Crystal Coarsening">
  <data key="d0">Crystal Coarsening</data>
  <data key="d1">concept</data>
  <data key="d2">Crystal coarsening is a structural defect in hydration products caused by soluble fluorine impurities exceeding 0.3%.</data>
