<node id="Solid-Phase Extraction">
  <data key="d0">Solid-Phase Extraction</data>
  <data key="d1">method</data>
  <data key="d2">Solid-phase extraction is a separation technique applied to isolate compounds like uranium from solvent systems.</data>
  <data key="d3">doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-010</data>
