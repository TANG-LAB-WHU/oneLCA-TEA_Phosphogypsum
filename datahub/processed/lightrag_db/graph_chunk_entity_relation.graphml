<node id="100 °C">
  <data key="d0">100 °C</data>
  <data key="d1">data</data>
  <data key="d2">100 °C is the temperature threshold below which Hydroxyapatite exhibits low stability and crystallinity.&lt;SEP&gt;100 °C is a synthesis temperature at which nanocrystalline hydroxyapatite forms alongside impurity phases.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-006&lt;SEP&gt;doc-6825862084b162a4b16cd1037c76e3d7-chunk-003</data>
