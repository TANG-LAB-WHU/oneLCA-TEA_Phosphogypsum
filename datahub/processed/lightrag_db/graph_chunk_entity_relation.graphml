  <data key="d1">data</data>
  <data key="d2">16 Hours is an insufficient duration for hydrothermal deposition, resulting in no observed precipitation.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791470547</data>
