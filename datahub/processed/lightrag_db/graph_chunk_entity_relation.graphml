</node>
<node id="Hydroxyapatite Nanorods">
  <data key="d0">Hydroxyapatite Nanorods</data>
  <data key="d1">artifact</data>
  <data key="d2">Hydroxyapatite nanorods are rod-shaped nanostructures synthesized under microwave or hydrothermal conditions.&lt;SEP&gt;Hydroxyapatite nanorods are nanostructures synthesized for use in bone tissue engineering.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-012&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-020</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792189983</data>
  <data key="d6"></data>
</node>
<node id="Nta">
  <data key="d0">Nta</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A chelating agent used to control Hydroxyapatite crystal growth and morphology during synthesis.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791470547</data>
  <data key="d6"></data>
</node>
<node id="Attenuated Total Reflectance">
