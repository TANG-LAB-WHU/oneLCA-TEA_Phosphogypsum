  <data key="d0">Half-Life</data>
  <data key="d1">concept</data>
  <data key="d2">Half-life is the time required for a radioactive substance to decay to half its initial amount, noted as 3.82 days for Radon-222.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188835</data>
