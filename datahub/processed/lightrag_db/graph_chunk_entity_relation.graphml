<node id="Nanobiomaterials">
  <data key="d0">Nanobiomaterials</data>
  <data key="d1">concept</data>
  <data key="d2">Nanobiomaterials represent the interdisciplinary field combining nanotechnology and biomaterials, focusing on applications like hydroxyapatite.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-012</data>
  <data key="d4">unknown_source</data>
