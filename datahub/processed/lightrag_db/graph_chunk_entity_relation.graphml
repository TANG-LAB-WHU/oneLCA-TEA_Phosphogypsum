<node id="Bihydrated">
  <data key="d0">Bihydrated</data>
  <data key="d1">concept</data>
  <data key="d2">Bihydrated refers to a chemical state with two water molecules, which the sample was proven not to possess.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-007</data>
