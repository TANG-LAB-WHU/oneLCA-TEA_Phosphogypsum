<node id="Hysteresis Loop">
  <data key="d0">Hysteresis Loop</data>
  <data key="d1">concept</data>
  <data key="d2">A phenomenon where adsorption and desorption curves do not overlap, indicating mesopores.&lt;SEP&gt;A distinct loop between adsorption and desorption curves indicating irreversible processes in the HAp sample.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-017&lt;SEP&gt;doc-f1fb5c243f2539cf7be6b6021b63c36f-chunk-005</data>
