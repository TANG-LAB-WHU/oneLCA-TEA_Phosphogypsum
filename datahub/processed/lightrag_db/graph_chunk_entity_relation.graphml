  <data key="d10">doc-3fd8439e859e3dd0c96328384e1761f0-chunk-010&lt;SEP&gt;doc-3fd8439e859e3dd0c96328384e1761f0-chunk-004&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-024&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-004&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-010&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-023</data>
