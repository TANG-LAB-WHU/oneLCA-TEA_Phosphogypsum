  <data key="d5">1792223242</data>
  <data key="d6"></data>
</node>
<node id="Natural Drying">
  <data key="d0">Natural Drying</data>
  <data key="d1">method</data>
  <data key="d2">Natural Drying is a dehydration process that solidifies the molded gypsum blocks.&lt;SEP&gt;Natural drying is a processing step applied to molded gypsum blocks to remove moisture.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-031&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792223242</data>
  <data key="d6"></data>
