  <data key="d0">Aquatic Life</data>
  <data key="d1">creature</data>
  <data key="d2">Aquatic life is negatively impacted and killed by water eutrophication caused by phosphogypsum runoff.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-001</data>
