<node id="2D Flaky Structures">
  <data key="d0">2D Flaky Structures</data>
  <data key="d1">artifact</data>
  <data key="d2">2D Flaky Structures are flaky crystal structures of Hydroxyapatite that combine with nanorods under specific surfactant conditions.</data>
