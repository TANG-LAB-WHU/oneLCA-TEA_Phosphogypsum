<node id="Milling Techniques">
  <data key="d0">Milling Techniques</data>
  <data key="d1">method</data>
  <data key="d2">Milling techniques are mechanical processing methods investigated to modify particle size without altering hydroxyapatite stoichiometry.</data>
  <data key="d3">doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792425962</data>
