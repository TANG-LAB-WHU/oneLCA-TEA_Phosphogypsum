  <data key="d0">Nilsson et al.</data>
  <data key="d1">person</data>
  <data key="d2">Nilsson et al. are researchers who reported the osteoconductive and injectable properties of hydroxyapatite and calcium sulfate combinations.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061334</data>
