  <data key="d0">Natural Selenite Gypsum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Natural selenite gypsum is a reference material compared against phosphogypsum to demonstrate the greater property reduction caused by the latter.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="Differential Thermal Analysis">
  <data key="d0">Differential Thermal Analysis</data>
  <data key="d1">method</data>
  <data key="d2">Differential thermal analysis is a testing method used to evaluate the properties of phosphogypsum with and without treatment.&lt;SEP&gt;Differential thermal analysis is a technique used to confirm impurity removal by measuring changes in the inversion temperatures of exotherms.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="DA">
  <data key="d0">DA</data>
  <data key="d1">other</data>
  <data key="d2">A specific phosphogypsum sample code characterized by higher impurity levels compared to HDS.&lt;SEP&gt;DA is a specific design or sample of phosphogypsum used in the study, requiring 4.0% citric acid for optimal purification.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="HDS">
  <data key="d0">HDS</data>
  <data key="d1">other</data>
  <data key="d2">A specific phosphogypsum sample code characterized by lower impurity levels compared to DA.&lt;SEP&gt;HDS is a specific design or sample of phosphogypsum used in the study, requiring 3.0% citric acid for optimal purification.&lt;SEP&gt;HDS is a gypsum plaster design formulation evaluated in the study.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-006&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="Exotherms">
  <data key="d0">Exotherms</data>
  <data key="d1">concept</data>
  <data key="d2">Exotherms are thermal events measured by differential thermal analysis to indicate phase changes in phosphogypsum.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
<node id="Inversion Temperature">
  <data key="d0">Inversion Temperature</data>
  <data key="d1">data</data>
  <data key="d2">Inversion temperature is a thermal metric measured by differential thermal analysis, shifting from 390–450°C to 370–390°C after purification.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
