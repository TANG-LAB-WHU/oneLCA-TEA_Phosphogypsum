<node id="Aluminosilicates">
  <data key="d0">Aluminosilicates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aluminosilicates are impurities in phosphogypsum that undergo transformation and breakdown in water.&lt;SEP&gt;A crystalline phase present in the soil material sample alongside silicates.&lt;SEP&gt;A main crystalline phase constituting 65 wt% of the soil material alongside silicates.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-028&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-004&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-005</data>
  <data key="d4">unknown_source</data>
