  <data key="d1">person</data>
  <data key="d2">A researcher who reported that higher porosity and pore size lead to greater bone ingrowth and improved bioactivity.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791060479</data>
