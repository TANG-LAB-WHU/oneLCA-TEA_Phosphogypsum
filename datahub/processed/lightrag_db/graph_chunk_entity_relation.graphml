<node id="Carbon Solidification Mechanism">
  <data key="d0">Carbon Solidification Mechanism</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon solidification mechanism describes six pathways for synergistically neutralizing carbon dioxide using industrial waste.&lt;SEP&gt;Carbon solidification mechanism describes six pathways for synergistically neutralizing carbon dioxide using industrial waste.&lt;SEP&gt;Carbon solidification mechanism describes six pathways for synergistically neutralizing carbon dioxide using industrial waste.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-008&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-008&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-008</data>
  <data key="d4">unknown_source</data>
