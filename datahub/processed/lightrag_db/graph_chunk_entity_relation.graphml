<node id="Bone Mineral">
  <data key="d0">Bone Mineral</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Bone Mineral is the natural reference for particle size comparison with the synthesized hydroxyapatite.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-005</data>
  <data key="d4">unknown_source</data>
