  <data key="d0">Charge Recombination Rate</data>
  <data key="d1">concept</data>
  <data key="d2">The rate at which photogenerated electron-hole pairs recombine, influenced by porosity and oxygen vacancies.</data>
  <data key="d3">doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792190223</data>
  <data key="d6"></data>
