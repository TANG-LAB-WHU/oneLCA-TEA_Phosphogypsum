  <data key="d0">JCPDS File 190701</data>
  <data key="d1">data</data>
  <data key="d2">JCPDS file 190701 is the standard reference file used to identify the crystal structure of hexagonal pyromorphite.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-008</data>
