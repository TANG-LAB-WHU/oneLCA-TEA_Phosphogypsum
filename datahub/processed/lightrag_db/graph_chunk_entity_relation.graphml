</node>
<node id="Closed System">
  <data key="d0">Closed System</data>
  <data key="d1">location</data>
  <data key="d2">The Closed System is an experimental configuration used to establish baseline conditions for the thermal treatment.&lt;SEP&gt;A closed system is an experimental environment used to compare thermal treatment effects against an open nitrogen atmosphere.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-002&lt;SEP&gt;doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791498419</data>
  <data key="d6"></data>
