  <data key="d0">Formaldehyde Oxidation</data>
  <data key="d1">concept</data>
  <data key="d2">Formaldehyde oxidation is a chemical reaction where hydroxyapatite-supported gold and copper catalysts show high conversion and recyclability.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-020</data>
