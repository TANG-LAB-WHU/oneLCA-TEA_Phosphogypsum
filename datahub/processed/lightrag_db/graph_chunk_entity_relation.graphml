<node id="FeO">
  <data key="d0">FeO</data>
  <data key="d1">naturalobject</data>
  <data key="d2">FeO is an iron oxide compound produced in Step 4 and used to reduce CaSO4 in Step 5.&lt;SEP&gt;FeO is a chemical compound representing iron(II) oxide, with some measurements below detection limits.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-013&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-008</data>
