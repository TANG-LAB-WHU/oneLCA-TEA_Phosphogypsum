  <data key="d0">Basic Environment</data>
  <data key="d1">concept</data>
  <data key="d2">An alkaline condition in which the described hydrolysis reaction occurs.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961463</data>
  <data key="d6"></data>
