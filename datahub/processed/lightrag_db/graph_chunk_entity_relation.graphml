</node>
<node id="GHG">
  <data key="d0">GHG</data>
  <data key="d1">concept</data>
  <data key="d2">GHG represents greenhouse gas emissions that decrease with increased PSC technology usage.</data>
  <data key="d3">doc-276f29345df37143fc224a22d0f6089b-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791208637</data>
