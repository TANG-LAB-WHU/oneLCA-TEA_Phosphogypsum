<node id="Cemented Paste Fill Material">
  <data key="d0">Cemented Paste Fill Material</data>
  <data key="d1">artifact</data>
  <data key="d2">Cemented paste fill material is a hardened construction material whose mechanical performance is heavily influenced by its chemical composition and hydration products.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-012</data>
  <data key="d4">unknown_source</data>
