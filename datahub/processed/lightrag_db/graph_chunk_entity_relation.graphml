<node id="CO">
  <data key="d0">CO</data>
  <data key="d1">other</data>
  <data key="d2">CO is a gas involved in the redox reaction system of PG, analyzed via the Ellingham diagram.&lt;SEP&gt;CO is a carbon monoxide gas utilized as a reducing agent in Steps 2 and 4.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-013&lt;SEP&gt;doc-a3152ce135edc56e14c47e05535e05c7-chunk-011</data>
