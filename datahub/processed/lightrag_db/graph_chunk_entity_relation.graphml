<node id="STMP">
  <data key="d0">STMP</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A chemical reagent whose concentration influences the formation and homogeneity of the HA coreeshell structure.&lt;SEP&gt;A phosphorous source that reacts with hydroxide ions to generate phosphate species in the hydrothermal system.&lt;SEP&gt;STMP is a chemical compound used as a phosphorus source that reacts with hydroxide ions to produce phosphate.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-003&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-006&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-005</data>
