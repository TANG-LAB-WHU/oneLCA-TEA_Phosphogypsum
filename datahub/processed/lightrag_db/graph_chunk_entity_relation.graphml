  <data key="d0">Tailings</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tailings are mineral materials mixed with phosphogypsum to create filling slurry.&lt;SEP&gt;Tailings are mining waste materials used as a reference for PG content limits in filling materials.&lt;SEP&gt;Tailings are mining waste materials used as a baseline component in cemented filling materials.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-009&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-010&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Gamma Alumina">
  <data key="d0">Gamma Alumina</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gamma alumina promotes AFt precipitation and increases fluorine retention capacity.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Alkali Treatment">
  <data key="d0">Alkali Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Alkali treatment is a control measure utilizing alkaline additives to immobilize pollutants.&lt;SEP&gt;Alkali treatment manages phosphate pollution but has limited effectiveness for fluorine immobilization.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-023</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Monolayer Chemical Adsorption">
  <data key="d0">Monolayer Chemical Adsorption</data>
  <data key="d1">method</data>
  <data key="d2">Monolayer chemical adsorption is the mechanism by which iron tailings and modified quartz sand hinder phosphorus migration.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Fluorine Pollution">
  <data key="d0">Fluorine Pollution</data>
  <data key="d1">concept</data>
  <data key="d2">Fluorine pollution refers to the contamination caused by fluoride ions that requires effective immobilization strategies.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Calcium Hydroxide Solution">
  <data key="d0">Calcium Hydroxide Solution</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium hydroxide solution is applied at specific mass fractions to immobilize soluble phosphorus in PG.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Amorphous Aluminates">
  <data key="d0">Amorphous Aluminates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Amorphous aluminates serve as surfaces for fluoride adsorption in hardened CPGFM mixtures.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="Carbon Dioxide Emissions">
  <data key="d0">Carbon Dioxide Emissions</data>
  <data key="d1">data</data>
  <data key="d2">Carbon dioxide emissions are reduced by about 35% when gamma alumina partially replaces cement.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
</node>
<node id="C-S-H Gels">
  <data key="d0">C-S-H Gels</data>
  <data key="d1">naturalobject</data>
  <data key="d2">C-S-H gels are hydration products promoted by polymeric aluminum chloride.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791722536</data>
  <data key="d6"></data>
