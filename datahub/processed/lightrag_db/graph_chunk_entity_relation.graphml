<node id="Sodium Ions">
  <data key="d0">Sodium Ions</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sodium Ions are cations that, when added to hydroxyapatite, cause a slight increase in its basicity.&lt;SEP&gt;Sodium ions are cations present in the solution during HAP preparation.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-005&lt;SEP&gt;doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791470403</data>
