</node>
<node id="Godinho-Castro et al.">
  <data key="d0">Godinho-Castro et al.</data>
  <data key="d1">person</data>
  <data key="d2">Researchers who found that substituting 10% phosphogypsum for cement yields excellent compressive and tensile strengths.</data>
