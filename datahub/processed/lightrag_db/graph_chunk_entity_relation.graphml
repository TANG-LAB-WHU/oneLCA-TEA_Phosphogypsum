  <data key="d5">1791061334</data>
  <data key="d6"></data>
</node>
<node id="Fineness">
  <data key="d0">Fineness</data>
  <data key="d1">concept</data>
  <data key="d2">Fineness is a physical property measured in m²/kg (Blaine) for the produced cements and plaster.&lt;SEP&gt;Fineness is a physical property of cement measured in square meters per kilogram.&lt;SEP&gt;Fineness is a particle size property measured using the Blaine method to assess the quality of Portland slag cement.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-005&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-006&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790961592</data>
  <data key="d6"></data>
</node>
