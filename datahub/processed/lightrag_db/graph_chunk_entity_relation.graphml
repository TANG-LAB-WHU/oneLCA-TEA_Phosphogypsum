<node id="Campisi et al.">
  <data key="d0">Campisi et al.</data>
  <data key="d1">person</data>
  <data key="d2">Campisi et al. are researchers who investigated how the Ca/P molar ratio affects hydroxyapatite's metal removal efficiency.</data>
