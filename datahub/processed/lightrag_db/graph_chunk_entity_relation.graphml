<node id="8% Limit">
  <data key="d0">8% Limit</data>
  <data key="d1">data</data>
  <data key="d2">The 8% limit denotes the upper threshold of carbonate ion concentration naturally present in bone tissue hydroxyapatite.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-004</data>
