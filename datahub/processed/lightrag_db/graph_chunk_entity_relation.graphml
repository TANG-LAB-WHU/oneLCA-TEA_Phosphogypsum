  <data key="d0">Aqueous Residue</data>
  <data key="d1">other</data>
  <data key="d2">Aqueous Residue is the remaining solid material after extraction, now safe for industrial reuse due to reduced radioactivity.</data>
  <data key="d3">doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-013</data>
