<node id="Polyethylene Oxide">
  <data key="d0">Polyethylene Oxide</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Polyethylene Oxide serves as the hydrophilic block of the P123 Surfactant that faces outward due to strong water attraction.&lt;SEP&gt;Polyethylene Oxide serves as the hydrophilic block of the P123 Surfactant that faces outward due to strong water attraction.</data>
  <data key="d3">doc-3fd8439e859e3dd0c96328384e1761f0-chunk-005&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-005</data>
