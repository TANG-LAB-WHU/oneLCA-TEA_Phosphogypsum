  <data key="d1">naturalobject</data>
  <data key="d2">Uranium mine sludges contain (Ba, Ra) sulfate compounds from which Ra-226 can be released under anaerobic conditions.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
  <data key="d6"></data>
