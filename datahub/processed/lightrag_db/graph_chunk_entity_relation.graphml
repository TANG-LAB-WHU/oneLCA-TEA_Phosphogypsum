  <data key="d1">naturalobject</data>
  <data key="d2">Polonium-218 is a decay product formed when Radon-222 undergoes alpha decay.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
