  <data key="d5">1792407163</data>
  <data key="d6"></data>
</node>
<node id="Table S6">
  <data key="d0">Table S6</data>
  <data key="d1">content</data>
  <data key="d2">A data table presenting a preliminary economic assessment of the proposed process.&lt;SEP&gt;Table S6 contains the preliminary economic assessment data for the proposed process.&lt;SEP&gt;Table S6 contains experimental data detailing adsorption and desorption capacities for HAP and 20HPA-HAP systems under specific conditions.&lt;SEP&gt;A table containing normalized indicator results.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-010&lt;SEP&gt;doc-401b567da916dc34559e0bfe5a5b367b-chunk-009&lt;SEP&gt;doc-06f299b7e723cda1f0de1a647b02b6b4-chunk-009&lt;SEP&gt;doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-006</data>
