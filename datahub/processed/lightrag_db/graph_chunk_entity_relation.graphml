  <data key="d10">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-012&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-012&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-006&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-014&lt;SEP&gt;doc-401b567da916dc34559e0bfe5a5b367b-chunk-015&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-003&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-012&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-028&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-010&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-018&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-007&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-016&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-039&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-004&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-000&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-017&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-003&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-014&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-025</data>
