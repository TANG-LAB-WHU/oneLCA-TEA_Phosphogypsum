  <data key="d0">Porous HA Coreeshell Microspheres</data>
  <data key="d1">artifact</data>
  <data key="d2">Porous HA Coreeshell Microspheres are synthesized spherical structures with an inner core and outer shell, designed for drug delivery applications.</data>
