  <data key="d0">PGAB Solid Phase</data>
  <data key="d1">concept</data>
  <data key="d2">The PGAB Solid Phase is the solid product resulting from the bubbling pathway of carbonation.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
