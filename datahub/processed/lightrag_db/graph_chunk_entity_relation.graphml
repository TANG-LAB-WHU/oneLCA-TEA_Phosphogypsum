<node id="Amino Acids">
  <data key="d0">Amino Acids</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Amino Acids are organic compounds that regulate hydroxyapatite nucleation and control crystal growth mechanisms.</data>
