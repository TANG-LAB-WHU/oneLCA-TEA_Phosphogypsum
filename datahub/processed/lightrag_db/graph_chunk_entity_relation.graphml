  <data key="d0">Ecotoxicological Testing</data>
  <data key="d1">method</data>
  <data key="d2">Ecotoxicological testing is a laboratory methodology that utilizes animal models to measure the toxicity of industrial waste leachate.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Phosphogypsum Storage Yard">
  <data key="d0">Phosphogypsum Storage Yard</data>
  <data key="d1">artifact</data>
  <data key="d2">A designated area for storing phosphogypsum, where accumulated elements pose environmental and health threats.&lt;SEP&gt;Phosphogypsum storage yards are industrial sites where phosphogypsum waste is accumulated, serving as sources of gas emissions and leachate pollution.&lt;SEP&gt;Facilities for storing non-utilized phosphogypsum, with an average storage cycle of 4.7 years and limited service life.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-003&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791900641</data>
  <data key="d6"></data>
</node>
<node id="Asthma">
  <data key="d0">Asthma</data>
  <data key="d1">concept</data>
  <data key="d2">Asthma is a respiratory condition with elevated incidence rates observed in populations residing near phosphogypsum storage facilities.&lt;SEP&gt;Asthma is a respiratory condition triggered by the inhalation of low-concentration fluoride and other pollutants from phosphogypsum.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Cancer">
  <data key="d0">Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Cancer is a severe pathological outcome potentially induced by long-term exposure to radioactive elements and heavy metals from industrial waste.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Fluorosis">
  <data key="d0">Fluorosis</data>
  <data key="d1">concept</data>
  <data key="d2">Fluorosis is a toxicological condition caused by the diffusion of fluoride into human tissues and bones following environmental exposure.&lt;SEP&gt;Fluorosis is a toxic condition caused by human ingestion of excessive fluorides through drinking water or food.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791900069</data>
  <data key="d6"></data>
</node>
<node id="In Vitro Research Method">
  <data key="d0">In Vitro Research Method</data>
  <data key="d1">method</data>
  <data key="d2">In vitro research method is a laboratory technique used to study phosphogypsum toxicological effects with high precision but limited long-term scope.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="In Vivo Research Method">
  <data key="d0">In Vivo Research Method</data>
  <data key="d1">method</data>
  <data key="d2">In vivo research method is a biological testing technique used to evaluate phosphogypsum toxicological effects, offering speed and accuracy but facing long-term limitations.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Antioxidant Enzyme System">
  <data key="d0">Antioxidant Enzyme System</data>
  <data key="d1">concept</data>
  <data key="d2">The antioxidant enzyme system is a biological mechanism in zebrafish that is damaged by toxic pollutants in phosphogypsum leachate.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
