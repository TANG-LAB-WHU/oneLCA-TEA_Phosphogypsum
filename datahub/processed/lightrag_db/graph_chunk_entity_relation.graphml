<node id="Sol-Gel Processes">
  <data key="d0">Sol-Gel Processes</data>
  <data key="d1">method</data>
  <data key="d2">Sol-gel processes are wet chemistry methods applied to synthesize hydroxyapatite.</data>
  <data key="d3">doc-d4a38fcc1b0f33a17d23e7a4407a9cf9-chunk-001</data>
