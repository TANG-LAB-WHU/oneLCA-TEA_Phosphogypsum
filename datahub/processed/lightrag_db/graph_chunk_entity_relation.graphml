<node id="Buhari And Raju">
  <data key="d0">Buhari And Raju</data>
  <data key="d1">person</data>
  <data key="d2">Buhari And Raju are researchers who found that concrete workability decreases across various Plaster Of Paris replacement percentages.</data>
