<node id="Tobermorite">
  <data key="d0">Tobermorite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tobermorite is a hydration product formed during autoclaving that enhances the structural integrity of the concrete.&lt;SEP&gt;Tobermorite is a mineral phase formed from the transformation of CeSeH gel during autoclaving, significantly influencing compressive strength.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-022&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-023</data>
