  <data key="d0">Standard Soil Environmental Assessments</data>
  <data key="d1">concept</data>
  <data key="d2">Standard soil environmental assessments are evaluation methods that overestimate heavy metal toxicity levels for soil biota and plants.</data>
  <data key="d3">doc-25198f8665e133385fd54e5a03e28a44-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792344981</data>
  <data key="d6"></data>
</node>
<node id="Organogenesis">
  <data key="d0">Organogenesis</data>
  <data key="d1">concept</data>
  <data key="d2">Organogenesis is the plant developmental process that faces minimal adverse risk from low water-soluble lead in soil.</data>
  <data key="d3">doc-25198f8665e133385fd54e5a03e28a44-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792344981</data>
