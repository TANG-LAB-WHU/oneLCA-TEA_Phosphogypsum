<node id="Phosphate Rock Samples">
  <data key="d0">Phosphate Rock Samples</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Phosphate rock samples are raw materials analyzed alongside phosphogypsum waste for uranium isotope ratios.</data>
