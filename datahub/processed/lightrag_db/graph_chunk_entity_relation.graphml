</node>
<node id="Th Radionuclides">
  <data key="d0">Th Radionuclides</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A group of thorium isotopes that generally have lower specific activities than Ra-226 in phosphogypsum.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
