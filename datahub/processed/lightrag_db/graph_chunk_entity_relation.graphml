<node id="Russian Federation">
  <data key="d0">Russian Federation</data>
  <data key="d1">location</data>
  <data key="d2">Russian Federation is a country in the southwest of which the Haplic Chernozem area is located.&lt;SEP&gt;The Russian Federation is the country whose regulatory register includes the PND F 16.1.42–04 method for heavy metal determination.&lt;SEP&gt;Russian Federation is a country in the southwest of which the Haplic Chernozem area is located.&lt;SEP&gt;The Russian Federation is the country whose regulatory register includes the PND F 16.1.42–04 method for heavy metal determination.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-005&lt;SEP&gt;doc-ce9090f230bcd0bfeefe92db7a576442-chunk-003&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-005&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-003</data>
