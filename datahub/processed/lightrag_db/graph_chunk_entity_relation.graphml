  <data key="d5">1791813449</data>
  <data key="d6"></data>
</node>
<node id="Adsorption Intensity">
  <data key="d0">Adsorption Intensity</data>
  <data key="d1">concept</data>
  <data key="d2">Adsorption intensity relates to the surface heterogeneity and is represented by the parameter n.</data>
