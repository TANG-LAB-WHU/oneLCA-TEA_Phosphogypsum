<node id="Ion exchange">
  <data key="d0">Ion exchange</data>
  <data key="d1">method</data>
  <data key="d2">Ion exchange is a chemical process at the solid-liquid interface linked to calcium carbonate equilibrium.&lt;SEP&gt;Ion exchange is a chemical process at the solid-liquid interface linked to calcium carbonate equilibrium.</data>
