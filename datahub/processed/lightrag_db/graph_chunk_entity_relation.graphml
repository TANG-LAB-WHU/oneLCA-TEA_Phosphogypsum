  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985489</data>
  <data key="d6"></data>
</node>
<node id="Icariin">
  <data key="d0">Icariin</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Icariin is a bioactive compound loaded into composite scaffolds for therapeutic applications.</data>
