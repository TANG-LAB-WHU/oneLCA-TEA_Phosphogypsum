<node id="Overall Rare Earth Elements Recovery">
  <data key="d0">Overall Rare Earth Elements Recovery</data>
  <data key="d1">data</data>
  <data key="d2">Overall rare earth elements recovery is a quantitative metric measuring the percentage of rare earth elements successfully extracted, achieving 52.9 wt% in cycle leaching tests.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791038121</data>
  <data key="d6"></data>
</node>
<node id="Gypsum Purity">
  <data key="d0">Gypsum Purity</data>
  <data key="d1">data</data>
  <data key="d2">Gypsum purity is a quality metric indicating the concentration of calcium sulfate dihydrate in the recovered product, exceeding 95 wt%.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791038121</data>
  <data key="d6"></data>
</node>
<node id="Process Cost">
  <data key="d0">Process Cost</data>
  <data key="d1">data</data>
  <data key="d2">Process cost represents the economic expenditure for reagents and operations, calculated at $0.0372 per kilogram of phosphogypsum processed.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791038121</data>
  <data key="d6"></data>
