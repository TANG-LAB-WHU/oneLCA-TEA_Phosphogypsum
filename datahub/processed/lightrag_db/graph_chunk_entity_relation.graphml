<node id="Hurst and Arnold">
  <data key="d0">Hurst and Arnold</data>
  <data key="d1">person</data>
  <data key="d2">Researchers who reported that 60% of Ra-226 and 99% of Po-210 appear in phosphogypsum.</data>
