</node>
<node id="Coral">
  <data key="d0">Coral</data>
  <data key="d1">creature</data>
  <data key="d2">Coral is a marine organism that fixes CO2- under normal pH conditions to promote the formation of carbonate minerals and coral reefs.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109993</data>
