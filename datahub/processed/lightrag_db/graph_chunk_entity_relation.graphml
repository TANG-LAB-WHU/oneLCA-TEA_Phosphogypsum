  <data key="d1">data</data>
  <data key="d2">Surface Areas represent quantitative measurements of material porosity and reactivity in calcium phosphate studies.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985383</data>
  <data key="d6"></data>
