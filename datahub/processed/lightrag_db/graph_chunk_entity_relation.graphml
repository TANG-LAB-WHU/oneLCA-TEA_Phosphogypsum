<node id="Autoclave Conditions">
  <data key="d0">Autoclave Conditions</data>
  <data key="d1">method</data>
  <data key="d2">Autoclave conditions are steam pressure and temperature treatments applied to phosphogypsum to increase brick strength.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-014</data>
