<node id="Heteroepitaxial Growth">
  <data key="d0">Heteroepitaxial Growth</data>
  <data key="d1">concept</data>
  <data key="d2">Heteroepitaxial Growth is a crystal growth process along the c axis induced by the specific adsorption of citrate on HAp lattice planes.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-003</data>
