SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-023&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-004&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-002&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-003&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-016&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-003&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-002&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-000&lt;SEP&gt;doc-3fd8439e859e3dd0c96328384e1761f0-chunk-024&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-012&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-006&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-000&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-024&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-001&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-004</data>
