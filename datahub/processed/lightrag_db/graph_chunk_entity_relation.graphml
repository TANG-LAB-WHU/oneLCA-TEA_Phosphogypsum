<node id="Thermal treatment">
  <data key="d0">Thermal treatment</data>
  <data key="d1">method</data>
  <data key="d2">Thermal treatment is a process applied to HAP samples at 400°C for 30 minutes to modify their properties.&lt;SEP&gt;Thermal treatment is a heating process applied to samples to induce phase transformation and remove adsorbed water.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-002&lt;SEP&gt;doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-007</data>
