<node id="SNCR (Selective Non-Catalytic Reduction)">
  <data key="d0">SNCR (Selective Non-Catalytic Reduction)</data>
  <data key="d1">method</data>
  <data key="d2">SNCR is a denitrification technique integrated into the exhaust gas purification system for β-building gypsum production.</data>
  <data key="d3">doc-276f29345df37143fc224a22d0f6089b-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791207316</data>
  <data key="d6"></data>
</node>
<node id="Sulfuric Acid Co-Production Cement (PSC) Technology">
  <data key="d0">Sulfuric Acid Co-Production Cement (PSC) Technology</data>
  <data key="d1">method</data>
  <data key="d2">PSC technology is a thermochemical process that converts phosphogypsum into calcium oxide and sulfur dioxide for cement production.</data>
