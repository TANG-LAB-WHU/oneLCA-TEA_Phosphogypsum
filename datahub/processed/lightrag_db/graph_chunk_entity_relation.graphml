<node id="Granulated Slag">
  <data key="d0">Granulated Slag</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Granulated slag is a primary raw material interground to produce Portland slag cement.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-006</data>
