<node id="Large-Scale Utilization">
  <data key="d0">Large-Scale Utilization</data>
  <data key="d1">concept</data>
  <data key="d2">Large-Scale Utilization refers to the comprehensive and multi-level integrated processing required to address phosphogypsum accumulation.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-016</data>
