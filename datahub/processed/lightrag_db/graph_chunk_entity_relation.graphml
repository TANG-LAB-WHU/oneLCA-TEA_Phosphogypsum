<node id="Moisture Gradient">
  <data key="d0">Moisture Gradient</data>
  <data key="d1">concept</data>
  <data key="d2">Moisture gradient refers to the difference in moisture content between the surface and interior of mortar specimens during curing.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
</node>
<node id="Differential Shrinkage">
  <data key="d0">Differential Shrinkage</data>
  <data key="d1">concept</data>
  <data key="d2">Differential shrinkage is a physical phenomenon caused by moisture gradients that generates tensile stresses in surface layers.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
</node>
<node id="Cement Reaction">
  <data key="d0">Cement Reaction</data>
  <data key="d1">concept</data>
  <data key="d2">Cement reaction is the chemical process in mortar that is retarded by the presence of anhydrite.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
</node>
<node id="23°C">
  <data key="d0">23°C</data>
  <data key="d1">data</data>
  <data key="d2">23°C is the controlled temperature maintained in the moist room during the curing process.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
</node>
<node id="3, 7, and 28 Days">
  <data key="d0">3, 7, and 28 Days</data>
  <data key="d1">data</data>
  <data key="d2">3, 7, and 28 days are the specific laboratory curing durations at which mechanical properties were tested.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
</node>
<node id="0 to 20% PG Replacement">
  <data key="d0">0 to 20% PG Replacement</data>
  <data key="d1">data</data>
  <data key="d2">0 to 20% PG replacement represents the initial percentage range where moist curing yields higher compressive strength than air-dry curing.</data>
  <data key="d3">doc-e0549fcda95f7199440791b20bf85635-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792502486</data>
  <data key="d6"></data>
