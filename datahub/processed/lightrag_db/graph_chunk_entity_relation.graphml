</node>
<node id="Gelatin Matrix">
  <data key="d0">Gelatin Matrix</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gelatin Matrix is a medium used in the double diffusion technique to study FHAp anisotropic growth.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
