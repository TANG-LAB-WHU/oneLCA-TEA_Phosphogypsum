  <data key="d0">Korentajer et al.</data>
  <data key="d1">person</data>
  <data key="d2">Korentajer et al. are researchers who used a laboratory rainfall simulator to study phosphorus export and eutrophication risks from phosphogypsum.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="370 Bq kg^-1">
  <data key="d0">370 Bq kg^-1</data>
  <data key="d1">data</data>
  <data key="d2">370 Bq kg^-1 is the maximum allowable average concentration of Ra-226 in phosphogypsum for agricultural use as mandated by the U.S. E.P.A.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033</data>
  <data key="d4">unknown_source</data>
