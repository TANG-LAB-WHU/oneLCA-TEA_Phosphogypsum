</node>
<node id="Fauna">
  <data key="d0">Fauna</data>
  <data key="d1">creature</data>
  <data key="d2">Fauna refers to animals that are exposed to toxic impurities through the food chain and environmental contamination.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
