  <data key="d6"></data>
</node>
<node id="Recycled Aggregate">
  <data key="d0">Recycled Aggregate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Recycled Aggregate replaces natural aggregate in concrete, initially reducing strength but improving it when PG reacts with surface mortar.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-022</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791365947</data>
