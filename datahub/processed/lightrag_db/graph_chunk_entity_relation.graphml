<node id="Bioavailability">
  <data key="d0">Bioavailability</data>
  <data key="d1">concept</data>
  <data key="d2">Bioavailability refers to the extent to which toxic impurities like fluorides and phosphates can be absorbed and cause toxicity in flora and fauna.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791023386</data>
