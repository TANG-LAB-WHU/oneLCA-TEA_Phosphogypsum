<node id="C Axis">
  <data key="d0">C Axis</data>
  <data key="d1">concept</data>
  <data key="d2">The C axis is the crystallographic direction along which hydroxyapatite whiskers elongate during hydrothermal synthesis.</data>
  <data key="d3">doc-2196dee89de9694f28ef4eaa0e85f130-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791664401</data>
