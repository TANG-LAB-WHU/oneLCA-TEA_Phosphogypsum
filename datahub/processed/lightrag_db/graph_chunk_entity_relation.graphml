</node>
<node id="Research Institutes">
  <data key="d0">Research Institutes</data>
  <data key="d1">organization</data>
  <data key="d2">Scientific organizations that partner with companies to address pivotal technological challenges in PG recycling.&lt;SEP&gt;Research Institutes are scientific organizations that contribute as auxiliary components in collaborative technological R&amp;D teams.&lt;SEP&gt;Research institutes are collaborative partners in developing comprehensive utilization plans and high-value products for phosphogypsum.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-008&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791771443</data>
  <data key="d6"></data>
</node>
<node id="Scientific and Technological Innovation Platforms">
  <data key="d0">Scientific and Technological Innovation Platforms</data>
  <data key="d1">organization</data>
  <data key="d2">National or local entities facilitating industry-academia-research integration for PG recycling R&amp;D.&lt;SEP&gt;Scientific and Technological Innovation Platforms are national or local entities leveraged to facilitate industry, academia, and research integration.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791450501</data>
  <data key="d6"></data>
</node>
<node id="Mine Pits">
  <data key="d0">Mine Pits</data>
  <data key="d1">location</data>
  <data key="d2">Mine Pits are privately excavated and unregulated sites in Yunnan utilized for large-scale phosphogypsum filling in the short term.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791450501</data>
