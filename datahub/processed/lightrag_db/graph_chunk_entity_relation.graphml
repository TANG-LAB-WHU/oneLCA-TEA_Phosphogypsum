<node id="Acid Dissolution">
  <data key="d0">Acid Dissolution</data>
  <data key="d1">method</data>
  <data key="d2">Acid dissolution is the chemical process describing the breakdown of hydroxyapatite crystal lattice in an acidic environment.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-040</data>
