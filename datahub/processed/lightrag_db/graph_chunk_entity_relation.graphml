<node id="Sahadat-Scherrer Model">
  <data key="d0">Sahadat-Scherrer Model</data>
  <data key="d1">method</data>
  <data key="d2">The Sahadat-Scherrer Model is a method used to accurately estimate the crystallite size of nanoparticles.</data>
  <data key="d3">doc-a52951853fd542b78835b677936c557b-chunk-010</data>
