  <data key="d1">concept</data>
  <data key="d2">Sustainable phosphorus measures are interventions aimed at improving phosphorus efficiency and recycling across sectors.&lt;SEP&gt;Sustainable phosphorus measures are actions designed to achieve phosphorus security and reduce losses.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-002&lt;SEP&gt;doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792248824</data>
  <data key="d6"></data>
</node>
<node id="Demand Management Measures">
  <data key="d0">Demand Management Measures</data>
  <data key="d1">method</data>
  <data key="d2">Demand management measures are strategies used to avoid or reduce phosphorus losses and waste streams.</data>
  <data key="d3">doc-e1b5f95e85d7bfa3b7aab581f3c82b33-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792248824</data>
  <data key="d6"></data>
