  <data key="d0">Nd:YAG Pulsed Laser Deposition</data>
  <data key="d1">method</data>
  <data key="d2">A laser-based technique investigated for producing crystalline hydroxyapatite thin coatings at room temperature.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-016</data>
