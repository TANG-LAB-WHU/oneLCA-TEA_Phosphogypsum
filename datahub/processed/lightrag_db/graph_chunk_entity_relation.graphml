<node id="Basalt Fiber">
  <data key="d0">Basalt Fiber</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Basalt fiber is a reinforcement material integrated into phosphogypsum-based composites.&lt;SEP&gt;Basalt fiber is a reinforcing material incorporated into phosphogypsum-based composites to improve mechanical properties and freeze-thaw resistance.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-022&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-015</data>
