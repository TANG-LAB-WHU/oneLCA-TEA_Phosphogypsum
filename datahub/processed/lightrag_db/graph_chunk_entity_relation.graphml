  <data key="d1">concept</data>
  <data key="d2">Poisoning symptoms are adverse health reactions in humans triggered by airborne phosphine gas concentrations reaching 10 μg/m³.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-010</data>
