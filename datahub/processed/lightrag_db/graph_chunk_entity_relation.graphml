<node id="Illite">
  <data key="d0">Illite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">An initially abundant clay mineral that disintegrates between 450 and 900 °C during the brick baking process.&lt;SEP&gt;Illite is a potassium aluminum magnesium silicate mineral identified in the mineralogical composition.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-015&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-003</data>
