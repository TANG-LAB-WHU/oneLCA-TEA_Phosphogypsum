  <data key="d1">concept</data>
  <data key="d2">Second pollution refers to the long-term environmental contamination caused by unrecovered hazardous components in phosphogypsum.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-001</data>
