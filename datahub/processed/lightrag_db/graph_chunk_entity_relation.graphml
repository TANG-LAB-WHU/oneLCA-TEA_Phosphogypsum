<node id="Dehydration Rate">
  <data key="d0">Dehydration Rate</data>
  <data key="d1">data</data>
  <data key="d2">Dehydration rate is the speed at which water is lost from phosphogypsum during heating, influenced by the heating rate.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-002</data>
