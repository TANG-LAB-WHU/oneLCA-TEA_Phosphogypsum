  <data key="d0">Amino-bisphosphonates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Amino-bisphosphonates are multifunctional reagents with low toxicity that attract attention in biomaterial research.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-002</data>
