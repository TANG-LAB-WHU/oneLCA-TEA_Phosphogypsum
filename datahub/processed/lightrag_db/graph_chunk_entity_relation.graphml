<node id="Solid Waste Landfills">
  <data key="d0">Solid Waste Landfills</data>
  <data key="d1">location</data>
  <data key="d2">Solid Waste Landfills are facilities for waste disposal that contribute to land occupation and emergy loss.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792223613</data>
