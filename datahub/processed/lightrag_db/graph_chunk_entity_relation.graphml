  <data key="d0">Ruan et al.</data>
  <data key="d1">person</data>
  <data key="d2">Ruan et al. prepared early-strength cementitious composites using refining slag, slag, phosphogypsum, and sodium hydroxide.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-012</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791718872</data>
  <data key="d6"></data>
