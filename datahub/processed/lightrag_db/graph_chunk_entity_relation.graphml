  <data key="d13"></data>
</edge>
<edge source="Hydroxyapatite" target="Fluoroapatite">
  <data key="d7">2.0</data>
  <data key="d8">Fluoroapatite is a thermodynamically stable variant of hydroxyapatite where the Y site is occupied by fluoride ions.&lt;SEP&gt;Fluoroapatite is compared with hydroxyapatite for catalytic activity in butan-2-ol conversion and methane oxidation.</data>
  <data key="d9">catalysis,comparison,structural variant,thermodynamic stability</data>
  <data key="d10">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-001&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-024</data>
