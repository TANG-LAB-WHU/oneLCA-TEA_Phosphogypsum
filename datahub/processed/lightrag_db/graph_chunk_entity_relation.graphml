<node id="Fractional Enrichment">
  <data key="d0">Fractional Enrichment</data>
  <data key="d1">concept</data>
  <data key="d2">Fractional Enrichment is a possible interpretation of the normalized index used to model radionuclide migration.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-010</data>
