  <data key="d5">1791061208</data>
  <data key="d6"></data>
</node>
<node id="Dental Applications">
  <data key="d0">Dental Applications</data>
  <data key="d1">concept</data>
  <data key="d2">Medical procedures where a shorter initial setting time of 3 minutes is preferred.&lt;SEP&gt;Medical procedures utilizing the cement, where a shorter initial setting time of approximately 3 minutes is preferred.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-006&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-007</data>
