  <data key="d0">Aluminosilicates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aluminosilicates are impurities in phosphogypsum that undergo transformation and breakdown in water.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-028</data>
