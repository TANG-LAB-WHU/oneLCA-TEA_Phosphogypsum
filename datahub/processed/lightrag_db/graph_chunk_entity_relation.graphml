<node id="High Value-Added Utilization">
  <data key="d0">High Value-Added Utilization</data>
  <data key="d1">concept</data>
  <data key="d2">High Value-Added Utilization represents a key strategy to solve phosphogypsum disposal problems through economic and technological advancement.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-016</data>
