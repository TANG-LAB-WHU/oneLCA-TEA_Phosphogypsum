  <data key="d5">1791966541</data>
  <data key="d6"></data>
</node>
<node id="1D/2D Homojunction Photocatalyst">
  <data key="d0">1D/2D Homojunction Photocatalyst</data>
  <data key="d1">artifact</data>
  <data key="d2">1D/2D Homojunction Photocatalyst is a photocatalyst formed by the intimate parallel attachment of 1D and 2D Hydroxyapatite structures.</data>
  <data key="d3">doc-3fd8439e859e3dd0c96328384e1761f0-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791966541</data>
  <data key="d6"></data>
</node>
<node id="Photoinduced Charge Transfer">
  <data key="d0">Photoinduced Charge Transfer</data>
  <data key="d1">concept</data>
  <data key="d2">Photoinduced Charge Transfer is a process efficiently demonstrated by the homojunction photocatalyst, which hinders charge carrier recombination.</data>
  <data key="d3">doc-3fd8439e859e3dd0c96328384e1761f0-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791966541</data>
  <data key="d6"></data>
