  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-020</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Phosphogypsum Yard">
  <data key="d0">Phosphogypsum Yard</data>
  <data key="d1">location</data>
  <data key="d2">Designated storage facilities for phosphogypsum that serve as primary sources of airborne and waterborne pollutants.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109093</data>
  <data key="d6"></data>
</node>
<node id="Ammonium Ion">
  <data key="d0">Ammonium Ion</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ammonium ions compete with moisture similarly to sulfate ions, contributing to the prolonged atmospheric retention of phosphogypsum.&lt;SEP&gt;Ammonium ions in the atmosphere compete with hydrogen fluoride for moisture, extending its atmospheric residence time.&lt;SEP&gt;Ammonium ion is a positively charged chemical species involved in the chemical equation and the stabilization process.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-005&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-027</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791119375</data>
  <data key="d6"></data>
</node>
<node id="Nano-mineral Particles">
  <data key="d0">Nano-mineral Particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nano-mineral particles derived from phosphogypsum and raw materials exhibit strong adsorption capabilities for toxic elements.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109201</data>
  <data key="d6"></data>
</node>
<node id="Greenhouse Effect">
  <data key="d0">Greenhouse Effect</data>
  <data key="d1">concept</data>
  <data key="d2">The greenhouse effect is an atmospheric environmental impact induced by phosphogypsum storage.&lt;SEP&gt;The greenhouse effect is a climatic phenomenon exacerbated by phosphine gas and the reduced atmospheric clearance of methane.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109201</data>
  <data key="d6"></data>
</node>
<node id="Ozone">
  <data key="d0">Ozone</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ozone undergoes photolysis under sunlight to produce hydroxyl radicals, which are crucial for atmospheric chemical balance.&lt;SEP&gt;Ozone concentrations increase due to the emission of harmful gases from open burning of rice straw.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-e290dd6268316238694f70c30a367426-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791142316</data>
  <data key="d6"></data>
</node>
<node id="Hydroxyl Radical">
  <data key="d0">Hydroxyl Radical</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hydroxyl radicals are reactive species that oxidize methane but are consumed by phosphine gas, reducing methane clearance.&lt;SEP&gt;Hydroxyl radical is a reactive species associated with phosphogypsum storage emissions.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109370</data>
  <data key="d6"></data>
</node>
<node id="Ocean Surface Water">
  <data key="d0">Ocean Surface Water</data>
  <data key="d1">location</data>
  <data key="d2">Ocean surface waters experience lowered pH levels due to the proximity and deposition of phosphogypsum storage sites.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109370</data>
  <data key="d6"></data>
</node>
<node id="Coral Reefs">
  <data key="d0">Coral Reefs</data>
  <data key="d1">creature</data>
  <data key="d2">Coral reefs depend on stable water acidity to fix carbonate ions and form calcium carbonate structures essential for survival.&lt;SEP&gt;Coral reefs are structures formed with the help of coral and carbonate minerals, impacted by phosphogypsum dumping.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109370</data>
  <data key="d6"></data>
</node>
<node id="Water Acidity">
  <data key="d0">Water Acidity</data>
  <data key="d1">concept</data>
  <data key="d2">Water acidity, measured by pH, is a critical environmental parameter negatively impacted by phosphogypsum deposition.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109370</data>
  <data key="d6"></data>
</node>
<node id="Ultraviolet Radiation">
  <data key="d0">Ultraviolet Radiation</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ultraviolet radiation induces the photolysis of atmospheric ozone, generating hydroxyl radicals.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109370</data>
  <data key="d6"></data>
</node>
<node id="Ocean">
  <data key="d0">Ocean</data>
  <data key="d1">location</data>
  <data key="d2">The ocean receives dumped phosphogypsum, leading to increased concentrations of heavy metals and radioactive elements.&lt;SEP&gt;The ocean is the final environmental compartment receiving heavy metal complexes via surface runoff and groundwater flow.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109508</data>
  <data key="d6"></data>
</node>
<node id="Carbonate Minerals">
  <data key="d0">Carbonate Minerals</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Carbonate minerals are formed through biological processes where coral reefs fix carbonate ions from the water.&lt;SEP&gt;Carbonate minerals are formed through the action of coral fixing CO2- in normal pH conditions.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-006&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109508</data>
  <data key="d6"></data>
</node>
<node id="Magnetite Nano-mineral Particles">
  <data key="d0">Magnetite Nano-mineral Particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Magnetite nano-mineral particles act as adsorbents for heavy metal ions in the environment.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109608</data>
