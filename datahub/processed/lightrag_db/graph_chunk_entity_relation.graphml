  <data key="d12">1791775057</data>
  <data key="d13"></data>
</edge>
<edge source="Phosphogypsum" target="Calcium Fluoride">
  <data key="d7">3.0</data>
  <data key="d8">Calcium fluoride forms on cement particle surfaces alongside calcium phosphate, influencing PG's retarder effect.&lt;SEP&gt;Calcium fluoride is produced during the fluoride solution conversion of phosphogypsum.&lt;SEP&gt;Phosphogypsum contains calcium fluoride as one of its chemical forms of fluoride.</data>
  <data key="d9">chemical form,contains,fluoride conversion,retardation mechanism,surface reaction,synthesis product</data>
  <data key="d10">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-018&lt;SEP&gt;doc-eb86340ba0851c06e97600104fca25c9-chunk-014&lt;SEP&gt;doc-afe70f2d82515df80906bf3babd4e4eb-chunk-003</data>
