  <data key="d0">Ball Milling Technique</data>
  <data key="d1">method</data>
  <data key="d2">Ball milling technique is a physical treatment method used to alter the molecular structure of phosphogypsum.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-013</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791365693</data>
