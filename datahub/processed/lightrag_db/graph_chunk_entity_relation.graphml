<node id="Precision">
  <data key="d0">Precision</data>
  <data key="d1">concept</data>
  <data key="d2">Precision is a quality metric for XRD data that is assured by focusing on low-angle reflections.</data>
  <data key="d3">doc-a52951853fd542b78835b677936c557b-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791835756</data>
