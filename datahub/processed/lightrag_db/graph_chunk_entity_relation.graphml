</node>
<node id="PGAW Solid Phase">
  <data key="d0">PGAW Solid Phase</data>
  <data key="d1">concept</data>
  <data key="d2">The PGAW Solid Phase is produced via the weathering pathway during carbonation.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
  <data key="d6"></data>
</node>
<node id="PGAB(L)">
  <data key="d0">PGAB(L)</data>
  <data key="d1">concept</data>
  <data key="d2">PGAB(L) is a liquid phase produced during the bubbling pathway of carbonation, which is discarded.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
  <data key="d6"></data>
</node>
