  <data key="d0">Jiangxi University of Science and Technology</data>
  <data key="d1">organization</data>
  <data key="d2">Jiangxi University of Science and Technology is the academic institution where Hui Yang is affiliated.&lt;SEP&gt;Jiangxi University of Science and Technology is the institution that provided financial support for the research through various scientific foundations.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004&lt;SEP&gt;doc-f2534f7a997df3f80305323317b15be9-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
</node>
<node id="TEM Images">
  <data key="d0">TEM Images</data>
  <data key="d1">content</data>
  <data key="d2">TEM images are microscopic visualizations that document the shape transformation of CC nanoparticles at different stirring times.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
