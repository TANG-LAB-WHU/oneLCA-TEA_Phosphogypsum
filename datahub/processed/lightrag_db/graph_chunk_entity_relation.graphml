  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="370 Bq kg^-1">
  <data key="d0">370 Bq kg^-1</data>
  <data key="d1">data</data>
  <data key="d2">370 Bq kg^-1 is the maximum allowable average concentration of Ra-226 in phosphogypsum for agricultural use as mandated by the U.S. E.P.A.</data>
