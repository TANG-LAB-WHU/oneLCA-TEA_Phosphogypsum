  <data key="d6"></data>
</node>
<node id="Alpha emitting radionuclides">
  <data key="d0">Alpha emitting radionuclides</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Alpha emitting radionuclides are radioactive particles considered a greater health concern than beta emitters due to severe biological damage upon inhalation or ingestion.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
</node>
<node id="Beta emitters">
  <data key="d0">Beta emitters</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Beta emitters are radioactive particles considered a lower health concern compared to alpha emitters in the context of phosphogypsum exposure.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
