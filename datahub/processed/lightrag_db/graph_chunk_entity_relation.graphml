<node id="Thermal Pretreatment">
  <data key="d0">Thermal Pretreatment</data>
  <data key="d1">method</data>
  <data key="d2">Thermal pretreatment is the primary technology used for phosphogypsum dehydration, gelling stimulation, and impurity reduction.&lt;SEP&gt;Thermal pretreatment is the primary technology used for phosphogypsum dehydration, gelling stimulation, and impurity reduction.&lt;SEP&gt;Thermal pretreatment is the primary technology used for phosphogypsum dehydration, gelling stimulation, and impurity reduction.</data>
  <data key="d3">doc-a7ec54d376b079eceb4eab9d1f23165e-chunk-003&lt;SEP&gt;doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-003&lt;SEP&gt;doc-20b5888df3bfef8e98cc13abb005b7f0-chunk-003</data>
