<node id="A0">
  <data key="d0">A0</data>
  <data key="d1">concept</data>
  <data key="d2">A0 represents the background concentration or reference value of an element in the Enrichment Factor equation.&lt;SEP&gt;A0 represents the initial or background concentration of an element in scientific notation.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-010&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-009</data>
