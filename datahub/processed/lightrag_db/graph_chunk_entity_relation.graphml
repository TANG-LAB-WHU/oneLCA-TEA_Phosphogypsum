<node id="National Bureau of Statistics of China">
  <data key="d0">National Bureau of Statistics of China</data>
  <data key="d1">organization</data>
  <data key="d2">The organization providing GDP, population, and IGDP data for China in 2015 and 2020.&lt;SEP&gt;Organization providing population data for 2020 used in emergy calculations.&lt;SEP&gt;A Chinese government agency responsible for collecting and publishing national statistical data, including GDP and environmental metrics.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-028&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Emergy Yield Ratio">
  <data key="d0">Emergy Yield Ratio</data>
  <data key="d1">concept</data>
  <data key="d2">Concept representing the ratio of total emergy inputs to purchased emergy, used to assess economic benefits.&lt;SEP&gt;Emergy Yield Ratio represents the ratio of emergy output to purchased emergy input, indicating system yield relative to purchases.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-033</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Environmental Load Ratio">
  <data key="d0">Environmental Load Ratio</data>
  <data key="d1">concept</data>
  <data key="d2">Concept representing the ratio of nonrenewable emergy inputs to renewable emergy inputs, used to evaluate environmental pressure.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Emergy Sustainability Index">
  <data key="d0">Emergy Sustainability Index</data>
  <data key="d1">concept</data>
  <data key="d2">Concept defined as the ratio of Emergy Yield Ratio to Environmental Load Ratio, indicating long-term sustainability.&lt;SEP&gt;An indicator measuring the sustainability of an industrial system based on emergy analysis.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Pollutant Emissions Impact Intensity">
  <data key="d0">Pollutant Emissions Impact Intensity</data>
  <data key="d1">concept</data>
  <data key="d2">Concept measuring total emergy of pollutant impacts per year divided by annual product output, reflecting resource efficiency.&lt;SEP&gt;An indicator quantifying the impact intensity of pollutant emissions within an industrial system.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Carbon Emission Accounting">
  <data key="d0">Carbon Emission Accounting</data>
  <data key="d1">method</data>
  <data key="d2">Carbon emission accounting is a methodological approach used to measure and compare carbon emission intensity across different disposal scenarios.&lt;SEP&gt;Carbon Emission Accounting is an accounting technique combined with Emergy Analysis to assess carbon emission intensity.&lt;SEP&gt;Carbon Emission Accounting is a methodology integrated into the evaluation framework to track carbon output.&lt;SEP&gt;Method for calculating greenhouse gas emissions, adopted from a national standard for chemical production enterprises.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-003&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-000&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
  <data key="d6"></data>
</node>
<node id="Material Balance Algorithm">
  <data key="d0">Material Balance Algorithm</data>
  <data key="d1">method</data>
  <data key="d2">Internationally recognized method used for carbon emission accounting.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-008</data>
