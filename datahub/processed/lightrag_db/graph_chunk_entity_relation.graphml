<node id="Small Media">
  <data key="d0">Small Media</data>
  <data key="d1">artifact</data>
  <data key="d2">Small Media is spherical stainless-steel milling media with a 0.5-inch diameter used in the hydrothermal reaction.&lt;SEP&gt;Small media refers to the use of smaller milling particles during in situ milling experiments.</data>
  <data key="d3">doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-007&lt;SEP&gt;doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792426483</data>
  <data key="d6"></data>
</node>
<node id="Large Media">
  <data key="d0">Large Media</data>
  <data key="d1">artifact</data>
  <data key="d2">Large Media is spherical stainless-steel milling media with a 1-inch diameter used in the hydrothermal reaction.&lt;SEP&gt;Large media refers to the use of larger milling particles during in situ milling experiments.</data>
  <data key="d3">doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-007&lt;SEP&gt;doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-006</data>
