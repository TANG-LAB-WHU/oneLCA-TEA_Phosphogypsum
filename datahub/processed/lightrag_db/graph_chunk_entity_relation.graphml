  <data key="d0">Alva et al.</data>
  <data key="d1">person</data>
  <data key="d2">Alva et al. are researchers who supported findings that fluoride from phosphogypsum is largely adsorbed in topsoil under acidic conditions.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-033</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791189785</data>
  <data key="d6"></data>
