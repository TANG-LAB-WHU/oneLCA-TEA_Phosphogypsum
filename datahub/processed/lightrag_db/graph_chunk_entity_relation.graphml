<node id="Waste Phosphogypsum">
  <data key="d0">Waste Phosphogypsum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Waste phosphogypsum is a byproduct used as a stabilization material for adobe samples.&lt;SEP&gt;Waste phosphogypsum is the raw material source used to synthesize the hydroxyapatite structures.&lt;SEP&gt;Waste phosphogypsum is the raw material source used to synthesize the hydroxyapatite structures.</data>
  <data key="d3">doc-e4a551024f80f822f3f35e38ec278151-chunk-003&lt;SEP&gt;doc-3fd8439e859e3dd0c96328384e1761f0-chunk-015&lt;SEP&gt;doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792189824</data>
