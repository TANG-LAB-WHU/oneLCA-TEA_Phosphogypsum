<node id="CFD Simulation">
  <data key="d0">CFD Simulation</data>
  <data key="d1">method</data>
  <data key="d2">CFD simulation is a computational technique used to model and analyze the full-loop dynamics of chemical looping gasification systems.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-024</data>
