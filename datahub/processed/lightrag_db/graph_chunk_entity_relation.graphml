</node>
<node id="Ion Association">
  <data key="d0">Ion Association</data>
  <data key="d1">concept</data>
  <data key="d2">Ion association in soil solution is a chemical process that passivates heavy metals.</data>
  <data key="d3">doc-25198f8665e133385fd54e5a03e28a44-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792345098</data>
  <data key="d6"></data>
</node>
<node id="Soil Water Regime">
  <data key="d0">Soil Water Regime</data>
  <data key="d1">concept</data>
  <data key="d2">The soil water regime acts as a driver for either dangerous soil pollution or its passivation.&lt;SEP&gt;A soil condition that drives either dangerous pollution or pollution passivation.</data>
  <data key="d3">doc-25198f8665e133385fd54e5a03e28a44-chunk-007&lt;SEP&gt;doc-25198f8665e133385fd54e5a03e28a44-chunk-008</data>
