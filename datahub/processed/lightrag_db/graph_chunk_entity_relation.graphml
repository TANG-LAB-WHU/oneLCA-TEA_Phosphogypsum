<node id="Transmission electron microscopy">
  <data key="d0">Transmission electron microscopy</data>
  <data key="d1">method</data>
  <data key="d2">Transmission electron microscopy is performed using a field emission gun operating at 200 kV.&lt;SEP&gt;Transmission electron microscopy is a characterization method used to investigate hydroxyapatite properties.&lt;SEP&gt;A microscopy technique used for detailed characterization of samples at high magnification.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001&lt;SEP&gt;doc-6825862084b162a4b16cd1037c76e3d7-chunk-001&lt;SEP&gt;doc-6825862084b162a4b16cd1037c76e3d7-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791627759</data>
  <data key="d6"></data>
</node>
<node id="Powder X-ray diffraction">
  <data key="d0">Powder X-ray diffraction</data>
  <data key="d1">method</data>
  <data key="d2">Powder X-ray diffraction is used to record diffraction patterns between 10° and 70° with a scanning rate of 1°/min.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791260482</data>
