</node>
<node id="Adeogun">
  <data key="d0">Adeogun</data>
  <data key="d1">person</data>
  <data key="d2">Adeogun utilized poultry eggshell-derived hydroxyapatite to eliminate Reactive Yellow 4 dye.</data>
