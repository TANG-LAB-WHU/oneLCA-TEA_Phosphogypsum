</node>
<node id="Benefit Indicators">
  <data key="d0">Benefit Indicators</data>
  <data key="d1">concept</data>
  <data key="d2">Benefit Indicators are metrics where higher values are preferred, normalized using a specific range transformation formula.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792160084</data>
  <data key="d6"></data>
</node>
<node id="Cost Indicators">
  <data key="d0">Cost Indicators</data>
  <data key="d1">concept</data>
  <data key="d2">Cost Indicators are metrics where lower values are preferred, normalized using an inverse range transformation formula.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792160084</data>
  <data key="d6"></data>
</node>
<node id="Risk-Seeking Decision-Makers">
  <data key="d0">Risk-Seeking Decision-Makers</data>
  <data key="d1">person</data>
  <data key="d2">Risk-Seeking Decision-Makers are individuals sensitive to interests but slow to respond to losses, characterized by a risk attitude parameter greater than 0.5.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792160084</data>
  <data key="d6"></data>
</node>
