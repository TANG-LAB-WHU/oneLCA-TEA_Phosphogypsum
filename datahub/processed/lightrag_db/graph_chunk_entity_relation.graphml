<node id="MPG Preparation Process">
  <data key="d0">MPG Preparation Process</data>
  <data key="d1">method</data>
  <data key="d2">The MPG preparation process involves drying at specific temperatures, electromagnetic pulverization, and sieving to produce modified phosphogypsum powder.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792294020</data>
  <data key="d6"></data>
</node>
<node id="Electromagnetic Pulverizer">
  <data key="d0">Electromagnetic Pulverizer</data>
  <data key="d1">artifact</data>
  <data key="d2">An electromagnetic pulverizer is used to grind the dried phosphogypsum for a duration of 3 minutes.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792294020</data>
  <data key="d6"></data>
