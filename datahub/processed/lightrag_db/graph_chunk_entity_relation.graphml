<node id="H2S">
  <data key="d0">H2S</data>
  <data key="d1">naturalobject</data>
  <data key="d2">H2S assists in a two-step cyclic sulfur-looping process for CO2 capture and phosphogypsum thermal decomposition.</data>
  <data key="d3">doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-055</data>
  <data key="d4">unknown_source</data>
