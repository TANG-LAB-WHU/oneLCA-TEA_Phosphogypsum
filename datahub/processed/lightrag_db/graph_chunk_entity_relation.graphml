<node id="Soil Complex Components">
  <data key="d0">Soil Complex Components</data>
  <data key="d1">location</data>
  <data key="d2">Soil Complex Components are the structural parts of the soil between which salts transfer laterally.&lt;SEP&gt;Soil Complex Components are the structural parts of the soil between which salts transfer laterally.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-010&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-010</data>
