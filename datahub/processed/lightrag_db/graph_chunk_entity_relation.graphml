  <data key="d0">Francolite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Francolite is the amorphous form of apatite found in sedimentary phosphorites, exhibiting extensive elemental substitutions.&lt;SEP&gt;Francolite is the amorphous form of apatite found within sedimentary phosphorites.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-002&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-001</data>
