</node>
<node id="Range Transformation Method">
  <data key="d0">Range Transformation Method</data>
  <data key="d1">method</data>
  <data key="d2">Range Transformation Method is a technique employed to normalize indicators for both benefit and cost categories.&lt;SEP&gt;A technique used to normalize indicators due to limitations in equation coefficient calculations.</data>
  <data key="d3">doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-005&lt;SEP&gt;doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792160084</data>
