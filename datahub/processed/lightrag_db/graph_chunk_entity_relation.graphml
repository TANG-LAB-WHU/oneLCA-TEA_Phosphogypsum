<node id="Ion Pairs">
  <data key="d0">Ion Pairs</data>
  <data key="d1">concept</data>
  <data key="d2">Ion pairs are chemical associations in soil solution considered when calculating ion forms and equilibrium.&lt;SEP&gt;Ion pairs are chemical associations in soil solution considered when calculating ion forms and equilibrium.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-000&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-000</data>
