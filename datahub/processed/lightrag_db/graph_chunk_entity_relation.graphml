  <data key="d6"></data>
</node>
<node id="Qu">
  <data key="d0">Qu</data>
  <data key="d1">person</data>
  <data key="d2">Qu is a researcher who demonstrated the recyclability of copper-doped hydroxyapatite in formaldehyde oxidation.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-020</data>
