<node id="Soluble Contaminants">
  <data key="d0">Soluble Contaminants</data>
  <data key="d1">concept</data>
  <data key="d2">Soluble contaminants are impurities in phosphogypsum, including fluorine and phosphorus, that are targeted for removal during treatment.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-009</data>
