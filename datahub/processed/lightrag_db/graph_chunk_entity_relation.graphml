2&lt;SEP&gt;doc-06f299b7e723cda1f0de1a647b02b6b4-chunk-018&lt;SEP&gt;doc-06f299b7e723cda1f0de1a647b02b6b4-chunk-003&lt;SEP&gt;doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-003&lt;SEP&gt;doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-001&lt;SEP&gt;doc-d4a38fcc1b0f33a17d23e7a4407a9cf9-chunk-002&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-001&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-000&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-003&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-001&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-004&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-005</data>
