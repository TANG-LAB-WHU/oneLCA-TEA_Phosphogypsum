  <data key="d5">1791876031</data>
  <data key="d6"></data>
</node>
<node id="United States Geological Survey">
  <data key="d0">United States Geological Survey</data>
  <data key="d1">organization</data>
  <data key="d2">United States Geological Survey is an agency that estimates global phosphate rock reserves and mining volumes.&lt;SEP&gt;The United States Geological Survey is the organization that provided the database for worldwide phosphate ore excavation data.&lt;SEP&gt;A scientific agency that collected and published water-quality and hydrogeologic data for phosphate disposal sites.&lt;SEP&gt;The United States Geological Survey developed the Phreeqc program used for geochemical modeling.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-000&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-001&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-040&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-017</data>
  <data key="d4">unknown_source</data>
