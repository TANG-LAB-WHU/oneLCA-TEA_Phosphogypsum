  <data key="d6"></data>
</node>
<node id="TG-DTA Curves">
  <data key="d0">TG-DTA Curves</data>
  <data key="d1">data</data>
  <data key="d2">Thermal analysis data showing weight loss and endothermic peaks corresponding to decomposition and dehydration temperatures.&lt;SEP&gt;TG-DTA curves are analytical techniques used to evaluate the thermal properties of synthetic and commercial calcium carbonate.</data>
  <data key="d3">doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-010&lt;SEP&gt;doc-80e3f6300e001922a5ca2a6a8ac2e0d2-chunk-012</data>
