  <data key="d0">Cao et al.</data>
  <data key="d1">person</data>
  <data key="d2">Cao et al. are researchers who investigated sodium chloride-added hydroxyapatite/silk fibroin composites for bone tissue repair.&lt;SEP&gt;Researchers who explored application technologies for recycled PG.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-001&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-001</data>
  <data key="d4">unknown_source</data>
