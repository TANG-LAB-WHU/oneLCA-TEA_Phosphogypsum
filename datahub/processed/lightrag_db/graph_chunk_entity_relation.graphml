<edge source="Phosphogypsum" target="Alkalis">
  <data key="d7">2.0</data>
  <data key="d8">Phosphogypsum contains alkalis that are targeted for reduction to make the material suitable for cement and plaster manufacture.&lt;SEP&gt;Phosphogypsum contains alkalis as residual impurities that are targeted for removal.</data>
  <data key="d9">chemical composition,contains impurity</data>
  <data key="d10">doc-001fe856b0d193d82422dc8a5baedc86-chunk-004&lt;SEP&gt;doc-001fe856b0d193d82422dc8a5baedc86-chunk-000</data>
