<node id="Intra-soil Passivation">
  <data key="d0">Intra-soil Passivation</data>
  <data key="d1">method</data>
  <data key="d2">Intra-soil passivation is a technique that reduces the uncontrolled spread of dangerous substances in the environment.&lt;SEP&gt;Intra-soil passivation is a technique that reduces the uncontrolled spread of dangerous substances in the environment.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-000&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-000</data>
