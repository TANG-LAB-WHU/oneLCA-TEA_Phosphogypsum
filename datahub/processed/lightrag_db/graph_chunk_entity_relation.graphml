<node id="Okucu">
  <data key="d0">Okucu</data>
  <data key="d1">person</data>
  <data key="d2">Okucu co-investigated the effects of phosphogypsum on the dry unit weight of binder mixtures with Değirmenci.&lt;SEP&gt;Okucu is a researcher who co-authored a study on the effects of calcined phosphogypsum on water absorption.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-006&lt;SEP&gt;doc-819484fd12a30d085e4eb297904c9e2b-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792450297</data>
