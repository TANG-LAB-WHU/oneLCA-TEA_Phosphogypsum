  <data key="d0">Square-Hole Sieve</data>
  <data key="d1">artifact</data>
  <data key="d2">A square-hole sieve with a 0.2 mm mesh size is employed to verify that surplus building gypsum powder does not exceed 10%.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-003</data>
  <data key="d4">unknown_source</data>
