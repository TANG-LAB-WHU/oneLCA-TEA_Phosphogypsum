<node id="Phosphate Compounds">
  <data key="d0">Phosphate Compounds</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A class of chemical substances handled in industrial processes where the described reaction occurs.&lt;SEP&gt;Phosphate compounds are impurities in phosphogypsum that contribute to material performance decline and environmental eutrophication.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-011&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-001</data>
