  <data key="d1">artifact</data>
  <data key="d2">Construction structure evaluated for stability using E2 Mix materials at heights under 8 meters.</data>
  <data key="d3">doc-160a0fe95f7c82b193c6af751106ab6d-chunk-011</data>
  <data key="d4">unknown_source</data>
