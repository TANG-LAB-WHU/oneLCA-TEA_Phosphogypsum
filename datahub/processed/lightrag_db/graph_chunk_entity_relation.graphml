<node id="Loading Rate">
  <data key="d0">Loading Rate</data>
  <data key="d1">data</data>
  <data key="d2">Loading Rate is the speed at which pressure is applied during compressive strength testing, set at 1 mm/s.&lt;SEP&gt;The loading rate of 0.5 kN/s is applied during compressive strength tests.</data>
  <data key="d3">doc-7797768798fcd1152bdc10ff73139e35-chunk-003&lt;SEP&gt;doc-e4a551024f80f822f3f35e38ec278151-chunk-002</data>
