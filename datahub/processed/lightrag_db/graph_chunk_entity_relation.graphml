<node id="Heavy REE">
  <data key="d0">Heavy REE</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Heavy rare earth elements (Gd to Lu) that are preferentially partitioned into phosphoric acid during processing.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188559</data>
  <data key="d6"></data>
</node>
<node id="Light REE">
  <data key="d0">Light REE</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Light rare earth elements (La to Sm) that are less preferentially partitioned into phosphoric acid compared to heavy REE.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188559</data>
  <data key="d6"></data>
</node>
<node id="Actinium Decay Series">
  <data key="d0">Actinium Decay Series</data>
  <data key="d1">concept</data>
  <data key="d2">A natural radioactive decay series originating from U-235, noted for its shorter half-life and reduced abundance.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188559</data>
  <data key="d6"></data>
</node>
<node id="Sedimentary Phosphate Ores">
  <data key="d0">Sedimentary Phosphate Ores</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A type of phosphate rock deposit characterized by usually low thorium content.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
  <data key="d6"></data>
</node>
<node id="Igneous Phosphate Rock Deposits">
  <data key="d0">Igneous Phosphate Rock Deposits</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A type of phosphate rock deposit where thorium content is higher and considered an environmental concern.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
