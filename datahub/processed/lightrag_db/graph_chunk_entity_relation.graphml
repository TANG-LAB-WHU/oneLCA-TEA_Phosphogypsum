<node id="Calcium phosphate">
  <data key="d0">Calcium phosphate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium phosphate is a compound formed as a protective coating on cement grains due to phosphogypsum impurities.</data>
