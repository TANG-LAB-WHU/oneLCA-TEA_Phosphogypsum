<node id="Alkaline solubilization">
  <data key="d0">Alkaline solubilization</data>
  <data key="d1">method</data>
  <data key="d2">Alkaline solubilization is a treatment process using sodium EDTA to solubilize the gypsum phase.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-000</data>
