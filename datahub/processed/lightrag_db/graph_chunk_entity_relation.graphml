  <data key="d0">Hydrosol</data>
  <data key="d1">concept</data>
  <data key="d2">Hydrosol is a stage following the complex compound in the colloid theory pathway.</data>
  <data key="d3">doc-98d8b2df45924e721bfa570f652f33e3-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791673626</data>
  <data key="d6"></data>
