  <data key="d0">Hubei Xiangyun</data>
  <data key="d1">organization</data>
  <data key="d2">Hubei Xiangyun operates a 5 Mt/yr comprehensive utilization project for phosphogypsum.</data>
  <data key="d3">doc-a5d09b48f57a4e888bb729aaf988c936-chunk-008</data>
