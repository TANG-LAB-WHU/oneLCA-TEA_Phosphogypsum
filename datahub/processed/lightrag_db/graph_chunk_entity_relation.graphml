<node id="Calcium Sulphate">
  <data key="d0">Calcium Sulphate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium Sulphate is identified as the main phase composition of PG waste through spectroscopic and diffraction analyses.&lt;SEP&gt;Calcium sulphate constitutes approximately 92% of the main phase composition of phosphogypsum waste.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-004&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-003</data>
