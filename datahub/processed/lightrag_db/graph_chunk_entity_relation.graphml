  <data key="d0">Al2O3</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aluminum oxide is a chemical component found in cement clinker, granulated slag, and phosphogypsum.&lt;SEP&gt;A chemical compound listed in the concentration table with an average value of 4536.63 ppm.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-001&lt;SEP&gt;doc-26bca3d4f742299ce2dbcd6381558f89-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790984452</data>
  <data key="d6"></data>
</node>
<node id="Fe2O3">
  <data key="d0">Fe2O3</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Iron oxide is a chemical component present in cement clinker and phosphogypsum.&lt;SEP&gt;A chemical compound listed in the concentration table with an average value of 990.65 ppm.&lt;SEP&gt;Fe2O3 is an iron oxide component used in mixed oxygen carriers for chemical looping combustion.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-001&lt;SEP&gt;doc-26bca3d4f742299ce2dbcd6381558f89-chunk-010&lt;SEP&gt;doc-a3152ce135edc56e14c47e05535e05c7-chunk-026</data>
