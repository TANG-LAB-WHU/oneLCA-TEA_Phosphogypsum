</node>
<node id="Hydrocyclone Purification">
  <data key="d0">Hydrocyclone Purification</data>
  <data key="d1">method</data>
  <data key="d2">A treatment process that mixes PG with water to solubilize impurities, separating them into underflow and overflow fractions.</data>
