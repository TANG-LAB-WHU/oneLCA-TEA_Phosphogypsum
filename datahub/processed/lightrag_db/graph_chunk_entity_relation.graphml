<node id="Dissolution Characteristics">
  <data key="d0">Dissolution Characteristics</data>
  <data key="d1">concept</data>
  <data key="d2">Dissolution characteristics describe how radionuclides like radium-226 break down and release from phosphogypsum matrices.</data>
  <data key="d3">doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-010</data>
