<node id="Sedimentary Phosphate Ores">
  <data key="d0">Sedimentary Phosphate Ores</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A type of phosphate rock deposit characterized by usually low thorium content.&lt;SEP&gt;Sedimentary phosphate ores are naturally enriched in radioactive elements, characterized by high uranium and radium concentrations.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-009&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-011</data>
