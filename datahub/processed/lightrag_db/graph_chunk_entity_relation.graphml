  <data key="d1">artifact</data>
  <data key="d2">The specific market-purchased cement binder designated for use in the material tests.&lt;SEP&gt;A market-purchased ordinary silicate cement used in the experimental mixture.</data>
  <data key="d3">doc-7797768798fcd1152bdc10ff73139e35-chunk-002&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-001</data>
