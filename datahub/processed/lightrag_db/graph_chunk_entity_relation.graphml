<node id="PGA(L)">
  <data key="d0">PGA(L)</data>
  <data key="d1">concept</data>
  <data key="d2">PGA(L) is the liquid phase discarded after the dissolution of phosphogypsum and caustic liquid waste.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
