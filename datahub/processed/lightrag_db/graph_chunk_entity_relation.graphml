  <data key="d4">unknown_source</data>
  <data key="d5">1791450501</data>
  <data key="d6"></data>
</node>
<node id="Universities">
  <data key="d0">Universities</data>
  <data key="d1">organization</data>
  <data key="d2">Academic institutions that contribute as auxiliary components to collaborative technological R&amp;D teams.&lt;SEP&gt;Universities are academic institutions that contribute as auxiliary components in collaborative technological R&amp;D teams.&lt;SEP&gt;Universities collaborate with enterprises and research institutes to intensify R&amp;D efforts for phosphogypsum resource utilization.</data>
  <data key="d3">doc-c2674917fb6c60e75303effeaa10768e-chunk-009&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-008&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-015</data>
