  <data key="d1">method</data>
  <data key="d2">Magnetic Stirring is a mixing technique applied during the aging process at 80 ◦C.&lt;SEP&gt;Magnetic stirring is used to continuously mix the solution during pH adjustment and reagent addition.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002&lt;SEP&gt;doc-c4a64a852097fdc910b98ed788503ce4-chunk-001&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791986136</data>
  <data key="d6"></data>
</node>
<node id="Aging">
  <data key="d0">Aging</data>
  <data key="d1">method</data>
  <data key="d2">Aging is a process where the precursor solution is held at 80 ◦C for 2 hours before further synthesis.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Bruker D8 Advance">
  <data key="d0">Bruker D8 Advance</data>
  <data key="d1">artifact</data>
  <data key="d2">The Bruker D8 Advance is the specific X-ray diffraction instrument used to analyze crystalline phases.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="CuK-alpha Radiation">
  <data key="d0">CuK-alpha Radiation</data>
  <data key="d1">naturalobject</data>
  <data key="d2">CuK-alpha Radiation is the X-ray source (wavelength 1.5404 Å) used in the X-ray diffraction analysis.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Shimadzu IR-Prestige 21">
  <data key="d0">Shimadzu IR-Prestige 21</data>
  <data key="d1">artifact</data>
  <data key="d2">The Shimadzu IR-Prestige 21 is the specific Fourier transform infrared spectrometer used for functional group analysis.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Oven Drying">
  <data key="d0">Oven Drying</data>
  <data key="d1">method</data>
  <data key="d2">Oven Drying is a post-synthesis process where the solid product is dried at 100 ◦C for 24 hours.&lt;SEP&gt;Oven drying is a process where samples are heated at 105°C to constant weight for dry unit weight determination.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002&lt;SEP&gt;doc-e4a551024f80f822f3f35e38ec278151-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791735089</data>
  <data key="d6"></data>
</node>
<node id="Feathstone et al.">
  <data key="d0">Feathstone et al.</data>
  <data key="d1">person</data>
  <data key="d2">Feathstone et al. are the authors who proposed the equation used to calculate carbonate content from FTIR results.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Extinction Coefficients">
  <data key="d0">Extinction Coefficients</data>
  <data key="d1">data</data>
  <data key="d2">Extinction Coefficients are spectral parameters obtained from FTIR bands used to calculate carbonate content.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Nanostructures">
  <data key="d0">Nanostructures</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nanostructures are elongated, rod-like material clusters observed via electron microscopy, exhibiting a granular surface texture.&lt;SEP&gt;Elongated, needle-like structures displayed in the TEM micrograph.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009&lt;SEP&gt;doc-6f5dcf59bedaa00614f1acc222b1fb7b-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791543397</data>
  <data key="d6"></data>
</node>
<node id="Nanowires">
  <data key="d0">Nanowires</data>
  <data key="d1">artifact</data>
  <data key="d2">Nanowires are a type of nanostructure similar to nanorods, appearing as elongated structures within the aggregated sample cluster.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Calibration Equation">
  <data key="d0">Calibration Equation</data>
  <data key="d1">content</data>
  <data key="d2">Calibration Equation is a mathematical formula used to calculate the exact percentage of carbonate impurity from FTIR spectral ratios.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Sample Label">
  <data key="d0">Sample Label</data>
  <data key="d1">content</data>
  <data key="d2">Sample Label is text reading MW11-36min that identifies the sample and indicates its microwave treatment duration.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Phase Transformation">
  <data key="d0">Phase Transformation</data>
  <data key="d1">concept</data>
  <data key="d2">Phase Transformation is a material change process induced by microwave irradiation, leading to the observed nanostructure morphology.&lt;SEP&gt;The structural and chemical changes occurring during the reduction process, critical for understanding desulfurization efficiency.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792098909</data>
  <data key="d6"></data>
</node>
<node id="Integrated Intensity">
  <data key="d0">Integrated Intensity</data>
  <data key="d1">data</data>
  <data key="d2">Integrated Intensity represents the area under spectral peaks, used as the numerator and denominator in the calibration equation.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="Absorption Peak">
  <data key="d0">Absorption Peak</data>
  <data key="d1">data</data>
  <data key="d2">Absorption Peak refers to specific points in the infrared spectrum at 1458 cm⁻¹ and 604 cm⁻¹ corresponding to molecular vibrations.&lt;SEP&gt;Absorption peak at 3437.8 cm^-1 corresponds to the stretching and bending vibration of H-O bonds.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009&lt;SEP&gt;doc-98d8b2df45924e721bfa570f652f33e3-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791673877</data>
  <data key="d6"></data>
</node>
<node id="Energy Parameter">
  <data key="d0">Energy Parameter</data>
  <data key="d1">concept</data>
  <data key="d2">Energy Parameter is a variable representing spectral intensity values at specific wavenumbers in the logarithmic ratio equation.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="1458 cm⁻¹">
  <data key="d0">1458 cm⁻¹</data>
  <data key="d1">data</data>
  <data key="d2">1458 cm⁻¹ is the wavenumber characteristic of the asymmetric stretching vibration of carbonate ions.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="604 cm⁻¹">
  <data key="d0">604 cm⁻¹</data>
  <data key="d1">data</data>
  <data key="d2">604 cm⁻¹ is the wavenumber characteristic of the bending vibration of sulfate groups.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
  <data key="d6"></data>
</node>
<node id="T1">
  <data key="d0">T1</data>
  <data key="d1">data</data>
  <data key="d2">T1 is a temperature variable used in the logarithmic ratio equation for energy parameters.&lt;SEP&gt;T1 is a sample ID corresponding to microspheres synthesized for 1 hour of hydrothermal time.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985846</data>
  <data key="d6"></data>
</node>
<node id="T2">
  <data key="d0">T2</data>
  <data key="d1">data</data>
  <data key="d2">T2 is a temperature variable used in the logarithmic ratio equation for energy parameters.&lt;SEP&gt;T2 is a sample ID corresponding to microspheres synthesized for 2 hours of hydrothermal time.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-009&lt;SEP&gt;doc-54b92b2ad16a2528ff6a863329c5d403-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985846</data>
  <data key="d6"></data>
</node>
