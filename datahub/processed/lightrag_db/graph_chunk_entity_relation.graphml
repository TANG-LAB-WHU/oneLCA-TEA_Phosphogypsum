  <data key="d0">Leachates</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Leachates are the liquid solutions extracted from the filling body that contain measured concentrations of heavy metal ions.&lt;SEP&gt;Leachates are</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-022&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792039718</data>
