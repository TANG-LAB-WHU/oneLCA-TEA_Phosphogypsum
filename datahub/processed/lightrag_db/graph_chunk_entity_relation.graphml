<node id="Linear Intercept Method">
  <data key="d0">Linear Intercept Method</data>
  <data key="d1">method</data>
  <data key="d2">A standardized procedure used to determine the grain size of the tested samples according to ASTM standards.&lt;SEP&gt;A measurement technique applied to determine the average grain size of the material from micrographs.&lt;SEP&gt;Linear Intercept Method is a measurement technique used to determine the average grain size of the composite samples.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-011&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-004&lt;SEP&gt;doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-010</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791060605</data>
