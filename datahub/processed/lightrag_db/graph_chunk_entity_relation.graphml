<node id="Geological Fluorapatite">
  <data key="d0">Geological Fluorapatite</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Geological fluorapatite is a mineral used in conjunction with fungi to immobilize heavy metals like lead in environmental remediation.&lt;SEP&gt;A mineral used in conjunction with fungi for heavy metal immobilization.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-018&lt;SEP&gt;doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-019</data>
