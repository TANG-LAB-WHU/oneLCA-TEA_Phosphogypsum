  <data key="d4">unknown_source</data>
  <data key="d5">1792002021</data>
  <data key="d6"></data>
</node>
<node id="TG/DSC Curves">
  <data key="d0">TG/DSC Curves</data>
  <data key="d1">data</data>
  <data key="d2">TG/DSC Curves represent thermal analysis data showing the behavior of dried HAP under temperature changes.&lt;SEP&gt;TG/DSC Curves display multiple weight loss steps and thermal changes of dried Hydroxyapatite across different temperature ranges.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002483</data>
  <data key="d6"></data>
</node>
<node id="Ammonium Group">
  <data key="d0">Ammonium Group</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ammonium Group is a chemical component of ammonium sulfate, showing deformation and stretch absorption bands.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Pyrophosphate Group">
  <data key="d0">Pyrophosphate Group</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Pyrophosphate Group is a chemical moiety detected via FTIR analysis, attributed to an absorption band after HAP treatment.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Calcium-Deficient HAP">
  <data key="d0">Calcium-Deficient HAP</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calcium-Deficient HAP is a variant of HAP where hydrogen phosphate condensation occurs at temperatures below 1000°C.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Reference Material">
  <data key="d0">Reference Material</data>
  <data key="d1">content</data>
  <data key="d2">Reference Material is an analytical grade ammonium sulfate used for comparison with the prepared sample.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Infrared Transmittance Spectrum">
  <data key="d0">Infrared Transmittance Spectrum</data>
  <data key="d1">content</data>
  <data key="d2">A scientific graph plotting infrared light transmittance against wavenumber to identify chemical bonds and functional groups.&lt;SEP&gt;A scientific graph plotting infrared light transmittance against wavenumber to analyze material properties.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Thermogravimetric Data">
  <data key="d0">Thermogravimetric Data</data>
  <data key="d1">data</data>
  <data key="d2">A dataset plotting mass percentage against temperature to track mass loss during heating.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Differential Scanning Calorimetry Data">
  <data key="d0">Differential Scanning Calorimetry Data</data>
  <data key="d1">data</data>
  <data key="d2">A dataset plotting heat flow against temperature to identify thermal processes like endothermic events.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="DSC Curve">
  <data key="d0">DSC Curve</data>
  <data key="d1">concept</data>
  <data key="d2">A blue dotted line representing heat flow, showing an endothermic process correlated with mass loss.&lt;SEP&gt;DSC Curve is a thermal analysis technique that identifies endothermic and exothermic peaks during the heating of phosphogypsum.&lt;SEP&gt;The DSC curve is a thermal analysis tool that records endothermic and exothermic effects corresponding to molecular water departure and phase changes.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007&lt;SEP&gt;doc-ad247a75dda6243453b4132b71670203-chunk-002&lt;SEP&gt;doc-f3d20c90c2a00342300c9b55c3e29f23-chunk-018</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792402834</data>
  <data key="d6"></data>
</node>
<node id="N-H Stretching Vibrations">
  <data key="d0">N-H Stretching Vibrations</data>
  <data key="d1">concept</data>
  <data key="d2">N-H stretching vibrations correspond to the broad absorption dip around 3000–3300 cm⁻¹ in the ammonium ion spectrum.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002686</data>
  <data key="d6"></data>
</node>
<node id="Bending Vibration">
  <data key="d0">Bending Vibration</data>
  <data key="d1">concept</data>
  <data key="d2">Bending vibration corresponds to sharp peaks around 1400–1500 cm⁻¹ for ammonium and 600 cm⁻¹ for sulfate.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002844</data>
  <data key="d6"></data>
</node>
<node id="Heat Flow">
  <data key="d0">Heat Flow</data>
  <data key="d1">data</data>
  <data key="d2">Heat flow is the thermal property measured in mW/g and plotted on the right Y-axis of the dual-axis graph.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792002844</data>
  <data key="d6"></data>
</node>
<node id="Mass Percentage">
  <data key="d0">Mass Percentage</data>
  <data key="d1">data</data>
  <data key="d2">Mass percentage represents the percentage of mass remaining, plotted on the left Y-axis of the thermogravimetric graph.&lt;SEP&gt;A vertical axis variable representing the remaining mass in weight percent, ranging from 40% to 100%.</data>
  <data key="d3">doc-35aef6efc801611130c5dd196fe513df-chunk-007&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-021</data>
