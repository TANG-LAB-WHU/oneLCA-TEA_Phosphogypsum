  <data key="d0">Mechanical Pressure</data>
  <data key="d1">method</data>
  <data key="d2">Mechanical pressure is applied during pellet preparation to form solid samples from powdery phosphogypsum.</data>
  <data key="d3">doc-8c22d31cfad5421c936a23705a3bc6e0-chunk-002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791498419</data>
  <data key="d6"></data>
