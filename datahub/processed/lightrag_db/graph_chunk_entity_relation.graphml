  <data key="d12">1791247839</data>
  <data key="d13"></data>
</edge>
<edge source="Hydroxyapatite" target="Hydroxyl Groups">
  <data key="d7">5.0</data>
  <data key="d8">Hydroxyl groups are hosted within specific crystal channels of hydroxyapatite to balance the matrix's positive charge.&lt;SEP&gt;Hydroxyl groups are integral structural components of hydroxyapatite that function as hard Lewis bases.&lt;SEP&gt;Hydroxyapatite contains hydroxyl groups bonded to channel calcium ions.&lt;SEP&gt;Hydroxyl groups are integral components of the hydroxyapatite lattice, responsible for specific vibrational modes.&lt;SEP&gt;Hydroxyl groups are structural components present in minimal quantities in bone hydroxyapatite.</data>
  <data key="d9">bonding,charge balance,chemical component,chemical composition,composition,hard Lewis base,structural component</data>
  <data key="d10">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-002&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-015&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-009&lt;SEP&gt;doc-f1fb5c243f2539cf7be6b6021b63c36f-chunk-004&lt;SEP&gt;doc-d4a38fcc1b0f33a17d23e7a4407a9cf9-chunk-009</data>
