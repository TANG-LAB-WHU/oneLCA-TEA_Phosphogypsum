<node id="Gatan 832 CCD Camera">
  <data key="d0">Gatan 832 CCD Camera</data>
  <data key="d1">artifact</data>
  <data key="d2">Gatan 832 CCD camera is used to digitally acquire images during transmission electron microscopy.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
