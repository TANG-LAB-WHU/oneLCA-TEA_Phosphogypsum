  <data key="d0">Plant B</data>
  <data key="d1">organization</data>
  <data key="d2">Plant B is an industrial facility where radioactive isotopes and process waters were sampled.&lt;SEP&gt;Plant B is an industrial site where radionuclide activities in phosphogypsum process water were measured.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-021&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-022</data>
  <data key="d4">unknown_source</data>
