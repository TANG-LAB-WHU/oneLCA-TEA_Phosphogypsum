  <data key="d0">Extra Ecological Services</data>
  <data key="d1">concept</data>
  <data key="d2">Extra Ecological Services represent a primary contributor to the impact of pollutant emissions.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-017</data>
