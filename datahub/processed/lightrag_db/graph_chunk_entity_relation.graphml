1&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-044&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-047&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-013&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-001&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-014&lt;SEP&gt;doc-7797768798fcd1152bdc10ff73139e35-chunk-015&lt;SEP&gt;doc-98d8b2df45924e721bfa570f652f33e3-chunk-004&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-012&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-025&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-020&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-026&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-035&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-013&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-007&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-001&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-011&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-036&lt;SEP&gt;doc-e4a551024f80f822f3f35e38ec278151-chunk-000&lt;SEP&gt;doc-b0ac8d630b9aa4d874707445e2552a09-chunk-020&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-013&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-014&lt;SEP&gt;doc-28fbd4302bba090e667215c840757ff7-chunk-001&lt;SEP&gt;doc-28fbd4302bba090e667215c840757ff7-chunk-006&lt;SEP&gt;doc-28fbd4302bba090e667215c840757ff7-chunk-000&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-000&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-001&lt;SEP&gt;doc-160a0fe95f7c82b193c6af751106ab6d-chunk-002&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-000&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-001&lt;SEP&gt;doc-b19ca721a4da4422ee10228d88a4c292-chunk-004&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-000&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-009&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-003&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-005&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-006&lt;