  <data key="d0">SRB Assay</data>
  <data key="d1">method</data>
  <data key="d2">A cost-effective and reproducible method for cell density determination and cytotoxicity screening using sulforhodamine B dye.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791060479</data>
