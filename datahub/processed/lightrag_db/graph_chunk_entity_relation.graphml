<node id="Calcination temperature">
  <data key="d0">Calcination temperature</data>
  <data key="d1">concept</data>
  <data key="d2">Calcination temperature is a processing parameter that affects the setting times of the A-PG II GGBFS system.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-017</data>
