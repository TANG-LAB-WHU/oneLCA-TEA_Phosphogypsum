<node id="Uranium-234">
  <data key="d0">Uranium-234</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Uranium-234 is a radioactive isotope measured in samples to calculate isotopic ratios with Uranium-238.&lt;SEP&gt;Uranium-234 is a radioisotope of uranium originally present in phosphate rock and retained in phosphogypsum.&lt;SEP&gt;A radioactive isotope derived from phosphate rocks that remains in phosphogypsum.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-007&lt;SEP&gt;doc-28fbd4302bba090e667215c840757ff7-chunk-001&lt;SEP&gt;doc-819484fd12a30d085e4eb297904c9e2b-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792455914</data>
  <data key="d6"></data>
