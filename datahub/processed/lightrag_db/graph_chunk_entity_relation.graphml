<node id="Hydroprocessing">
  <data key="d0">Hydroprocessing</data>
  <data key="d1">method</data>
  <data key="d2">Hydroprocessing is a catalytic chemical process used to remove sulfur compounds like thiophene and dibenzothiophene.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-027</data>
