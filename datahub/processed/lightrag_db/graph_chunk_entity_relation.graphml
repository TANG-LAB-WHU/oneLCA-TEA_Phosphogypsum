<node id="PG content">
  <data key="d0">PG content</data>
  <data key="d1">data</data>
  <data key="d2">PG content refers to the proportion of phosphogypsum in the mixture, which proportionally affects setting time.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-017</data>
