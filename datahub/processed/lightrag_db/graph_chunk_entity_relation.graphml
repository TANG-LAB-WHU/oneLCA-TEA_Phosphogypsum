<node id="Ellingham Diagram">
  <data key="d0">Ellingham Diagram</data>
  <data key="d1">artifact</data>
  <data key="d2">An Ellingham Diagram is a graphical tool used to screen suitable metals like cerium, iron, nickel, and copper for use with PG.&lt;SEP&gt;Ellingham Diagram is a graphical tool used to analyze the thermodynamic feasibility of Fe and Ni involvement in PG redox reactions.</data>
  <data key="d3">doc-a3152ce135edc56e14c47e05535e05c7-chunk-008&lt;SEP&gt;doc-a3152ce135edc56e14c47e05535e05c7-chunk-011</data>
