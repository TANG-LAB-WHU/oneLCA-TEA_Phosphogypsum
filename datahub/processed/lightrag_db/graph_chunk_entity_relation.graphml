  <data key="d0">2(θ°)</data>
  <data key="d1">data</data>
  <data key="d2">2(θ°) is the X-axis label representing the diffraction angle in degrees, ranging from approximately 5 to 80 degrees.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-039</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791365348</data>
