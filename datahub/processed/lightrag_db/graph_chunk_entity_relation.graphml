</node>
<node id="Methane Cycling">
  <data key="d0">Methane Cycling</data>
  <data key="d1">concept</data>
  <data key="d2">Methane Cycling describes the movement and transformation of methane within a flooded rice paddy ecosystem through various biological and physical pathways.</data>
  <data key="d3">doc-2eed3e4bb65f425c7011f91fbc1c7dd5-chunk-026</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790942862</data>
