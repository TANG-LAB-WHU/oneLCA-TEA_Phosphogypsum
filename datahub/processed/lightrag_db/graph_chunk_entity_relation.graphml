<node id="25.0% Fluoride Reduction">
  <data key="d0">25.0% Fluoride Reduction</data>
  <data key="d1">data</data>
  <data key="d2">The 25.0% fluoride reduction represents the impurity decrease achieved in phosphogypsum through calcium hydroxide chemical treatment.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-010</data>
