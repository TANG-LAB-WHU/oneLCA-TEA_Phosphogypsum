<node id="CCE Thermodynamic Mathematical Model">
  <data key="d0">CCE Thermodynamic Mathematical Model</data>
  <data key="d1">method</data>
  <data key="d2">The CCE Thermodynamic Mathematical Model is a computational framework used to calculate trace element content in soil solution.&lt;SEP&gt;The CCE Thermodynamic Mathematical Model is a computational framework used to calculate trace element content in soil solution.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-007&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-007</data>
