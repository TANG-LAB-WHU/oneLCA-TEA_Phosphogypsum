<node id="HAp microspheres">
  <data key="d0">HAp microspheres</data>
  <data key="d1">artifact</data>
  <data key="d2">HAp microspheres are spherical structures with a diameter of about 4 μm, composed of closely packed nanorods.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
