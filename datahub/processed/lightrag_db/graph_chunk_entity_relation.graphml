  <data key="d5">1790951395</data>
  <data key="d6"></data>
</node>
<node id="Amendments">
  <data key="d0">Amendments</data>
  <data key="d1">artifact</data>
  <data key="d2">Amendments are soil treatments that can introduce heavy metals into the environment.&lt;SEP&gt;Amendments are applied materials, such as pulp or granular matter, used to improve soil conditions and provide nutrients.&lt;SEP&gt;Amendments are soil treatments that can introduce heavy metals into the environment.&lt;SEP&gt;Amendments are applied materials, such as pulp or granular matter, used to improve soil conditions and provide nutrients.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-ce9090f230bcd0bfeefe92db7a576442-chunk-000&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-000</data>
