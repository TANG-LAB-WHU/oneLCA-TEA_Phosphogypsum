</node>
<node id="Equation (2)">
  <data key="d0">Equation (2)</data>
  <data key="d1">content</data>
  <data key="d2">Equation (2) provides an alternative calculation for the distribution ratio using initial and final concentrations and phase volumes.</data>
  <data key="d3">doc-edfc4dcbd74cbf0b294f83f2034b209d-chunk-002</data>
  <data key="d4">unknown_source</data>
