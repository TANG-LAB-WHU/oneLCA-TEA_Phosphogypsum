<node id="Contaminant Mobility">
  <data key="d0">Contaminant Mobility</data>
  <data key="d1">concept</data>
  <data key="d2">Contaminant Mobility represents the movement potential of pollutants, which precipitation aims to reduce.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-026</data>
