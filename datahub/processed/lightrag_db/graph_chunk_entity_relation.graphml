  <data key="d0">Pseudo-second-order Kinetics</data>
  <data key="d1">method</data>
  <data key="d2">A mathematical model used to describe the adsorption rate of heavy metal ions over time.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-006</data>
