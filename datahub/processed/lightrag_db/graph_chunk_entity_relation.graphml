<node id="Plant">
  <data key="d0">Plant</data>
  <data key="d1">creature</data>
  <data key="d2">Plants are biological organisms that absorb cadmium ions from the soil solution.&lt;SEP&gt;Organisms that benefit from improved soil health, higher resistivity to pathogens, and better environmental quality of biological production.&lt;SEP&gt;Plants are biological organisms that absorb cadmium ions from the soil solution.&lt;SEP&gt;Organisms that benefit from improved soil health, higher resistivity to pathogens, and better environmental quality of biological production.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-ce9090f230bcd0bfeefe92db7a576442-chunk-003&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790951395</data>
  <data key="d6"></data>
</node>
<node id="Pathogens">
  <data key="d0">Pathogens</data>
  <data key="d1">creature</data>
  <data key="d2">Disease-causing agents against which plants develop higher resistivity due to improved soil conditions.&lt;SEP&gt;Disease-causing agents against which plants develop higher resistivity due to improved soil conditions.</data>
  <data key="d3">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-014&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-014</data>
