<node id="Calcined 1000°C Sample">
  <data key="d0">Calcined 1000°C Sample</data>
  <data key="d1">artifact</data>
  <data key="d2">The calcined 1000°C sample is identified as the least effective material, showing significant instability in removal efficiency across different elements.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-040</data>
  <data key="d4">unknown_source</data>
