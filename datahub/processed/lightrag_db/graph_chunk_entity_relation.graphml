<node id="Protein Separation">
  <data key="d0">Protein Separation</data>
  <data key="d1">method</data>
  <data key="d2">Protein Separation is a process facilitated by hydroxyapatite's adsorption properties in chromatographic columns.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791247343</data>
  <data key="d6"></data>
