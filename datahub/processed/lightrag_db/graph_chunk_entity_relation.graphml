  <data key="d4">unknown_source</data>
  <data key="d5">1791673626</data>
  <data key="d6"></data>
</node>
<node id="Chemical Hydration Equation">
  <data key="d0">Chemical Hydration Equation</data>
  <data key="d1">content</data>
  <data key="d2">The chemical equation CaSO4·0.5H2O + 1.5H2O → CaSO4·2H2O + X represents the hydration reaction of hemihydrate gypsum.</data>
  <data key="d3">doc-98d8b2df45924e721bfa570f652f33e3-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791673626</data>
  <data key="d6"></data>
</node>
<node id="Solubility HG &gt; DG">
  <data key="d0">Solubility HG &gt; DG</data>
  <data key="d1">concept</data>
  <data key="d2">Solubility HG &gt; DG indicates that hemihydrate gypsum solubility is greater than dihydrate gypsum solubility.</data>
  <data key="d3">doc-98d8b2df45924e721bfa570f652f33e3-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791673626</data>
  <data key="d6"></data>
</node>
