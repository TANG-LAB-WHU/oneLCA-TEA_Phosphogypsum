  <data key="d1">naturalobject</data>
  <data key="d2">Lanthanum is a major rare earth element homogeneously dispersed on the surface of phosphogypsum and other concentrates.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-012</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790983967</data>
  <data key="d6"></data>
</node>
<node id="Cerium (Ce)">
  <data key="d0">Cerium (Ce)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cerium is a major rare earth element homogeneously dispersed on the surface of phosphogypsum and other concentrates.</data>
