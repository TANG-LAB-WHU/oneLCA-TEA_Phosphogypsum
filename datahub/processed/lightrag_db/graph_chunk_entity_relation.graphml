  <data key="d0">Saturation Solubility of Hemihydrate Gypsum</data>
  <data key="d1">concept</data>
  <data key="d2">Saturation solubility of hemihydrate gypsum is represented by a vertical dashed green line in the dissolution crystallization pathway.</data>
  <data key="d3">doc-98d8b2df45924e721bfa570f652f33e3-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791673626</data>
