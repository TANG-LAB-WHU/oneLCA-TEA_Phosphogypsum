</node>
<node id="Equation 6">
  <data key="d0">Equation 6</data>
  <data key="d1">content</data>
  <data key="d2">Equation 6 represents the chemical reaction transforming calcium sulfate hemihydrate and water into calcium sulfate dihydrate.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061208</data>
