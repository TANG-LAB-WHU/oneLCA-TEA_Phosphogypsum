  <data key="d0">Gas Adsorption</data>
  <data key="d1">method</data>
  <data key="d2">Gas Adsorption is a technique used to measure the surface areas of amorphous calcium phosphate and crystalline hydroxyapatite.</data>
  <data key="d3">doc-54b92b2ad16a2528ff6a863329c5d403-chunk-008</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791985383</data>
