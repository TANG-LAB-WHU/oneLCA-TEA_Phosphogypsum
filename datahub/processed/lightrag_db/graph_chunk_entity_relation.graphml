  <data key="d0">Bouchhima</data>
  <data key="d1">person</data>
  <data key="d2">Bouchhima studied the density of bricks manufactured using phosphogypsum, natural sand, cement, and hydraulic lime.</data>
  <data key="d3">doc-819484fd12a30d085e4eb297904c9e2b-chunk-006</data>
