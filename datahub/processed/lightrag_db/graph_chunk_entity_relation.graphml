<node id="Round-Hole Sieve">
  <data key="d0">Round-Hole Sieve</data>
  <data key="d1">artifact</data>
  <data key="d2">A round-hole sieve with a 0.075 mm mesh size is utilized during the sieving stage of the preparation process.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792294020</data>
