<node id="Change Rates">
  <data key="d0">Change Rates</data>
  <data key="d1">data</data>
  <data key="d2">Change rates quantify the percentage variation in emergy flows and total inputs across scenarios.&lt;SEP&gt;Change rates measure the percentage difference in scenario shares relative to Scenario 1.</data>
  <data key="d3">doc-1775dab65ef7445e05c5e396bcc0009b-chunk-011&lt;SEP&gt;doc-1775dab65ef7445e05c5e396bcc0009b-chunk-012</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792224994</data>
