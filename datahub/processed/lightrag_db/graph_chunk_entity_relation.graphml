  <data key="d0">Vienna</data>
  <data key="d1">location</data>
  <data key="d2">Vienna is the city where the International Atomic Energy Agency is located.&lt;SEP&gt;Vienna is the location where the IAEA published its safety reports on phosphate industry residues.</data>
  <data key="d3">doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-001&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-014</data>
