  <data key="d6"></data>
</node>
<node id="Holanda et al.">
  <data key="d0">Holanda et al.</data>
  <data key="d1">person</data>
  <data key="d2">Holanda et al. documented how soluble phosphorus prolongs setting time and reduces hydration products, deteriorating mechanical performance.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-012</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791719139</data>
  <data key="d6"></data>
</node>
<node id="GB/T 39489–2020">
  <data key="d0">GB/T 39489–2020</data>
  <data key="d1">content</data>
  <data key="d2">GB/T 39489–2020 is a national standard that defines the strength requirements for cementitious composite materials.&lt;SEP&gt;GB/T 39489–2020 is a standard that defines the strength requirements met by the optimal phosphogypsum content in cementitious composites.</data>
  <data key="d3">doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-012&lt;SEP&gt;doc-9c8cdabf609cc047d173d4ff8dbb5187-chunk-011</data>
