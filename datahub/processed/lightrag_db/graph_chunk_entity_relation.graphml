  <data key="d6"></data>
</node>
<node id="Rivers">
  <data key="d0">Rivers</data>
  <data key="d1">location</data>
  <data key="d2">Rivers are water bodies into which unused phosphogypsum is discharged.&lt;SEP&gt;Rivers are bodies of water where unused phosphogypsum and fly ash are currently discarded.&lt;SEP&gt;Rivers are natural water bodies where phosphogypsum and fly ash waste materials are currently discarded in Turkey.</data>
  <data key="d3">doc-eb86340ba0851c06e97600104fca25c9-chunk-001&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-000&lt;SEP&gt;doc-764bdde7c1b68efdbe7342cc41c2d3d4-chunk-006</data>
