2&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-012&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-014&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-007&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-008&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-003&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-006&lt;SEP&gt;doc-d18c456289f64c1e16c73a0dfd6595b3-chunk-011&lt;SEP&gt;doc-28fbd4302bba090e667215c840757ff7-chunk-001&lt;SEP&gt;doc-819484fd12a30d085e4eb297904c9e2b-chunk-001&lt;SEP&gt;doc-525daf613910500054a23427717dab1f-chunk-022&lt;SEP&gt;doc-525daf613910500054a23427717dab1f-chunk-005</data>
