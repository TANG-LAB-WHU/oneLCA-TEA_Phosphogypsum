  <data key="d10">doc-ce9090f230bcd0bfeefe92db7a576442-chunk-002&lt;SEP&gt;doc-ce9090f230bcd0bfeefe92db7a576442-chunk-001&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-001&lt;SEP&gt;doc-983b2c3f393a1de00521565a70363819-chunk-002&lt;SEP&gt;doc-401b567da916dc34559e0bfe5a5b367b-chunk-001&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-045&lt;SEP&gt;doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-000&lt;SEP&gt;doc-4c4b1b446b8362051476593a7c1a0d7c-chunk-019&lt;SEP&gt;doc-eb86340ba0851c06e97600104fca25c9-chunk-015&lt;SEP&gt;doc-eb86340ba0851c06e97600104fca25c9-chunk-021&lt;SEP&gt;doc-eb86340ba0851c06e97600104fca25c9-chunk-024&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-002&lt;SEP&gt;doc-0060991ac74a9675ce0293eccdc023cd-chunk-003&lt;SEP&gt;doc-35aef6efc801611130c5dd196fe513df-chunk-001&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-017&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-019&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-000&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-001&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-020&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-018&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-013</data>
