  <data key="d1">concept</data>
  <data key="d2">Volumetric heating is a rapid heating mechanism characteristic of microwave irradiation that accelerates material processing.</data>
  <data key="d3">doc-c4a64a852097fdc910b98ed788503ce4-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791530058</data>
