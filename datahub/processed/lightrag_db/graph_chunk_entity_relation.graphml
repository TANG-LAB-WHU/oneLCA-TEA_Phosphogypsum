</node>
<node id="Heat of Hydration">
  <data key="d0">Heat of Hydration</data>
  <data key="d1">data</data>
  <data key="d2">Heat of Hydration is a thermal property of Portland slag cement measured at 7 and 28 days, found within specified limits.</data>
