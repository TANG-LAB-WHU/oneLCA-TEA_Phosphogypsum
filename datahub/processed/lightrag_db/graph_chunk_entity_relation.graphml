</node>
<node id="Natural selenite gypsum">
  <data key="d0">Natural selenite gypsum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Natural selenite gypsum is a natural mineral used as a reference material for comparing cement setting times and strength.</data>
  <data key="d3">doc-001fe856b0d193d82422dc8a5baedc86-chunk-005</data>
