  <data key="d5">1791209442</data>
  <data key="d6"></data>
</node>
<node id="Filtrate Solution">
  <data key="d0">Filtrate Solution</data>
  <data key="d1">other</data>
  <data key="d2">The liquid phase separated from the solid phase during vacuum filtration.</data>
  <data key="d3">doc-26bca3d4f742299ce2dbcd6381558f89-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790983967</data>
