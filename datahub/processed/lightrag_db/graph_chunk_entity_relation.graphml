  <data key="d0">Flynn-Wall-Ozawa Method</data>
  <data key="d1">method</data>
  <data key="d2">The Flynn-Wall-Ozawa Method is used to confirm the mechanism model of phosphogypsum decomposition.</data>
  <data key="d3">doc-d5e4f0f96b4ad61d23685552d3211225-chunk-000</data>
  <data key="d4">unknown_source</data>
