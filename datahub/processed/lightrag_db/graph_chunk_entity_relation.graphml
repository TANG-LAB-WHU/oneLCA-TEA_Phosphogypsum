<node id="Carbon Dioxide Mitigation">
  <data key="d0">Carbon Dioxide Mitigation</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon Dioxide Mitigation represents the environmental goal of reducing greenhouse gas emissions associated with industrial processes.</data>
