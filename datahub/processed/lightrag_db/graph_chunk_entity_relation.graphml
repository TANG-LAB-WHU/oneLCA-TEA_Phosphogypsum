<node id="Phosphorus Cycle">
  <data key="d0">Phosphorus Cycle</data>
  <data key="d1">concept</data>
  <data key="d2">The natural process involving the release, transport, deposition, and tectonic movement of phosphorus, which is disrupted by phosphogypsum dumping.&lt;SEP&gt;A natural biogeochemical process disrupted by phosphogypsum accumulation.&lt;SEP&gt;The phosphorus cycle is the biogeochemical system analyzed for waste generation and recycling trends in China.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-011&lt;SEP&gt;doc-c2674917fb6c60e75303effeaa10768e-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791451491</data>
  <data key="d6"></data>
</node>
<node id="Phytoplankton">
  <data key="d0">Phytoplankton</data>
  <data key="d1">creature</data>
  <data key="d2">Phytoplankton are aquatic organisms whose living environment is disrupted by phosphogypsum-induced water pollution.&lt;SEP&gt;Aquatic primary producers whose growth is stimulated by appropriate phosphorus hydride levels but inhibited by excess, leading to frequent algal blooms near dumping sites.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007&lt;SEP&gt;doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109872</data>
  <data key="d6"></data>
</node>
<node id="Phosphorus Hydride">
  <data key="d0">Phosphorus Hydride</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A gas that stimulates phytoplankton growth at appropriate levels but inhibits it when excessive.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109872</data>
  <data key="d6"></data>
</node>
<node id="Bacteria and Actinomycetes">
  <data key="d0">Bacteria and Actinomycetes</data>
  <data key="d1">creature</data>
  <data key="d2">Microorganisms in the soil that thrive in neutral to alkaline conditions but suffer reduced activity due to phosphogypsum-induced acidity.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109872</data>
