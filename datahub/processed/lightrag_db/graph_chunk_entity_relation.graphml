  <data key="d2">Analytical techniques are used to examine the filtrate and evaluate the removal efficiencies of impurities.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-011</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791366062</data>
