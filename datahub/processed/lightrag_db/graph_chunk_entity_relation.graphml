  <data key="d0">Alendronate Sodium</data>
  <data key="d1">concept</data>
  <data key="d2">A chemical compound analyzed in tablets and utilized in drug delivery systems and biomedical coatings.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-016</data>
  <data key="d4">unknown_source</data>
