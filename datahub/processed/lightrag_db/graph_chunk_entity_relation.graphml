<node id="Nano-needle clusters">
  <data key="d0">Nano-needle clusters</data>
  <data key="d1">artifact</data>
  <data key="d2">Nano-needle clusters are the final product formed when the Ct/CTAB ratio increases, replacing nanorods.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791260482</data>
  <data key="d6"></data>
</node>
<node id="Micro-flakes">
  <data key="d0">Micro-flakes</data>
  <data key="d1">artifact</data>
  <data key="d2">Micro-flakes are structures with a diameter of approximately 2 μm that form when the Ct/CTAB ratio reaches 1/1.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791260482</data>
  <data key="d6"></data>
</node>
