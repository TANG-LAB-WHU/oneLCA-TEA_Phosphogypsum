<node id="Nanospheres">
  <data key="d0">Nanospheres</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nanospheres are tiny spherical particles formed during the initial stage of CC evolution.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
</node>
<node id="Microlamellar particles">
  <data key="d0">Microlamellar particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Microlamellar particles are structured aggregates formed by the orderly assembly of CC particles.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
