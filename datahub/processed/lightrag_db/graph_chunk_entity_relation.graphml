<node id="MTT Assay">
  <data key="d0">MTT Assay</data>
  <data key="d1">method</data>
  <data key="d2">A technique that monitors cellular metabolic activity to assess cytotoxicity, known for high reproducibility and precise dose-response curves.</data>
