</node>
<node id="Laminar Particles">
  <data key="d0">Laminar Particles</data>
  <data key="d1">artifact</data>
  <data key="d2">Laminar Particles are structures formed by the orderly aggregation of nanocrystals along the c axis, promoted by citrate self-assembly.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791259997</data>
  <data key="d6"></data>
</node>
<node id="Bunched-like HAp Microrod">
  <data key="d0">Bunched-like HAp Microrod</data>
  <data key="d1">artifact</data>
  <data key="d2">Bunched-like HAp Microrod is a structure formed with increased stirring time, consisting of nanorods perpendicular to its center.</data>
  <data key="d3">doc-f2534f7a997df3f80305323317b15be9-chunk-003</data>
