<node id="Hydro Fluoric Acid">
  <data key="d0">Hydro Fluoric Acid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hydro fluoric acid is a chemical that, when spilled, can pollute the surrounding area and increase PTEs concentration in soil.</data>
  <data key="d3">doc-d1ffdf413ee3cbdda92474adf77e2c78-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791023386</data>
