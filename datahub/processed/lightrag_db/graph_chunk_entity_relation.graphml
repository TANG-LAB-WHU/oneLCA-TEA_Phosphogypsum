<node id="El Bekkali">
  <data key="d0">El Bekkali</data>
  <data key="d1">person</data>
  <data key="d2">El Bekkali is a researcher who assessed zinc oxide-hydroxyapatite nanocomposites for the photodegradation of ofloxacin and ciprofloxacin.&lt;SEP&gt;El Bekkali is a researcher who published kinetics data on antibiotic removal using zinc-doped hydroxyapatite composite powders.</data>
  <data key="d3">doc-0a5563c80c4fd1f68b4442f73621a281-chunk-018&lt;SEP&gt;doc-0a5563c80c4fd1f68b4442f73621a281-chunk-019</data>
