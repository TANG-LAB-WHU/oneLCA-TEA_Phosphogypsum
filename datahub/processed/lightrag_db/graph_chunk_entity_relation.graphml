  <data key="d0">SEM analysis</data>
  <data key="d1">method</data>
  <data key="d2">SEM analysis is a microscopic examination technique used to identify hydration products and microstructural features.</data>
  <data key="d3">doc-e1871f90fba8192d1aa537b2a9f4555c-chunk-024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791365693</data>
