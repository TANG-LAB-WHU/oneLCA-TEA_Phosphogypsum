  <data key="d0">OH to PO4 Ratio</data>
  <data key="d1">data</data>
  <data key="d2">The OH to PO4 ratio is a stoichiometric metric calculated from spectral peak amplitudes to evaluate hydroxyapatite composition.</data>
  <data key="d3">doc-72ff3bbf1e2b594abc3ec5c8d86e3178-chunk-004</data>
