</node>
<node id="Chute">
  <data key="d0">Chute</data>
  <data key="d1">method</data>
  <data key="d2">Chute is a gravity separation device suggested for recovering undissolved rare earth element inclusions from phosphogypsum.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791039701</data>
