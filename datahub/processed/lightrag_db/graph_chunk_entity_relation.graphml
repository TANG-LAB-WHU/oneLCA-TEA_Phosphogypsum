</node>
<node id="Barium Sulfate">
  <data key="d0">Barium Sulfate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Barium Sulfate is a highly insoluble compound that co-precipitates with Radium Sulfate and shares a rhombohedral crystal system.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-013</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
  <data key="d6"></data>
</node>
<node id="Alpha Decay">
  <data key="d0">Alpha Decay</data>
  <data key="d1">concept</data>
  <data key="d2">Alpha Decay is the radioactive decay process by which Th-230 transforms into Radium-226.&lt;SEP&gt;Alpha decay is the radioactive decay process by which Ra-226 transforms into Radon-222 and Radon-222 transforms into Polonium-218.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-013&lt;SEP&gt;doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-015</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791188710</data>
