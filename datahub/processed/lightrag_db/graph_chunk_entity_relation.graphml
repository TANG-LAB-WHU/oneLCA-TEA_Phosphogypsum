  <data key="d0">(100) Plane</data>
  <data key="d1">concept</data>
  <data key="d2">The (100) plane is a crystallographic plane parallel to which calcium sulfate hemihydrate exhibits a layered structure.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
  <data key="d6"></data>
</node>
<node id="Gap Position Ions">
  <data key="d0">Gap Position Ions</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gap position ions are atoms or ions added to the interstitial gaps of a lattice structure, requiring charge balancing to maintain electrical neutrality.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792301479</data>
