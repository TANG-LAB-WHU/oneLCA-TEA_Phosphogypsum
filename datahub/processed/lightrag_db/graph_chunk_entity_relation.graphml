</node>
<node id="Simulated body fluid (SBF)">
  <data key="d0">Simulated body fluid (SBF)</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Simulated body fluid is a biochemical solution used in vitro to evaluate the bioactivity and apatite-forming ability of biomaterials.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061334</data>
  <data key="d6"></data>
</node>
<node id="Osteoconduction">
  <data key="d0">Osteoconduction</data>
  <data key="d1">concept</data>
  <data key="d2">Osteoconduction is a biological property that allows materials to serve as scaffolds for new bone tissue growth and integration with autologous bone.</data>
  <data key="d3">doc-b8bd3776c87a0bcab21842e8e2bb2e06-chunk-001</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791061334</data>
  <data key="d6"></data>
