  <data key="d1">event</data>
  <data key="d2">The Third International Symposium On Phosphogypsum was a major academic conference held in Orlando, FL, featuring multiple research presentations.</data>
  <data key="d3">doc-fbe0ad1b5f7f65c2338dc42cd9ca4b89-chunk-035</data>
