<node id="Table S2">
  <data key="d0">Table S2</data>
  <data key="d1">content</data>
  <data key="d2">Table S2 contains experimental data related to the cycle leaching process of rare earth elements from phosphogypsum.&lt;SEP&gt;Table S2 contains calculated results comparing estimated elemental release to total elemental content.&lt;SEP&gt;Table S2 is a supplementary table containing the pairwise comparison data used to construct the AHP judgment matrix.</data>
  <data key="d3">doc-401b567da916dc34559e0bfe5a5b367b-chunk-007&lt;SEP&gt;doc-66f6434914b6de99019386e4bdcbc57e-chunk-013&lt;SEP&gt;doc-7ce07008b902e3e05b9cea9315e7aa04-chunk-003</data>
