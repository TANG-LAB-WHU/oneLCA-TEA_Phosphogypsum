<node id="U-238/Ra-226 Ratio">
  <data key="d0">U-238/Ra-226 Ratio</data>
  <data key="d1">data</data>
  <data key="d2">A measured isotopic ratio indicating disequilibrium in phosphogypsum samples compared to phosphate rock.&lt;SEP&gt;The U-238/Ra-226 ratio is a calculated metric used to assess radioactive equilibrium in the samples.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-006&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
  <data key="d6"></data>
</node>
<node id="U-238/Pb-210 Ratio">
  <data key="d0">U-238/Pb-210 Ratio</data>
  <data key="d1">data</data>
  <data key="d2">A measured isotopic ratio showing significant deviation from unity in phosphogypsum waste samples.&lt;SEP&gt;The U-238/Pb-210 ratio is a calculated metric used to assess radioactive equilibrium in the samples.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-006&lt;SEP&gt;doc-80bac46661a7d25358c897f5feccea99-chunk-005</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
  <data key="d6"></data>
</node>
<node id="U-238/U-235 Ratio">
  <data key="d0">U-238/U-235 Ratio</data>
  <data key="d1">data</data>
  <data key="d2">A stable natural isotopic ratio found to be 21.7 ± 0.1 in both sample types.</data>
  <data key="d3">doc-80bac46661a7d25358c897f5feccea99-chunk-006</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790995715</data>
