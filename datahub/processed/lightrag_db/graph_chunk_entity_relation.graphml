  <data key="d0">Wustite Nano-mineral Particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Wustite nano-mineral particles act as adsorbents for heavy metal ions in the environment.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-017</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791109711</data>
  <data key="d6"></data>
</node>
<node id="Land Surface">
  <data key="d0">Land Surface</data>
  <data key="d1">location</data>
  <data key="d2">The land surface is an environmental compartment where phosphogypsum stockpiles are located and from which runoff originates.</data>
  <data key="d3">doc-34a3ac199714be8fd1cdff8ead90fc92-chunk-017</data>
  <data key="d4">unknown_source</data>
