<node id="n-type Characteristic">
  <data key="d0">n-type Characteristic</data>
  <data key="d1">concept</data>
  <data key="d2">A semiconductor property indicated by a positive slope in Mott-Schottky plots, signifying electron dominance.</data>
  <data key="d3">doc-f07601cd9e687d5cc5c7d9b6b467f21e-chunk-014</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792190223</data>
