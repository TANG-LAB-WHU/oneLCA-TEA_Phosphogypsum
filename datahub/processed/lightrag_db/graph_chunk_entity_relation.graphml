<node id="Modified Phosphogypsum (MPG)">
  <data key="d0">Modified Phosphogypsum (MPG)</data>
  <data key="d1">artifact</data>
  <data key="d2">Modified phosphogypsum is a powdery material obtained through drying, grinding, and sieving of raw phosphogypsum.</data>
  <data key="d3">doc-ad247a75dda6243453b4132b71670203-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1792294020</data>
