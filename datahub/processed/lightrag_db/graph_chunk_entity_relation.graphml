  <data key="d0">Tridentate Binding</data>
  <data key="d1">method</data>
  <data key="d2">Tridentate binding is a chemical attachment mechanism where AL molecules connect to calcium within HAP, enhancing affinity for calcium phosphate crystals.</data>
  <data key="d3">doc-a4d02158bbc770d7c6bd9657b3f3defc-chunk-009</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791469856</data>
  <data key="d6"></data>
