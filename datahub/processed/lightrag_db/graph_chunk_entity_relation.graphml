  <data key="d1">naturalobject</data>
  <data key="d2">The C=O group is an organic functional group identified by a band at 1601 cm⁻¹ in the BC spectrum.</data>
  <data key="d3">doc-9e17ad262bd9835860df552d7ff475f1-chunk-003</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1791288310</data>
  <data key="d6"></data>
