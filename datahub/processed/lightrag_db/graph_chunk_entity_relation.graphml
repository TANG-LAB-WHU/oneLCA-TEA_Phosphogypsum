<node id="60 Percent Utilization Rate">
  <data key="d0">60 Percent Utilization Rate</data>
  <data key="d1">data</data>
  <data key="d2">The target comprehensive utilization rate for newly generated phosphogypsum set by 2025.&lt;SEP&gt;The 60 percent utilization rate is the target metric for phosphogypsum comprehensive utilization set for 2025.</data>
  <data key="d3">doc-a5d09b48f57a4e888bb729aaf988c936-chunk-000&lt;SEP&gt;doc-a5d09b48f57a4e888bb729aaf988c936-chunk-008</data>
